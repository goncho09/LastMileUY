{
  "openapi": "3.1.1",
  "info": {
    "title": "LastMileUY · API pública",
    "description": "API para que el sistema de un comercio (tienda online, ERP) cargue y siga sus envíos.\n\n**Autenticación.** Cada pedido lleva una clave en el encabezado `X-Api-Key`. Las claves\nlas crea el comercio en el portal (menú *Integración*): cada una vale para el comercio y\nel operador logístico con el que se creó, y se puede revocar en cualquier momento.\n\n**Versiones.** Todo está bajo `/api/v1`. Un cambio incompatible saldría en `/api/v2`, y\nla v1 seguiría funcionando.\n\n**Límites.** Por clave: 120 pedidos por minuto y 10 lotes por minuto. Al pasarlos la API\nresponde 429 con el encabezado `Retry-After` (segundos a esperar).\n\n**Importación sin duplicados.** `POST /api/v1/envios/lote` usa la referencia externa\n(el número de pedido del comercio) para no crear el mismo envío dos veces: se puede\nreenviar el lote completo o una parte sin miedo.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/envios": {
      "get": {
        "tags": [
          "Envíos"
        ],
        "summary": "Lista los envíos del comercio, del más nuevo al más viejo",
        "description": "Filtros opcionales: estado (por ejemplo EnTransito) y buscar (código, referencia o destinatario). Tamaño de página máximo: 100.",
        "operationId": "V1ListarEnvios",
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "tamanioPagina",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 20
            }
          },
          {
            "name": "estado",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "buscar",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaDtoOfEnvioResumenDto"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Envíos"
        ],
        "summary": "Crea un envío",
        "description": "Si se manda una referencia externa que ya existe, responde 409 y no crea otro envío.",
        "operationId": "V1CrearEnvio",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnvioApiRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvioResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
