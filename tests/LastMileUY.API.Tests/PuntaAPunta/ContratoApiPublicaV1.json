    },
    "/api/v1/envios/lote": {
      "post": {
        "tags": [
          "Envíos"
        ],
        "summary": "Importa hasta 100 envíos de una vez, sin duplicar",
        "description": "Cada envío necesita su referencia externa. Reimportar el lote, entero o una parte, no crea envíos repetidos: las referencias que ya existían vuelven como \"Existente\" con el envío que estaba. Cada fila se procesa por separado: una inválida vuelve como \"Rechazado\" con el motivo y no frena a las demás.",
        "operationId": "V1ImportarEnvios",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportarEnviosRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
