
@page "{id:int}"
@model LastMileUY.Backoffice.Pages.Comercios.EditarModel

@{
    ViewData["Title"] = "Editar comercio";
}

<div class="mx-auto max-w-[1600px] space-y-7 motion-safe:animate-lm-form-in">

    <div>
        <p class="mb-1.5 text-xs font-medium text-slate-500">
            Administración / Comercios
        </p>

        <h1 class="text-2xl font-semibold tracking-tight text-white">
            Editar comercio
        </h1>

        <p class="mt-2 text-sm text-slate-400">
            Modificá la información del comercio #@Model.ComercioId.
        </p>
    </div>

    <div class="max-w-3xl">
        <section class="overflow-hidden rounded-2xl border border-white/[0.07] bg-surface">

            <div class="flex flex-wrap items-center justify-between gap-3
                        border-b border-white/[0.07] px-5 py-4">

                <div>
                    <h2 class="text-base font-semibold text-white">
                        Datos del comercio
                    </h2>

                    <p class="mt-1 text-sm text-slate-400">
                        Actualizá la información comercial y de contacto.
                    </p>
                </div>

                <span class="rounded-full border border-violet-500/20
                             bg-violet-500/10 px-3 py-1.5
                             text-xs font-medium text-violet-300">
                    ID #@Model.ComercioId
                </span>
            </div>

            <form method="post" class="space-y-6 p-6">

                <partial name="/Pages/Shared/_ErroresFormulario.cshtml" />

                <partial name="_Formulario" for="Formulario" />

                <div class="flex flex-wrap justify-end gap-3 border-t border-white/[0.07] pt-6">

                    <a asp-page="/Comercios/Index"
                       class="inline-flex items-center justify-center rounded-xl
                              border border-white/[0.07] bg-white/5 px-5 py-3
                              text-sm font-semibold text-slate-300 no-underline
                              transition-colors hover:bg-white/10 hover:text-white">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="inline-flex items-center justify-center gap-2
                                   rounded-md bg-violet-600 px-4 py-2
                                   text-sm font-semibold text-white
                                   transition-colors hover:bg-violet-500">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor"
                             stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M5 3h12l4 4v14H3V3h2zM7 3v6h10V3M7 21v-8h10v8" />
                        </svg>
                        Guardar cambios
                    </button>
                </div>
            </form>
        </section>
    </div>
</div>
