
@page "{id:int}"
@model LastMileUY.Backoffice.Pages.Comercios.OperadoresModel

@{
    ViewData["Title"] = "Operadores del comercio";
}

<div class="mx-auto max-w-[1600px] space-y-7 motion-safe:animate-lm-form-in">

    <div>
        <a asp-page="/Comercios/Index"
           class="mb-5 inline-flex items-center gap-2 text-sm
                  font-medium text-slate-400 no-underline
                  transition-colors hover:text-violet-300">
            <svg class="h-4 w-4" fill="none" stroke="currentColor"
                 stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="m15 18-6-6 6-6" />
            </svg>
            Volver a comercios
        </a>

        <p class="mb-1.5 text-xs font-medium text-slate-500">
            Administración / Comercios / Operadores
        </p>

        <h1 class="text-2xl font-semibold tracking-tight text-white">
            @Model.Comercio.Nombre
        </h1>

        <p class="mt-2 text-sm text-slate-400">
            Administrá los operadores vinculados a este comercio.
        </p>
    </div>

    @if (TempData["MensajeExito"] is string mensaje)
    {
        <div role="status"
             class="rounded-xl border border-emerald-500/25
                    bg-emerald-500/10 px-5 py-4 text-sm text-emerald-300">
            @mensaje
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div role="alert"
             class="rounded-xl border border-red-500/25
                    bg-red-500/10 px-5 py-4 text-sm text-red-300">
            @error
        </div>
    }

    <section class="overflow-hidden rounded-2xl border border-white/[0.07] bg-surface">

        <div class="border-b border-white/[0.07] px-5 py-4">
            <h2 class="text-base font-semibold text-white">
                Vincular operador
            </h2>

            <p class="mt-1 text-sm text-slate-400">
                Seleccioná un operador para asociarlo a este comercio.
            </p>
        </div>

        <form method="post"
              asp-page-handler="Vincular"
              asp-route-id="@Model.Comercio.Id"
              class="flex flex-wrap items-end gap-4 p-6">

            <div class="min-w-[220px] flex-1">
                <label asp-for="OperadorId"
                       class="mb-2 block text-sm font-medium text-slate-300">
                    Operador disponible
                </label>

                <select asp-for="OperadorId"
                        required
                        class="w-full rounded-xl border border-white/[0.07]
                               bg-field px-4 py-3 text-sm text-white
                               outline-none focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20">

                    <option value="">Seleccionar operador</option>

                    @foreach (var operador in Model.Disponibles)
                    {
                        <option value="@operador.Id">
                            @operador.Nombre
                        </option>
                    }
                </select>
            </div>

            <button type="submit"
                    disabled="@(Model.Disponibles.Count == 0)"
                    class="inline-flex items-center justify-center gap-2
                           rounded-md bg-violet-600 px-4 py-2
                           text-sm font-semibold text-white
                           transition-colors hover:bg-violet-500
                           disabled:cursor-not-allowed disabled:opacity-40">
                <svg class="h-4 w-4" fill="none" stroke="currentColor"
                     stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M12 5v14M5 12h14" />
                </svg>
                Vincular
            </button>
        </form>

        @if (Model.Disponibles.Count == 0)
        {
            <p class="px-6 pb-6 text-xs text-slate-500">
                No hay operadores disponibles para vincular.
            </p>
        }
    </section>

    <section class="overflow-hidden rounded-2xl border border-white/[0.07] bg-surface">

        <div class="border-b border-white/[0.07] px-5 py-4">
            <h2 class="text-base font-semibold text-white">
                Vínculos existentes
            </h2>

            <p class="mt-1 text-sm text-slate-400">
                Consultá los operadores asociados y su estado actual.
            </p>
        </div>

        @if (Model.Vinculos.Count == 0)
        {
            <div class="px-6 py-12 text-center">
                <p class="font-medium text-slate-300">
                    Este comercio todavía no tiene operadores vinculados.
                </p>
                <p class="mt-2 text-sm text-slate-500">
                    Seleccioná un operador en el formulario superior para comenzar.
                </p>
            </div>
        }
        else
        {
            <div class="w-full overflow-x-auto">
                <table class="w-full min-w-[720px] text-left text-sm">

                    <thead class="bg-sidebar text-xs font-semibold
                                  uppercase tracking-wider text-slate-400">
                        <tr>
                            <th scope="col" class="px-6 py-4">Operador</th>
                            <th scope="col" class="px-4 py-3">Vinculación</th>
                            <th scope="col" class="px-4 py-3">Estado</th>
                            <th scope="col" class="px-6 py-4">Acciones</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-white/5">
                        @foreach (var vinculo in Model.Vinculos)
                        {
                            <tr class="transition-colors hover:bg-white/[0.025]">

                                <td class="px-5 py-4 font-semibold text-white">
                                    @vinculo.OperadorNombre
                                </td>

                                <td class="px-5 py-5 text-slate-400">
                                    @vinculo.FechaVinculacion.ToString("dd/MM/yyyy")
                                </td>

                                <td class="px-5 py-5">
                                    @if (vinculo.Activo)
                                    {
                                        <span class="inline-flex rounded-full
                                                     bg-emerald-500/10 px-3 py-1
                                                     text-xs font-medium text-emerald-300">
                                            Vinculado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex rounded-full
                                                     bg-slate-500/10 px-3 py-1
                                                     text-xs font-medium text-slate-400">
                                            Desvinculado
                                        </span>
                                    }
                                </td>

                                <td class="px-5 py-4">
                                    @if (vinculo.Activo)
                                    {
                                        <form method="post"
                                              asp-page-handler="Desvincular"
                                              asp-route-id="@Model.Comercio.Id"
                                              asp-route-operadorId="@vinculo.OperadorId"
                                              onsubmit="return confirm('¿Desvincular este operador?');">

                                            <button type="submit"
                                                    class="rounded-lg border border-red-500/20
                                                           bg-red-500/10 px-4 py-2
                                                           text-xs font-semibold text-red-300
                                                           transition-colors hover:bg-red-500/20">
                                                Desvincular
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-500">
                                            Sin acciones
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
