
@page
@model LastMileUY.Backoffice.Pages.Comercios.IndexModel

@{
    ViewData["Title"] = "Administración de comercios";
}

<div class="mx-auto max-w-[1600px] space-y-7 motion-safe:animate-lm-form-in">

    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <p class="mb-1.5 text-xs font-medium text-slate-500">
                Administración / Comercios
            </p>

            <h1 class="text-2xl font-semibold tracking-tight text-white">
                Comercios
            </h1>

            <p class="mt-2 text-sm text-slate-400">
                Gestioná los comercios y sus vínculos con los operadores.
            </p>
        </div>

        <a asp-page="/Comercios/Crear"
           class="inline-flex items-center gap-2 rounded-xl bg-violet-600
                  px-4 py-2 text-sm font-medium text-white no-underline
                  transition-colors hover:bg-violet-500">
            <svg class="h-4 w-4" fill="none" stroke="currentColor"
                 stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 5v14M5 12h14" />
            </svg>
            Nuevo comercio
        </a>
    </div>

    @if (TempData["MensajeExito"] is string mensaje)
    {
        <div role="status"
             class="rounded-xl border border-emerald-500/25 bg-emerald-500/10 px-5 py-4 text-sm text-emerald-300">
            @mensaje
        </div>
    }

    @if (Model.ErrorCarga is not null)
    {
        <div role="alert"
             class="rounded-xl border border-red-500/25 bg-red-500/10 px-5 py-4 text-sm text-red-300">
            @Model.ErrorCarga
        </div>
    }
    else
    {
        <section class="overflow-hidden rounded-2xl border border-white/[0.07] bg-surface">

            <div class="border-b border-white/[0.07] px-5 py-4">
                <h2 class="text-base font-semibold text-white">
                    Comercios registrados
                </h2>
                <p class="mt-1 text-sm text-slate-400">
                    Consultá sus datos y administrá los operadores vinculados.
                </p>
            </div>

            <div class="border-b border-white/[0.07] p-6">
                <label for="buscarComercio"
                       class="mb-2 block text-sm font-medium text-slate-300">
                    Buscar comercio
                </label>

                <div class="relative max-w-md">
                    <svg class="pointer-events-none absolute top-1/2 left-4 h-5 w-5 -translate-y-1/2 text-slate-500"
                         fill="none" stroke="currentColor" stroke-width="1.7"
                         viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <path stroke-linecap="round" d="m20 20-4-4" />
                    </svg>

                    <input id="buscarComercio"
                           type="search"
                           placeholder="Buscar por nombre o RUT..."
                           class="w-full rounded-xl border border-white/[0.07]
                                  bg-field py-3 pr-4 pl-12 text-sm text-white
                                  outline-none placeholder:text-slate-500
                                  focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20" />
                </div>
            </div>

            @if (Model.Comercios.Count == 0)
            {
                <div class="px-6 py-14 text-center">
                    <p class="font-medium text-slate-300">
                        No hay comercios registrados.
                    </p>
                    <p class="mt-2 text-sm text-slate-500">
                        Creá un comercio para comenzar a vincularlo con operadores.
                    </p>
                </div>
            }
            else
            {
                <div class="w-full overflow-x-auto">
                    <table class="w-full min-w-[900px] text-left text-sm">
                        <thead class="border-b border-white/[0.07] text-xs font-medium text-slate-500">
                            <tr>
                                <th scope="col" class="px-6 py-4">ID</th>
                                <th scope="col" class="px-4 py-3">Comercio</th>
                                <th scope="col" class="px-4 py-3">RUT</th>
                                <th scope="col" class="px-4 py-3">Email</th>
                                <th scope="col" class="px-4 py-3">Estado</th>
                                <th scope="col" class="px-6 py-4">Acciones</th>
                            </tr>
                        </thead>

                        <tbody id="tablaComercios" class="divide-y divide-white/5">
                            @foreach (var comercio in Model.Comercios)
                            {
                                <tr data-busqueda="@($"{comercio.Nombre} {comercio.RUT}".ToLowerInvariant())"
                                    class="transition-colors hover:bg-white/[0.025]">

                                    <td class="px-5 py-4 text-slate-400">
                                        @comercio.Id
                                    </td>

                                    <td class="px-5 py-5 font-semibold text-white">
                                        @comercio.Nombre
                                    </td>

                                    <td class="px-5 py-5 text-slate-300">
                                        @(comercio.RUT ?? "—")
                                    </td>

                                    <td class="px-5 py-5 text-slate-400">
                                        @(comercio.Email ?? "—")
                                    </td>

                                    <td class="px-5 py-5">
                                        @if (comercio.Activo)
                                        {
                                            <span class="inline-flex rounded-full
                                                         bg-emerald-500/10 px-3 py-1
                                                         text-xs font-medium text-emerald-300">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex rounded-full
                                                         bg-slate-500/10 px-3 py-1
                                                         text-xs font-medium text-slate-400">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td class="px-5 py-4">
                                        <div class="flex items-center gap-4">
                                            <a asp-page="/Comercios/Editar"
                                               asp-route-id="@comercio.Id"
                                               class="text-sm font-semibold text-violet-300
                                                      no-underline hover:text-violet-200">
                                                Editar
                                            </a>

                                            <a asp-page="/Comercios/Operadores"
                                               asp-route-id="@comercio.Id"
                                               class="text-sm font-semibold text-slate-300
                                                      no-underline hover:text-white">
                                                Operadores
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div id="sinResultadosComercios"
                     class="hidden px-6 py-10 text-center text-sm text-slate-400">
                    No se encontraron comercios con esos datos.
                </div>
            }
        </section>
    }
</div>

@section Scripts {
    <script>
        document.getElementById("buscarComercio")
            ?.addEventListener("input", function () {
                const texto = this.value.toLocaleLowerCase().trim();
                let visibles = 0;

                document.querySelectorAll("#tablaComercios tr")
                    .forEach(fila => {
                        const coincide = (fila.dataset.busqueda ?? "")
                            .includes(texto);

                        fila.style.display = coincide ? "" : "none";
                        if (coincide) visibles++;
                    });

                document.getElementById("sinResultadosComercios")
                    ?.classList.toggle("hidden", visibles > 0);
            });
    </script>
}
