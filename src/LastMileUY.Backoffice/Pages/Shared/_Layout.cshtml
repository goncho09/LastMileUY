<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - LastMileUY Backoffice</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/LastMileUY.Backoffice.styles.css" asp-append-version="true"/>
</head>
@{
    // Con sesión, el Backoffice toma el color y el logo del operador (ver IdentidadOperador)
    var operador = IdentidadOperador.Desde(User);
    var textoClaro = operador?.ColorTexto == "#ffffff";
}
<body class="@(operador is null ? null : "con-operador")"
      style="@(operador is null ? null : $"--color-operador: {operador.Color}; --color-operador-texto: {operador.ColorTexto};")">
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3 @(operador is null ? "navbar-light bg-white" : "navbar-operador")"
         data-bs-theme="@(textoClaro ? "dark" : "light")">
        <div class="container">
            @if (operador is null)
            {
            <a class="navbar-brand" asp-area="" asp-page="/Index">LastMileUY Backoffice</a>
            }
            else
            {
            <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                @if (operador.LogoUrl is not null)
                {
                <img src="@operador.LogoUrl" alt="" class="operador-logo"/>
                }
                else
                {
                <span class="operador-inicial" aria-hidden="true">@operador.Inicial</span>
                }
                <span>@operador.Nombre</span>
                <span class="small opacity-75 d-none d-md-inline">Backoffice</span>
            </a>
            }
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                @if (User.Identity?.IsAuthenticated == true)
                {
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Envios/Index">Envíos</a>
                    </li>
                    @if (Permisos.PuedeVerConfiguracion(User))
                    {
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Operador/Index">Mi operador</a>
                    </li>
                    }
                </ul>
                <form method="post" asp-page="/Logout" class="d-flex align-items-center gap-2">
                    <span class="navbar-text small">@User.Identity.Name · @Permisos.Perfil(User)</span>
                    <button type="submit" class="btn btn-sm @(textoClaro ? "btn-outline-light" : "btn-outline-secondary")">Salir</button>
                </form>
                }
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - LastMileUY
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
