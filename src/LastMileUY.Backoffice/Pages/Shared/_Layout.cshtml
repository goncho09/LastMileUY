@{
    var operador = IdentidadOperador.Desde(User);
    var autenticado = User.Identity?.IsAuthenticated == true;
    var titulo = ViewData["Title"]?.ToString() ?? "Inicio";

    var paginaActual = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    var enInicio = paginaActual.Equals("/Index", StringComparison.OrdinalIgnoreCase);
    var enEnvios = paginaActual.StartsWith("/Envios", StringComparison.OrdinalIgnoreCase);
    var enRutas = paginaActual.StartsWith("/Rutas", StringComparison.OrdinalIgnoreCase);
    var enSincronizacion = paginaActual.StartsWith("/Sincronizacion", StringComparison.OrdinalIgnoreCase);
    var enOperador = paginaActual.StartsWith("/Operador", StringComparison.OrdinalIgnoreCase);
    var enTablero = paginaActual.StartsWith("/Tablero", StringComparison.OrdinalIgnoreCase);
    var enMensajesFallidos = paginaActual.StartsWith(
        "/MensajesFallidos",
        StringComparison.OrdinalIgnoreCase);
    var enUsuarios = paginaActual.StartsWith(
    "/Usuarios", StringComparison.OrdinalIgnoreCase);
    var enFuncionalidades = paginaActual.StartsWith("/Funcionalidades", StringComparison.OrdinalIgnoreCase);

    (string Pagina, string Texto, string Icono)[] seccionesConfiguracion =
    [
        ("Zonas", "Zonas de cobertura", "M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2zM9 4v14M15 6v14"),
        ("FranjasHorarias", "Franjas horarias", "M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"),
        ("Tarifas", "Cuadro tarifario", "M12 3v18M17 7.5C17 5.6 14.8 5 12 5S7 6 7 8s2 2.6 5 3.2 5 1.4 5 3.6-2.2 3.2-5 3.2-5-.9-5-2.8"),
        ("Vehiculos", "Vehículos", "M3 7h11v9H3zM14 10h4l3 3v3h-7M7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"),
        ("ReglasOperativas", "Reglas operativas", "M9 5h11M9 12h11M9 19h11M4 5h.01M4 12h.01M4 19h.01"),
        ("MotivosNoEntrega", "Motivos de no entrega", "M12 9v4m0 4h.01M4.9 19h14.2a2 2 0 0 0 1.7-3L13.7 4a2 2 0 0 0-3.4 0L3.2 16a2 2 0 0 0 1.7 3z")
    ];

    var claseNavBase ="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium no-underline transition-colors";
    var claseNavActivo = "bg-violet-500/15 text-violet-300";
    var claseNavInactivo = "text-slate-400 hover:bg-white/5 hover:text-white";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LastMileUY - @ViewData["Title"]</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LastMileUY.Backoffice.styles.css" asp-append-version="true" />
</head>

<body class="min-h-screen bg-[#0c0e14] text-slate-100 antialiased"
      style="@(operador is null ? null : $"--color-operador: {operador.Color}; --color-operador-texto: {operador.ColorTexto};")">

@if (autenticado)
{
    <div class="min-h-screen lg:flex">

        <aside class="flex w-full shrink-0 flex-col border-b border-white/10 bg-[#11131b] lg:sticky lg:top-0 lg:h-screen lg:w-64 lg:border-r lg:border-b-0">

            <div class="border-b border-white/10 px-6 py-6">
                <a asp-page="/Index"
                   class="flex items-center gap-3 no-underline">

                    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-500 text-xl font-bold text-white shadow-lg shadow-violet-950/30">
                        L
                    </span>

                    <span class="flex flex-col">
                        <strong class="text-base font-bold tracking-tight text-white">
                            LastMileUY
                        </strong>
                        <small class="mt-0.5 text-xs text-slate-400">
                            Backoffice
                        </small>
                    </span>
                </a>
            </div>

            <nav class="flex flex-col gap-1 px-4 py-6" aria-label="Navegación principal">

                <span class="mb-4 px-4 text-[10px] font-semibold tracking-[0.2em] text-slate-500 uppercase">
                    Menú principal
                </span>
                
                


    @if (!User.IsInRole("Administrador"))
                {
                <a asp-page="/Index"
                       aria-current="@(enInicio ? "page" : null)"
                       class="@(claseNavBase) @(enInicio ? claseNavActivo : claseNavInactivo)">
                    <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor"
                         stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/>
                    </svg>
                    Inicio
                </a>

                    <a asp-page="/Envios/Index"
                       aria-current="@(enEnvios ? "page" : null)"
                       class="@(claseNavBase) @(enEnvios ? claseNavActivo : claseNavInactivo)">
                        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor"
                             stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M3 7h18v14H3zM3 7l4-4h10l4 4M3 12h18M9 16h6"/>
                        </svg>
                        Envíos
                    </a>



                    <a asp-page="/Rutas/Index"
                       aria-current="@(enRutas ? "page" : null)"
                       class="@(claseNavBase) @(enRutas ? claseNavActivo : claseNavInactivo)">
                        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor"
                             stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M6 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM18 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM8 17h6a3 3 0 0 0 0-6h-4a3 3 0 0 1 0-6h6"/>
                        </svg>
                        Hojas de ruta
                    </a>


                    <a asp-page="/Sincronizacion/Index"
                       aria-current="@(enSincronizacion ? "page" : null)"
                       class="@(claseNavBase) @(enSincronizacion ? claseNavActivo : claseNavInactivo)">
                        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor"
                             stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M4 12a8 8 0 0 1 14-5.3L20 9M20 4v5h-5M20 12a8 8 0 0 1-14 5.3L4 15M4 20v-5h5"/>
                        </svg>
                        Sincronización
                    </a>

                    @if (User.IsInRole("Operador"))
                    {
                        <a asp-page="/Usuarios/Index"
                           aria-current="@(enUsuarios ? "page" : null)"
                           class="@(claseNavBase) @(enUsuarios ? claseNavActivo : claseNavInactivo)">
                            <svg class="h-5 w-5 shrink-0" fill="none"
                                 stroke="currentColor" stroke-width="1.7"
                                 viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 21v-2a4 4 0 0 1-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                            Usuarios
                        </a>
                    }
                }

                @if (Permisos.PuedeVerConfiguracion(User) || User.IsInRole("Operador"))
                {
                        <a asp-page="/Operador/Index"
                           aria-current="@(enOperador ? "page" : null)"
                           class="@(claseNavBase) @(enOperador ? claseNavActivo : claseNavInactivo)">
                            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor"
                                 stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/>
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l-1.86 1.86A1.7 1.7 0 0 0 16 18.4a1.7 1.7 0 0 0-1.54 1.06L13.8 21h-3.6l-.66-1.54A1.7 1.7 0 0 0 8 18.4a1.7 1.7 0 0 0-1.88.34l-1.86-1.86A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.06-1.54L2 12.8V11.2l1.54-.66A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.34-1.88l1.86-1.86A1.7 1.7 0 0 0 8 5.6a1.7 1.7 0 0 0 1.54-1.06L10.2 3h3.6l.66 1.54A1.7 1.7 0 0 0 16 5.6a1.7 1.7 0 0 0 1.88-.34l1.86 1.86A1.7 1.7 0 0 0 19.4 9a1.7 1.7 0 0 0 1.06 1.54L22 11.2v1.6l-1.54.66A1.7 1.7 0 0 0 19.4 15z"/>
                            </svg>
                            Mi operador
                        </a>

                    <a asp-page="/Tablero/Index"
                       aria-current="@(enTablero ? "page" : null)"
                       class="@(claseNavBase) @(enTablero ? claseNavActivo : claseNavInactivo)">
                        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor"
                             stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>
                        </svg>
                        Tablero técnico
                    </a>

                    <span class="mt-5 mb-2 px-4 text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500">
                        Configuración
                    </span>

                    @foreach (var (pagina, texto, icono) in seccionesConfiguracion)
                    {
                        var actual = paginaActual.Equals($"/Configuracion/{pagina}", StringComparison.OrdinalIgnoreCase)
                                     || (pagina == "Tarifas" && paginaActual.Equals("/Configuracion/CuadroTarifario", StringComparison.OrdinalIgnoreCase));
                        <a asp-page="/Configuracion/@pagina"
                           aria-current="@(actual ? "page" : null)"
                           class="@(claseNavBase) @(actual ? claseNavActivo : claseNavInactivo)">
                            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor"
                                 stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="@icono"/>
                            </svg>
                            @texto
                        </a>
                    }
                }
                
                @if (Permisos.PuedeAdministrarMensajeria(User))
                {
                    <a asp-page="/MensajesFallidos/Index"
                       aria-current="@(enMensajesFallidos ? "page" : null)"
                       class="@(claseNavBase) @(enMensajesFallidos ? claseNavActivo : claseNavInactivo)">

                        <svg class="h-5 w-5 shrink-0"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.7"
                             viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 9v4m0 4h.01M10.3 3.9 2 18a2 2 0 0 0 1.7 3h16.6a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>
                        </svg>

                        Mensajes fallidos
                    </a>

                    <a asp-page="/Funcionalidades/Index"
                       aria-current="@(enFuncionalidades ? "page" : null)"
                       class="@(claseNavBase) @(enFuncionalidades ? claseNavActivo : claseNavInactivo)">
                        <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor"
                             stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M4 21V14M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>
                        </svg>
                        Funcionalidades
                    </a>
                }
                
                
                @if (User.IsInRole("Administrador"))
                {
                    <span class="mt-5 mb-2 px-4 text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500">
                        Administración global
                    </span>

                    <a asp-page="/Operadores/Index"
                       aria-current="@(Context.Request.Path.StartsWithSegments("/Operadores") ? "page" : null)"
                       class="@(claseNavBase) @(Context.Request.Path.StartsWithSegments("/Operadores") ? claseNavActivo : claseNavInactivo)">
                        <svg class="h-5 w-5 shrink-0" fill="none"
                             stroke="currentColor" stroke-width="1.7"
                             viewBox="0 0 24 24" aria-hidden="true">
                            <rect x="3" y="7" width="18" height="14" rx="2"/>
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M7 7V4a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v3M8 12h2m4 0h2M8 16h2m4 0h2"/>
                        </svg>
                        Operadores
                    </a>

                    <a asp-page="/Comercios/Index"
                       aria-current="@(Context.Request.Path.StartsWithSegments("/Comercios") ? "page" : null)"
                       class="@(claseNavBase) @(Context.Request.Path.StartsWithSegments("/Comercios") ? claseNavActivo : claseNavInactivo)">
                        <svg class="h-5 w-5 shrink-0" fill="none"
                             stroke="currentColor" stroke-width="1.7"
                             viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M3 10h18l-2-6H5l-2 6zM5 10v11h14V10M9 21v-7h6v7"/>
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M3 10c0 2 3 3 4.5 1 1.5 2 3.5 2 4.5 0 1.5 2 3.5 2 4.5 0 1.5 2 4.5 1 4.5-1"/>
                        </svg>
                        Comercios
                    </a>
                }

            </nav>

            <div class="mt-auto border-t border-white/10 px-4 py-5">

                <div class="mb-4 flex items-center gap-3 px-2">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-violet-500/20 text-sm font-bold text-violet-300">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpperInvariant() ?? "U")
                    </span>

                    <div class="min-w-0">
                        <p class="truncate text-sm font-semibold text-white">
                            @User.Identity?.Name
                        </p>
                        <p class="mt-0.5 text-xs text-slate-400">
                            @Permisos.Perfil(User)
                        </p>
                    </div>
                </div>

                <form method="post" asp-page="/Logout">
                    <button type="submit"
                            class="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-medium text-slate-400 transition-colors hover:bg-red-500/10 hover:text-red-300">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor"
                             stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
                        </svg>
                        Cerrar sesión
                    </button>
                </form>
            </div>
        </aside>

        <div class="flex min-w-0 flex-1 flex-col">

            <header class="flex min-h-22 flex-wrap items-center justify-between gap-4 border-b border-white/10 px-5 py-5 sm:px-8">

                <div>
                    <h1 class="text-lg font-bold text-white">
                        @titulo
                    </h1>
                    <p class="mt-1 text-xs text-slate-400">
                        LastMileUY · Gestión logística
                    </p>
                </div>

                @if (operador is not null)
                {
                    <div class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-[#171923] px-4 py-2.5 text-xs font-medium text-slate-200">
                        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                        <span>@operador.Nombre</span>
                    </div>
                }
            </header>

            <main role="main" class="w-full flex-1 px-5 py-8 sm:px-8">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <main role="main" class="min-h-screen">
        @RenderBody()
    </main>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@if (autenticado && operador is not null)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
            integrity="sha512-7SRCYIJtR6F8ocwW7UxW6wGKqbSyqREDbfCORCbGLatU0iugBLwyOXpzhkPyHIFdBO0K2VCu57fvP2Twgx1o2A=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>

    <script src="~/js/envios-signalr.js"
            asp-append-version="true"></script>
}

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
