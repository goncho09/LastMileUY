@using LastMileUY.Contracts.Sincronizacion
@model (IReadOnlyList<OperacionSincronizadaDto> Operaciones, bool MostrarRuta)

@* Lo que llegó desde la app del repartidor: lo usan la página Sincronización y el detalle de la ruta *@

<div class="w-full overflow-x-auto">
    <table class="w-full min-w-[1000px] border-collapse text-left text-sm">
        <thead class="bg-[#11131b] text-xs font-semibold uppercase tracking-wider text-slate-400">
            <tr>
                <th scope="col" class="px-5 py-4">Pasó en el celular</th>
                <th scope="col" class="px-4 py-4">Llegó</th>
                <th scope="col" class="px-4 py-4">Operación</th>
                <th scope="col" class="px-4 py-4">Envío</th>
                @if (Model.MostrarRuta)
                {
                    <th scope="col" class="px-4 py-4">Ruta</th>
                }
                <th scope="col" class="px-4 py-4">Repartidor</th>
                <th scope="col" class="px-4 py-4">Resultado</th>
                <th scope="col" class="px-5 py-4">Evidencia</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
            @foreach (var operacion in Model.Operaciones)
            {
                <tr class="align-top transition-colors hover:bg-white/[0.035]">
                    <td class="whitespace-nowrap px-5 py-4 text-slate-300">@Formato.Fecha(operacion.FechaHoraDispositivo)</td>
                    <td class="whitespace-nowrap px-4 py-4 text-xs text-slate-400">@Formato.Fecha(operacion.FechaRecepcion)</td>
                    <td class="whitespace-nowrap px-4 py-4 text-slate-200">@ResultadosSincronizacion.TipoOperacion(operacion.Tipo)</td>
                    <td class="whitespace-nowrap px-4 py-4">
                        @if (operacion.CodigoSeguimiento is not null)
                        {
                            <a asp-page="/Envios/Detalle" asp-route-id="@operacion.EnvioId"
                               class="font-mono text-xs font-semibold text-violet-300 no-underline hover:text-violet-200">
                                @operacion.CodigoSeguimiento
                            </a>
                        }
                        else
                        {
                            <span class="text-xs text-slate-500">Envío @operacion.EnvioId (no existe)</span>
                        }
                    </td>
                    @if (Model.MostrarRuta)
                    {
                        <td class="whitespace-nowrap px-4 py-4">
                            <a asp-page="/Rutas/Detalle" asp-route-id="@operacion.RutaId"
                               class="text-slate-300 no-underline hover:text-white">
                                Ruta @operacion.RutaId
                            </a>
                        </td>
                    }
                    <td class="px-4 py-4 text-slate-300">@operacion.Repartidor</td>
                    <td class="max-w-md px-4 py-4">
                        <span class="inline-flex items-center whitespace-nowrap rounded-full border px-2.5 py-1 text-xs font-medium @ResultadosSincronizacion.ClaseCss(operacion.Resultado)">
                            @ResultadosSincronizacion.Texto(operacion.Resultado)
                        </span>
                        <p class="mt-1.5 text-xs text-slate-400">@operacion.Mensaje</p>
                    </td>
                    <td class="whitespace-nowrap px-5 py-4 text-xs">
                        @if (operacion.IntentoEntregaId is { } intento && (operacion.TieneFirma || operacion.TieneFoto))
                        {
                            <div class="flex gap-3">
                                @if (operacion.TieneFirma)
                                {
                                    <a asp-page="/Sincronizacion/Evidencia" asp-route-intentoId="@intento" asp-route-tipo="firma"
                                       target="_blank" rel="noopener" class="text-violet-300 no-underline hover:text-violet-200">
                                        Ver firma
                                    </a>
                                }
                                @if (operacion.TieneFoto)
                                {
                                    <a asp-page="/Sincronizacion/Evidencia" asp-route-intentoId="@intento" asp-route-tipo="foto"
                                       target="_blank" rel="noopener" class="text-violet-300 no-underline hover:text-violet-200">
                                        Ver foto
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-slate-500">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
