@model (IReadOnlyList<LastMileUY.Contracts.Sincronizacion.OperacionSincronizadaDto> Operaciones, bool MostrarRuta)

<div class="w-full overflow-x-auto">
    <table class="w-full min-w-[1000px] border-collapse text-left text-sm">
        <thead class="border-b border-white/[0.07] text-xs font-medium text-slate-500">
            <tr>
                <th scope="col" class="px-4 py-3">Pasó en el celular</th>
                <th scope="col" class="px-4 py-3">Llegó</th>
                <th scope="col" class="px-4 py-3">Operación</th>
                <th scope="col" class="px-4 py-3">Envío</th>
                @if (Model.MostrarRuta)
                {
                    <th scope="col" class="px-4 py-3">Ruta</th>
                }
                <th scope="col" class="px-4 py-3">Repartidor</th>
                <th scope="col" class="px-4 py-3">Resultado</th>
                <th scope="col" class="px-4 py-3">Evidencia</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
            @foreach (var operacion in Model.Operaciones)
            {
                <tr class="align-top transition-colors hover:bg-white/[0.025]">
                    <td class="whitespace-nowrap px-4 py-3 text-slate-300">@Formato.Fecha(operacion.FechaHoraDispositivo)</td>
                    <td class="whitespace-nowrap px-4 py-3 text-xs text-slate-400">@Formato.Fecha(operacion.FechaRecepcion)</td>
                    <td class="whitespace-nowrap px-4 py-3 text-slate-200">
                        @ResultadosSincronizacion.TipoOperacion(operacion.Tipo)
                        @if (operacion.VersionReglasEntregaParcial is { } version)
                        {
                            <p class="mt-1 text-xs text-slate-500" title="Versión de las reglas de entrega parcial con la que salió la hoja de ruta">
                                Reglas v@(version)
                            </p>
                        }
                    </td>
                    <td class="whitespace-nowrap px-4 py-3">
                        @if (operacion.CodigoSeguimiento is not null)
                        {
                            <a asp-page="/Envios/Detalle" asp-route-id="@operacion.EnvioId"
                               class="font-mono text-xs font-semibold text-violet-300 no-underline hover:text-violet-200">
                                @operacion.CodigoSeguimiento
                            </a>
                        }
                        else
                        {
                            <span class="text-xs text-slate-500">Envío @operacion.EnvioId (no existe)</span>
                        }
                    </td>
                    @if (Model.MostrarRuta)
                    {
                        <td class="whitespace-nowrap px-4 py-3">
                            <a asp-page="/Rutas/Detalle" asp-route-id="@operacion.RutaId"
                               class="text-slate-300 no-underline hover:text-white">
                                Ruta @operacion.RutaId
                            </a>
                        </td>
                    }
                    <td class="px-4 py-3 text-slate-300">@operacion.Repartidor</td>
                    <td class="max-w-md px-4 py-3">
                        <span class="inline-flex items-center whitespace-nowrap rounded border px-1.5 py-0.5 text-xs font-medium @ResultadosSincronizacion.ClaseCss(operacion.Resultado)">
                            @ResultadosSincronizacion.Texto(operacion.Resultado)
                        </span>
                        <p class="mt-1.5 text-xs text-slate-400">@operacion.Mensaje</p>
                    </td>
                    <td class="whitespace-nowrap px-4 py-3 text-xs">
                        @if (operacion.IntentoEntregaId is { } intento && (operacion.TieneFirma || operacion.TieneFoto))
                        {
                            <div class="flex gap-3">
                                @if (operacion.TieneFirma)
                                {
                                    <a asp-page="/Sincronizacion/Evidencia" asp-route-intentoId="@intento" asp-route-tipo="firma"
                                       target="_blank" rel="noopener" class="text-violet-300 no-underline hover:text-violet-200">
                                        Ver firma
                                    </a>
                                }
                                @if (operacion.TieneFoto)
                                {
                                    <a asp-page="/Sincronizacion/Evidencia" asp-route-intentoId="@intento" asp-route-tipo="foto"
                                       target="_blank" rel="noopener" class="text-violet-300 no-underline hover:text-violet-200">
                                        Ver foto
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-slate-500">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
