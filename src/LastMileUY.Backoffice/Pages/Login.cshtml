
@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="mx-auto grid min-h-[calc(100vh-100px)] w-full max-w-6xl items-center gap-12 px-5 py-12 lg:grid-cols-2 lg:gap-20">

    <section class="hidden lg:block">
        <div class="mb-8 inline-flex h-10 w-10 items-center justify-center rounded-md bg-violet-600 text-white">
            <svg class="h-5 w-5" fill="none" stroke="currentColor"
                 stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M3 7h11v10H3zM14 10h4l3 3v4h-7M7 17a2 2 0 1 0 4 0M16 17a2 2 0 1 0 4 0"/>
            </svg>
        </div>

        <p class="mb-3 text-sm font-medium text-slate-400">
            LastMileUY
        </p>

        <h1 class="max-w-lg text-4xl leading-[1.15] font-semibold tracking-tight text-white">
            Tu operación logística,
            <span class="text-slate-400">bajo control.</span>
        </h1>

        <p class="mt-5 max-w-md text-base leading-relaxed text-slate-400">
            Gestioná envíos, supervisá operaciones y administrá tu operador
            desde un solo lugar.
        </p>

        <div class="mt-12 flex items-center gap-3 border-t border-white/[0.07] pt-7 text-sm text-slate-500">
            <span class="h-1.5 w-1.5 rounded-full bg-slate-500"></span>
            Plataforma de gestión logística
        </div>
    </section>

    <section class="motion-safe:animate-lm-form-in w-full max-w-md justify-self-center lg:justify-self-end">
        <div class="rounded-lg border border-white/[0.07] bg-surface p-7 sm:p-8">

            <div class="mb-8">
                <div class="mb-5 flex h-9 w-9 items-center justify-center rounded-md bg-violet-600 text-white lg:hidden">
                    <span class="text-xl font-semibold">L</span>
                </div>

                <p class="mb-1.5 text-xs font-medium text-slate-500">
                    Backoffice
                </p>

                <h2 class="text-2xl font-semibold tracking-tight text-white">
                    Bienvenido de nuevo
                </h2>

                <p class="mt-3 text-sm leading-relaxed text-slate-400">
                    Ingresá tus credenciales para acceder a tu cuenta.
                </p>
            </div>
            
            <form method="post" class="space-y-5">
                <input type="hidden" asp-for="ReturnUrl" />

                <div>
                    <label asp-for="Email" class="mb-1.5 block text-[13px] font-medium text-slate-300">
                        Correo electrónico
                    </label>

                    <input asp-for="Email"
                           autocomplete="username"
                           autofocus
                           placeholder="nombre@empresa.com"
                           class="block w-full rounded-xl border border-line bg-field px-3 py-2.5 text-sm text-white placeholder:text-slate-600 outline-none transition-colors focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20" />

                    <span asp-validation-for="Email" class="mt-1 block text-xs text-red-400"></span>
                </div>

                <div>
                    <label asp-for="Password" class="mb-1.5 block text-[13px] font-medium text-slate-300">
                        Contraseña
                    </label>

                    <input asp-for="Password"
                           autocomplete="current-password"
                           placeholder="Ingresá tu contraseña"
                           class="block w-full rounded-xl border border-line bg-field px-3 py-2.5 text-sm text-white placeholder:text-slate-600 outline-none transition-colors focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20" />

                    <span asp-validation-for="Password" class="mt-1 block text-xs text-red-400"></span>
                </div>
                
                    @if (Model.Error is not null)
                    {
                        <div role="alert"
                             class="motion-safe:animate-lm-error-in rounded-xl border border-red-500/25 bg-red-500/10 px-4 py-3 text-sm text-red-300">
                            @Model.Error
                        </div>
                    }

                <button type="submit"
                        class="mt-3 flex w-full items-center justify-center gap-2 rounded-md bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-violet-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-400">
                    Iniciar sesión
                    <svg class="h-4 w-4" fill="none" stroke="currentColor"
                         stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M5 12h14m-6-6 6 6-6 6"/>
                    </svg>
                </button>
            </form>

            <div class="mt-8 border-t border-white/[0.07] pt-6 text-center">
                <p class="text-xs text-slate-500">
                    Acceso exclusivo para personal autorizado
                </p>
            </div>

        </div>

        <p class="mt-7! text-center text-xs text-slate-600">
            LastMileUY · Backoffice
        </p>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
