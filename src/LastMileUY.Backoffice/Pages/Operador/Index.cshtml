
@page
@model LastMileUY.Backoffice.Pages.Operador.IndexModel

@{
    ViewData["Title"] = "Mi operador";
    var operador = Model.Operador;
}

<div class="mx-auto max-w-[1600px] space-y-7 motion-safe:animate-lm-form-in">

    <!-- Encabezado -->
    <div>
        <p class="mb-2 text-sm font-medium text-violet-400">
            Configuración del operador
        </p>

        <h1 class="text-3xl font-bold tracking-tight text-white">
            Mi operador
        </h1>

        <p class="mt-2 text-sm text-slate-400">
            Consultá la identidad y las reglas operativas de tu organización, y configurá las entregas parciales.
        </p>
    </div>

    @if (Model.Error is not null)
    {
        <div role="alert"
             class="rounded-xl border border-red-500/25 bg-red-500/10 px-5 py-4 text-sm text-red-300">
            @Model.Error
        </div>
    }
    else if (operador is not null)
    {
        var color = IdentidadOperador.ColorSeguro(operador.ColorPrimario);
        var logo = IdentidadOperador.LogoSeguro(operador.LogoUrl);

        <!-- Identidad -->
        <section class="overflow-hidden rounded-2xl border border-white/10 bg-[#171923]">

            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 px-6 py-5">
                <div>
                    <h2 class="text-base font-semibold text-white">
                        Identidad del operador
                    </h2>
                    <p class="mt-1 text-xs text-slate-400">
                        Información visual asociada a tu organización.
                    </p>
                </div>

                <span class="rounded-full border border-violet-500/20 bg-violet-500/10 px-3 py-1.5 text-xs font-medium text-violet-300">
                    Identidad
                </span>
            </div>

            <div class="grid gap-8 p-6 lg:grid-cols-3">

                <!-- Presentación -->
                <div class="flex flex-col items-center justify-center rounded-2xl border border-white/10 bg-[#11131b] p-8 text-center">
                    <div class="flex h-20 w-20 items-center justify-center overflow-hidden rounded-2xl border border-white/10 bg-white/5">
                        @if (logo is not null)
                        {
                            <img src="@logo"
                                 alt="Logo de @operador.Nombre"
                                 class="h-full w-full object-contain p-2" />
                        }
                        else
                        {
                            <span class="text-3xl font-bold text-violet-300">
                                @(string.IsNullOrWhiteSpace(operador.Nombre)
                                    ? "O"
                                    : operador.Nombre.Substring(0, 1).ToUpperInvariant())
                            </span>
                        }
                    </div>

                    <h3 class="mt-5 text-lg font-bold text-white">
                        @operador.Nombre
                    </h3>

                    <p class="mt-2 text-xs text-slate-500">
                        Identidad visual del operador
                    </p>

                    <div class="mt-5 h-1.5 w-20 rounded-full"
                         style="background-color: @color">
                    </div>
                </div>

                <!-- Información -->
                <div class="space-y-6 lg:col-span-2">

                    <div class="rounded-xl border border-white/10 bg-white/[0.025] p-5">
                        <p class="mb-2 text-xs font-medium uppercase tracking-wider text-slate-500">
                            Nombre
                        </p>
                        <p class="text-lg font-semibold text-white">
                            @operador.Nombre
                        </p>
                    </div>

                    <div class="rounded-xl border border-white/10 bg-white/[0.025] p-5">
                        <p class="mb-3 text-xs font-medium uppercase tracking-wider text-slate-500">
                            Color principal
                        </p>

                        <div class="flex flex-wrap items-center gap-3">
                            <span class="h-9 w-9 shrink-0 rounded-xl border border-white/10"
                                  style="background-color: @color">
                            </span>

                            <div>
                                <p class="font-mono text-sm font-semibold text-slate-200">
                                    @(operador.ColorPrimario ?? "Sin definir")
                                </p>
                                @if (operador.ColorPrimario is null)
                                {
                                    <p class="mt-1 text-xs text-slate-500">
                                        Se utiliza el color predeterminado del sistema.
                                    </p>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="rounded-xl border border-white/10 bg-white/[0.025] p-5">
                        <p class="mb-2 text-xs font-medium uppercase tracking-wider text-slate-500">
                            Logo
                        </p>

                        <p class="text-sm text-slate-300">
                            @(logo is null
                                ? "Sin logo. Se muestra la inicial del nombre."
                                : "Logo configurado correctamente.")
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Depósito: de dónde salen las rutas -->
        <section id="deposito" class="overflow-hidden rounded-2xl border border-white/10 bg-[#171923]">

            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 px-6 py-5">
                <div>
                    <h2 class="text-base font-semibold text-white">
                        Depósito
                    </h2>

                    <p class="mt-1 max-w-2xl text-xs leading-relaxed text-slate-400">
                        De dónde salen las hojas de ruta. Es el punto de partida del orden sugerido de las paradas.
                        Copiá la latitud y la longitud de cualquier mapa (por ejemplo, con clic derecho en OpenStreetMap o Google Maps).
                    </p>
                </div>

                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-300">
                    @(operador.Deposito is null ? "Sin cargar" : "Cargado")
                </span>
            </div>

            <div class="space-y-4 p-6">

                @if (Model.AvisoDeposito is not null)
                {
                    <div role="status"
                         class="rounded-xl border border-emerald-500/25 bg-emerald-500/10 px-5 py-4 text-sm text-emerald-300">
                        @Model.AvisoDeposito
                    </div>
                }

                @if (Model.ErrorDeposito is not null)
                {
                    <div role="alert"
                         class="rounded-xl border border-red-500/25 bg-red-500/10 px-5 py-4 text-sm text-red-300">
                        @Model.ErrorDeposito
                    </div>
                }

                <form method="post" asp-page-handler="GuardarDeposito" class="flex flex-wrap items-end gap-4">
                    <div>
                        <label for="latitud" class="mb-2 block text-sm font-medium text-slate-300">Latitud</label>
                        <input id="latitud" name="latitud" inputmode="decimal" autocomplete="off"
                               value="@(operador.Deposito is null ? "" : IndexModel.Grados(operador.Deposito.Latitud))"
                               placeholder="-34.9011"
                               class="w-44 rounded-xl border border-[#343747] bg-[#10121a] px-4 py-3 text-sm text-white outline-none focus:border-violet-500" />
                    </div>

                    <div>
                        <label for="longitud" class="mb-2 block text-sm font-medium text-slate-300">Longitud</label>
                        <input id="longitud" name="longitud" inputmode="decimal" autocomplete="off"
                               value="@(operador.Deposito is null ? "" : IndexModel.Grados(operador.Deposito.Longitud))"
                               placeholder="-56.1645"
                               class="w-44 rounded-xl border border-[#343747] bg-[#10121a] px-4 py-3 text-sm text-white outline-none focus:border-violet-500" />
                    </div>

                    <button type="submit"
                            class="rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-violet-500">
                        Guardar depósito
                    </button>

                    @if (operador.Deposito is { } deposito)
                    {
                        <button type="submit" name="borrar" value="true"
                                class="rounded-xl border border-white/10 bg-white/5 px-5 py-3 text-sm font-medium text-slate-300 hover:bg-white/10 hover:text-white">
                            Borrar
                        </button>

                        <a href="https://www.openstreetmap.org/?mlat=@IndexModel.Grados(deposito.Latitud)&amp;mlon=@IndexModel.Grados(deposito.Longitud)#map=16/@IndexModel.Grados(deposito.Latitud)/@IndexModel.Grados(deposito.Longitud)"
                           target="_blank" rel="noopener noreferrer"
                           class="py-3 text-sm text-violet-300 hover:text-violet-200">
                            Ver en el mapa
                        </a>
                    }
                </form>
            </div>
        </section>

        <!-- Reglas operativas -->
        <section class="overflow-hidden rounded-2xl border border-white/10 bg-[#171923]">

            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 px-6 py-5">
                <div>
                    <h2 class="text-base font-semibold text-white">
                        Reglas operativas
                    </h2>

                    <p class="mt-1 text-xs text-slate-400">
                        Condiciones de entrega según la modalidad del envío.
                    </p>
                </div>

                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-300">
                    @operador.Reglas.Count reglas
                </span>
            </div>

            @if (operador.Reglas.Count == 0)
            {
                <div class="flex min-h-48 flex-col items-center justify-center px-6 py-10 text-center">
                    <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-violet-500/10 text-violet-400">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor"
                             stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1"/>
                            <circle cx="12" cy="12" r="4"/>
                        </svg>
                    </div>

                    <h3 class="text-sm font-semibold text-white">
                        No hay reglas configuradas
                    </h3>

                    <p class="mt-2 max-w-md text-sm leading-relaxed text-slate-400">
                        Los envíos siguen únicamente la tabla de estados,
                        sin límite de intentos ni plazo definido por una regla.
                    </p>
                </div>
            }
            else
            {
                <div class="w-full overflow-x-auto">
                    <table class="w-full min-w-[1050px] text-left text-sm">

                        <thead class="bg-[#11131b] text-xs font-semibold uppercase tracking-wider text-slate-400">
                            <tr>
                                <th scope="col" class="px-6 py-4">Modalidad</th>
                                <th scope="col" class="px-5 py-4">Regla</th>
                                <th scope="col" class="px-5 py-4 text-right">Intentos</th>
                                <th scope="col" class="px-5 py-4 text-right">Entre intentos</th>
                                <th scope="col" class="px-5 py-4 text-right">Plazo de entrega</th>
                                <th scope="col" class="px-5 py-4 text-right">Inicio devolución</th>
                                <th scope="col" class="px-6 py-4">Al entregar pide</th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-white/5">
                            @foreach (var regla in operador.Reglas)
                            {
                                <tr class="transition-colors hover:bg-white/[0.035]">

                                    <td class="px-6 py-5">
                                        @if (regla.Modalidad == "Urgente")
                                        {
                                            <span class="inline-flex rounded-full border border-red-500/20 bg-red-500/10 px-3 py-1 text-xs font-semibold text-red-300">
                                                Urgente
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex rounded-full border border-blue-500/20 bg-blue-500/10 px-3 py-1 text-xs font-semibold text-blue-300">
                                                Estándar
                                            </span>
                                        }
                                    </td>

                                    <td class="px-5 py-5">
                                        <p class="font-semibold text-slate-200">
                                            @regla.Nombre
                                        </p>

                                        @if (regla.Descripcion is not null)
                                        {
                                            <p class="mt-1 max-w-xs text-xs leading-relaxed text-slate-500">
                                                @regla.Descripcion
                                            </p>
                                        }
                                    </td>

                                    <td class="px-5 py-5 text-right font-semibold text-slate-200">
                                        @regla.MaximoIntentosEntrega
                                    </td>

                                    <td class="px-5 py-5 text-right text-slate-300">
                                        @regla.HorasEntreIntentos h
                                    </td>

                                    <td class="px-5 py-5 text-right text-slate-300">
                                        @regla.PlazoEntregaHoras h
                                    </td>

                                    <td class="px-5 py-5 text-right text-slate-300">
                                        @regla.HorasParaIniciarDevolucion h
                                    </td>

                                    <td class="px-6 py-5 text-slate-300">
                                        @Formato.Requisitos(
                                            regla.RequiereFirma,
                                            regla.RequiereFotografia,
                                            regla.RequiereDocumentoReceptor)
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <!-- Reglas de entrega parcial (versionadas) -->
        var vigente = Model.ReglasEntregaParcial.FirstOrDefault();

        <section id="entrega-parcial" class="overflow-hidden rounded-2xl border border-white/10 bg-[#171923]">

            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 px-6 py-5">
                <div>
                    <h2 class="text-base font-semibold text-white">
                        Reglas de entrega parcial
                    </h2>

                    <p class="mt-1 max-w-2xl text-xs leading-relaxed text-slate-400">
                        Cada cambio publica una versión nueva; las anteriores no se modifican.
                        Cada hoja de ruta usa la versión vigente al despacharse, aunque después se publique otra.
                    </p>
                </div>

                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-slate-300">
                    @(vigente is null ? "Sin versiones" : $"Versión {vigente.Version} vigente")
                </span>
            </div>

            <div class="space-y-6 p-6">

                @if (Model.Aviso is not null)
                {
                    <div role="status"
                         class="rounded-xl border border-emerald-500/25 bg-emerald-500/10 px-5 py-4 text-sm text-emerald-300">
                        @Model.Aviso
                    </div>
                }

                @if (Model.ErrorPublicacion is not null)
                {
                    <div role="alert"
                         class="rounded-xl border border-red-500/25 bg-red-500/10 px-5 py-4 text-sm text-red-300">
                        @Model.ErrorPublicacion
                    </div>
                }

                @if (Model.ErrorReglasEntregaParcial is not null)
                {
                    <div role="alert"
                         class="rounded-xl border border-red-500/25 bg-red-500/10 px-5 py-4 text-sm text-red-300">
                        @Model.ErrorReglasEntregaParcial
                    </div>
                }
                else
                {
                    <div class="grid gap-6 lg:grid-cols-5">

                        <!-- Publicar una versión nueva (parte de la vigente) -->
                        <form method="post" asp-page-handler="PublicarReglaEntregaParcial"
                              class="space-y-5 rounded-xl border border-white/10 bg-[#11131b] p-5 lg:col-span-2">

                            <h3 class="text-sm font-semibold text-white">
                                Publicar una versión nueva
                            </h3>

                            <label for="permiteEntregaParcial" class="flex items-start gap-3 text-sm text-slate-300">
                                <input type="checkbox" id="permiteEntregaParcial" name="permiteEntregaParcial" value="true"
                                       class="mt-0.5 h-4 w-4 accent-violet-500"
                                       checked="@(vigente?.PermiteEntregaParcial ?? true)" />
                                <span>
                                    Permitir entregas parciales
                                    <span class="mt-1 block text-xs text-slate-500">
                                        El repartidor puede entregar algunos bultos y dejar otros, con su motivo.
                                    </span>
                                </span>
                            </label>

                            <div>
                                <label for="destinoBultosPendientes" class="mb-2 block text-xs font-medium uppercase tracking-wider text-slate-500">
                                    Bultos que quedan sin entregar
                                </label>
                                <select id="destinoBultosPendientes" name="destinoBultosPendientes"
                                        class="w-full rounded-lg border border-white/10 bg-[#171923] px-3 py-2 text-sm text-slate-200">
                                    @foreach (var destino in new[] { "NuevaHojaDeRuta", "Devolucion" })
                                    {
                                        <option value="@destino" selected="@(vigente?.DestinoBultosPendientes == destino)">
                                            @IndexModel.TextoDestino(destino)
                                        </option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label for="motivo" class="mb-2 block text-xs font-medium uppercase tracking-wider text-slate-500">
                                    Motivo del cambio
                                </label>
                                <textarea id="motivo" name="motivo" rows="3" maxlength="500" required
                                          placeholder="Por ejemplo: los bultos que quedan se devuelven al comercio"
                                          class="w-full rounded-lg border border-white/10 bg-[#171923] px-3 py-2 text-sm text-slate-200 placeholder:text-slate-600"></textarea>
                                <p class="mt-1 text-xs text-slate-500">Queda en el historial.</p>
                            </div>

                            <button type="submit"
                                    class="w-full rounded-lg bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-violet-500">
                                Publicar versión @((vigente?.Version ?? 0) + 1)
                            </button>
                        </form>

                        <!-- Historial de versiones -->
                        <div class="lg:col-span-3">
                            @if (Model.ReglasEntregaParcial.Count == 0)
                            {
                                <p class="rounded-xl border border-white/10 bg-white/[0.025] p-5 text-sm leading-relaxed text-slate-400">
                                    Todavía no hay versiones publicadas: las entregas parciales se permiten
                                    y los bultos que quedan vuelven a salir.
                                </p>
                            }
                            else
                            {
                                <div class="w-full overflow-x-auto">
                                    <table class="w-full min-w-[640px] text-left text-sm">
                                        <thead class="bg-[#11131b] text-xs font-semibold uppercase tracking-wider text-slate-400">
                                            <tr>
                                                <th scope="col" class="px-4 py-3">Versión</th>
                                                <th scope="col" class="px-4 py-3">Parciales</th>
                                                <th scope="col" class="px-4 py-3">Bultos sin entregar</th>
                                                <th scope="col" class="px-4 py-3">Motivo</th>
                                                <th scope="col" class="px-4 py-3">Publicada</th>
                                            </tr>
                                        </thead>

                                        <tbody class="divide-y divide-white/5">
                                            @foreach (var regla in Model.ReglasEntregaParcial)
                                            {
                                                <tr class="align-top">
                                                    <td class="px-4 py-4 font-semibold text-slate-200">
                                                        @regla.Version
                                                        @if (regla.Id == vigente!.Id)
                                                        {
                                                            <span class="ml-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2 py-0.5 text-[11px] font-semibold text-emerald-300">
                                                                Vigente
                                                            </span>
                                                        }
                                                    </td>
                                                    <td class="px-4 py-4 text-slate-300">
                                                        @(regla.PermiteEntregaParcial ? "Permitidas" : "No permitidas")
                                                    </td>
                                                    <td class="px-4 py-4 text-slate-300">
                                                        @IndexModel.TextoDestino(regla.DestinoBultosPendientes)
                                                    </td>
                                                    <td class="max-w-xs px-4 py-4 text-xs leading-relaxed text-slate-400">
                                                        @(regla.Motivo ?? "—")
                                                    </td>
                                                    <td class="px-4 py-4 text-xs text-slate-400">
                                                        <p>@Formato.Fecha(regla.FechaPublicacion)</p>
                                                        <p class="mt-1 text-slate-500">@regla.PublicadaPor</p>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    }
    else
    {
        <div class="rounded-xl border border-white/10 bg-[#171923] px-6 py-8 text-sm text-slate-400">
            No hay información del operador disponible.
        </div>
    }
</div>
