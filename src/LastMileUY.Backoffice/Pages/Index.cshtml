
@page
@model IndexModel

@{
    ViewData["Title"] = "Inicio";
}

<div class="mx-auto max-w-7xl space-y-8 motion-safe:animate-lm-form-in">

    <!-- Bienvenida -->
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="mb-2 text-sm font-medium text-violet-400">
                Panel de control
            </p>

            <h1 class="text-3xl font-bold tracking-tight text-white">
                Bienvenido a LastMileUY
            </h1>

            <p class="mt-2 text-sm text-slate-400">
                Administrá y supervisá tus operaciones desde un solo lugar.
            </p>
        </div>

        <a asp-page="/Envios/Index"
           class="inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold text-white no-underline transition-colors hover:bg-violet-500 hover:text-white">
            Ver envíos
            <span aria-hidden="true">→</span>
        </a>
    </div>

    @if (Model.Error is not null)
    {
        <div role="alert"
             class="rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-300">
            @Model.Error
        </div>
    }

    <!-- Tarjetas de resumen -->
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

        <div class="rounded-2xl border border-white/10 bg-[#171923] p-6">
            <p class="text-sm text-slate-400">
                Envíos totales
            </p>

            <p id="total-envios"
               class="mt-4 text-3xl font-bold text-white">
                @Model.TotalEnvios
            </p>

            <p class="mt-3 text-xs text-slate-500">
                Resumen de operaciones
            </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-[#171923] p-6">
            <p class="text-sm text-slate-400">
                En tránsito
            </p>

            <p id="en-transito"
               class="mt-4 text-3xl font-bold text-white">
                @Model.EnTransito
            </p>

            <p class="mt-3 text-xs text-slate-500">
                Envíos en distribución
            </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-[#171923] p-6">
            <p class="text-sm text-slate-400">
                Entregados
            </p>

            <p id="entregados"
               class="mt-4 text-3xl font-bold text-white">
                @Model.Entregados
            </p>

            <p class="mt-3 text-xs text-slate-500">
                Entregas completadas
            </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-[#171923] p-6">
            <p class="text-sm text-slate-400">
                Incidencias
            </p>

            <p id="incidencias"
               class="mt-4 text-3xl font-bold text-white">
                @Model.Incidencias
            </p>

            <p class="mt-3 text-xs text-slate-500">
                Envíos que requieren atención
            </p>
        </div>

    </div>

    <!-- Sección inferior -->
    <div class="grid gap-5 lg:grid-cols-3">

        <!-- Actividad reciente -->
        <section class="min-w-0 rounded-2xl border border-white/10 bg-[#171923] p-6 lg:col-span-2">

            <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 class="text-lg font-semibold text-white">
                    Actividad reciente
                </h2>

                <span id="estado-signalr"
      role="status"
      aria-live="polite"
      class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1.5 text-xs font-semibold text-emerald-300 shadow-sm shadow-emerald-500/10">
    <span id="punto-signalr"
          class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
    </span>
    <span id="texto-signalr">Conectando...</span>
</span>
            </div>

            <p class="mt-1 text-sm text-slate-400">
                Últimos 10 movimientos registrados en tus envíos.
            </p>

            <!-- Mensaje sin actividad -->
            <div id="actividad-vacia"
                 class="mt-6 flex min-h-32 flex-col items-center justify-center rounded-xl border border-dashed border-white/10 px-4 text-center">
                <p class="text-sm text-slate-400">
                    Cargando actividad...
                </p>
            </div>

            <!-- Historial con scroll -->
            <div class="mt-4 max-h-[400px] overflow-y-auto overscroll-contain pr-2">
                <ul id="actividad-reciente"
                    aria-live="polite"
                    class="space-y-3">
                </ul>
            </div>

        </section>

        <!-- Accesos rápidos -->
        <section class="rounded-2xl border border-white/10 bg-[#171923] p-6">
            <h2 class="text-lg font-semibold text-white">
                Accesos rápidos
            </h2>

            <p class="mt-1 text-sm text-slate-400">
                Tus herramientas principales.
            </p>

            <div class="mt-6 space-y-3">
                <a asp-page="/Envios/Index"
                   class="flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-4 text-sm font-medium text-slate-200 no-underline transition-colors hover:border-violet-500/30 hover:bg-violet-500/10 hover:text-white">
                    Gestionar envíos
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </section>

    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const actividad = document.getElementById("actividad-reciente");
            const vacio = document.getElementById("actividad-vacia");
            
            let actualizando = false;
            let actualizarDeNuevo = false;
            let temporizador = null;

            function establecerEstado(texto) {
                const indicador = document.getElementById("estado-signalr");
                const punto = document.getElementById("punto-signalr");
                const textoEstado = document.getElementById("texto-signalr");

                if (!indicador || !punto || !textoEstado) return;

                const conectado = texto === "En vivo";

                textoEstado.textContent = texto;

                indicador.className = conectado
                    ? "inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1.5 text-xs font-semibold text-emerald-300"
                    : "inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1.5 text-xs font-semibold text-amber-300";

                punto.innerHTML = conectado
                    ? `<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
           <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-400"></span>`
                    : `<span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-amber-400"></span>`;
            }

            function mostrarVacio(mensaje) {
                vacio.querySelector("p").textContent = mensaje;
                vacio.style.display = "flex";
            }

            function ocultarVacio() {
                vacio.style.display = "none";
            }

            function crearElemento(evento) {
                const item = document.createElement("li");

                item.className =
                    "rounded-xl border border-white/10 bg-white/5 p-4";

                const cabecera = document.createElement("div");

                cabecera.className =
                    "flex flex-wrap items-center justify-between gap-2";

                const codigo = document.createElement("p");

                codigo.className =
                    "break-all text-sm font-semibold text-white";

                codigo.textContent =
                    `Envío ${evento.codigoSeguimiento}`;

                const origen = document.createElement("span");

                origen.className =
                    "rounded-full bg-violet-500/10 px-2.5 py-1 text-xs text-violet-300";

                origen.textContent = evento.origen || "Sin origen";

                cabecera.append(codigo, origen);

                const detalle = document.createElement("p");

                detalle.className =
                    "mt-2 text-sm text-slate-300";

                detalle.textContent =
                    evento.descripcion ||
                    evento.estado ||
                    "Movimiento registrado";

                const fecha = document.createElement("p");

                fecha.className =
                    "mt-2 text-xs text-slate-500";

                const fechaEvento = new Date(evento.fechaHora);

                fecha.textContent = Number.isNaN(fechaEvento.getTime())
                    ? "Fecha no disponible"
                    : fechaEvento.toLocaleString("es-UY");

                item.append(cabecera, detalle, fecha);

                return item;
            }

            async function cargarActividadReciente() {
                const respuesta = await fetch(
                    '@Url.Page("/Index", "Actividad")',
                    {
                        credentials: "same-origin",
                        cache: "no-store"
                    }
                );

                if (!respuesta.ok) {
                    throw new Error(
                        `Error cargando actividad: HTTP ${respuesta.status}`
                    );
                }

                const datos = await respuesta.json();

                // Los eventos de PostgreSQL son la fuente de verdad.
                // Evitamos duplicados por ID y conservamos los últimos 10.
                const ids = new Set();

                const eventos = datos
                    .filter(evento => {
                        if (ids.has(evento.id)) {
                            return false;
                        }

                        ids.add(evento.id);
                        return true;
                    })
                    .slice(0, 10);

                actividad.replaceChildren(
                    ...eventos.map(crearElemento)
                );

                if (eventos.length === 0) {
                    mostrarVacio(
                        "Todavía no hay movimientos registrados."
                    );
                } else {
                    ocultarVacio();
                }
            }

            async function actualizarEstadisticas() {
                const respuesta = await fetch(
                    '@Url.Page("/Index", "Estadisticas")',
                    {
                        credentials: "same-origin",
                        cache: "no-store"
                    }
                );

                if (!respuesta.ok) {
                    throw new Error(
                        `Error cargando estadísticas: HTTP ${respuesta.status}`
                    );
                }

                const datos = await respuesta.json();

                document.getElementById("total-envios").textContent =
                    datos.totalEnvios;

                document.getElementById("en-transito").textContent =
                    datos.enTransito;

                document.getElementById("entregados").textContent =
                    datos.entregados;

                document.getElementById("incidencias").textContent =
                    datos.incidencias;
            }

            async function refrescar() {
                if (actualizando) {
                    actualizarDeNuevo = true;
                    return;
                }

                actualizando = true;

                try {
                    do {
                        actualizarDeNuevo = false;

                        const resultados = await Promise.allSettled([
                            cargarActividadReciente(),
                            actualizarEstadisticas()
                        ]);

                        for (const resultado of resultados) {
                            if (resultado.status === "rejected") {
                                console.error(
                                    "Error actualizando tablero:",
                                    resultado.reason
                                );
                            }
                        }

                    } while (actualizarDeNuevo);
                } finally {
                    actualizando = false;
                }
            }

            // Agrupa notificaciones cercanas para no
            // consultar repetidamente la API.
            function programarActualizacion() {
                clearTimeout(temporizador);

                temporizador = setTimeout(() => {
                    void refrescar();
                }, 250);
            }


            // SignalR notifica; los datos se consultan desde PostgreSQL.
            window.addEventListener("lastmileuy:envio-actualizado", () => {
                programarActualizacion();
            });

            window.addEventListener("lastmileuy:signalr-estado", evento => {
                establecerEstado(evento.detail.estado);
            });

            // Consultar el estado actual, aunque el evento ya haya ocurrido.
            const conexionSignalR = window.LastMileUYSignalR?.conexion;

            if (conexionSignalR) {
                establecerEstado(
                    conexionSignalR.state === signalR.HubConnectionState.Connected
                        ? "En vivo"
                        : "Conectando..."
                );
            }

            window.addEventListener("lastmileuy:signalr-sincronizar", () => {
                programarActualizacion();
            });

            // Limpiar el temporizador al abandonar la página.
            window.addEventListener("pagehide", () => {
                clearTimeout(temporizador);
            });

            // La carga inicial no depende de SignalR.
            void refrescar();

            // La conexión se administra desde envios-signalr.js.
        })();
    </script>
}
