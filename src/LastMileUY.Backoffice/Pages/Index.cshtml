
@page
@model IndexModel

@{
    ViewData["Title"] = "Inicio";
}

<div class="mx-auto max-w-7xl space-y-8 motion-safe:animate-lm-form-in">

    <!-- Bienvenida -->
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="mb-2 text-sm font-medium text-violet-400">
                Panel de control
            </p>

            <h1 class="text-3xl font-bold tracking-tight text-white">
                Bienvenido a LastMileUY
            </h1>

            <p class="mt-2 text-sm text-slate-400">
                Administrá y supervisá tus operaciones desde un solo lugar.
            </p>
        </div>

        <a asp-page="/Envios/Index"
           class="inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold text-white no-underline transition-colors hover:bg-violet-500 hover:text-white">
            Ver envíos
            <span aria-hidden="true">→</span>
        </a>
    </div>

    <!-- Tarjetas de resumen -->
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

        <div class="rounded-2xl border border-white/10 bg-[#171923] p-6">
            <p class="text-sm text-slate-400">Envíos totales</p>
            <p class="mt-4 text-3xl font-bold text-white">—</p>
            <p class="mt-3 text-xs text-slate-500">Resumen de operaciones</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-[#171923] p-6">
            <p class="text-sm text-slate-400">En tránsito</p>
            <p class="mt-4 text-3xl font-bold text-white">—</p>
            <p class="mt-3 text-xs text-slate-500">Envíos en distribución</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-[#171923] p-6">
            <p class="text-sm text-slate-400">Entregados</p>
            <p class="mt-4 text-3xl font-bold text-white">—</p>
            <p class="mt-3 text-xs text-slate-500">Entregas completadas</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-[#171923] p-6">
            <p class="text-sm text-slate-400">Incidencias</p>
            <p class="mt-4 text-3xl font-bold text-white">—</p>
            <p class="mt-3 text-xs text-slate-500">Envíos que requieren atención</p>
        </div>

    </div>

    <!-- Sección inferior -->
    <div class="grid gap-5 lg:grid-cols-3">

        <section class="rounded-2xl border border-white/10 bg-[#171923] p-6 lg:col-span-2">
            <h2 class="text-lg font-semibold text-white">
                Actividad reciente
            </h2>

            <p class="mt-1 text-sm text-slate-400">
                Últimos movimientos de tus envíos.
            </p>

            <div class="mt-8 flex min-h-48 flex-col items-center justify-center rounded-xl border border-dashed border-white/10 px-4 text-center">
                <p class="text-sm font-medium text-slate-300">
                    Próximamente, actividad en tiempo real
                </p>

                <p class="mt-2 max-w-sm text-xs text-slate-500">
                    Acá mostraremos los últimos cambios de estado registrados en la plataforma.
                </p>
            </div>
        </section>

        <section class="rounded-2xl border border-white/10 bg-[#171923] p-6">
            <h2 class="text-lg font-semibold text-white">
                Accesos rápidos
            </h2>

            <p class="mt-1 text-sm text-slate-400">
                Tus herramientas principales.
            </p>

            <div class="mt-6 space-y-3">
                <a asp-page="/Envios/Index"
                   class="flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-4 text-sm font-medium text-slate-200 no-underline transition-colors hover:border-violet-500/30 hover:bg-violet-500/10 hover:text-white">
                    Gestionar envíos
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </section>

    </div>
</div>
