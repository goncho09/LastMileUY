@page
@model LastMileUY.Backoffice.Pages.Configuracion.VehiculosModel
@{
    ViewData["Title"] = "Vehículos";
    var editando = Model.Editar is not null;
}

<div class="mx-auto max-w-[1600px] space-y-7 motion-safe:animate-lm-form-in">

    <partial name="_Encabezado" model="@(("Vehículos", "La flota con la que salen las hojas de ruta. Uno dado de baja deja de ofrecerse al armar rutas.", Model.Error))" />

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_380px]">

        <section class="@Estilos.Tarjeta" aria-labelledby="titulo-vehiculos">
            <div class="@Estilos.EncabezadoTarjeta">
                <h2 id="titulo-vehiculos" class="text-base font-semibold text-white">Flota</h2>
            </div>

            @if (Model.Vehiculos.Count == 0)
            {
                <p class="px-6 py-10 text-center text-sm text-slate-400">Todavía no cargaste ningún vehículo.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="@Estilos.Tabla">
                        <thead class="@Estilos.CabeceraTabla">
                            <tr>
                                <th scope="col" class="@Estilos.Celda">Matrícula</th>
                                <th scope="col" class="@Estilos.Celda">Tipo</th>
                                <th scope="col" class="@Estilos.Celda">Capacidad</th>
                                <th scope="col" class="@Estilos.Celda">Estado</th>
                                <th scope="col" class="@Estilos.Celda"><span class="sr-only">Acciones</span></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            @foreach (var vehiculo in Model.Vehiculos)
                            {
                                <tr>
                                    <td class="@Estilos.Celda font-mono font-medium text-white">@vehiculo.Matricula</td>
                                    <td class="@Estilos.Celda text-slate-300">@vehiculo.Tipo</td>
                                    <td class="@Estilos.Celda text-slate-300">@Formato.Numero(vehiculo.CapacidadPesoKg) kg · @Formato.Volumen(vehiculo.CapacidadVolumenM3)</td>
                                    <td class="@Estilos.Celda">
                                        <span class="@(vehiculo.Activo ? Estilos.Activo : Estilos.Inactivo)">@(vehiculo.Activo ? "Disponible" : "De baja")</span>
                                    </td>
                                    <td class="@Estilos.Celda">
                                        <div class="flex justify-end gap-2">
                                            <a asp-page="Vehiculos" asp-route-editar="@vehiculo.Id" class="@Estilos.BotonSecundario"
                                               aria-label="Editar el vehículo @vehiculo.Matricula">Editar</a>
                                            <form method="post" asp-page-handler="CambiarActivo">
                                                <input type="hidden" name="id" value="@vehiculo.Id" />
                                                <input type="hidden" name="activo" value="@(vehiculo.Activo ? "false" : "true")" />
                                                <button type="submit" class="@Estilos.BotonSecundario"
                                                        aria-label="@(vehiculo.Activo ? "Dar de baja" : "Reactivar") el vehículo @vehiculo.Matricula">
                                                    @(vehiculo.Activo ? "Dar de baja" : "Reactivar")
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="@Estilos.Tarjeta h-fit" aria-labelledby="titulo-formulario">
            <div class="@Estilos.EncabezadoTarjeta">
                <h2 id="titulo-formulario" class="text-base font-semibold text-white">@(editando ? "Editar vehículo" : "Nuevo vehículo")</h2>
            </div>

            <form method="post" asp-page-handler="Guardar" asp-route-editar="@Model.Editar" class="space-y-5 p-6">
                <div>
                    <label asp-for="Formulario.Matricula" class="@Estilos.Etiqueta">Matrícula <span class="text-red-400">*</span></label>
                    <input asp-for="Formulario.Matricula" maxlength="20" placeholder="Ej. SBA1234" class="@Estilos.Campo uppercase" />
                    <span asp-validation-for="Formulario.Matricula" class="@Estilos.ErrorCampo"></span>
                </div>

                <div>
                    <label asp-for="Formulario.Tipo" class="@Estilos.Etiqueta">Tipo <span class="text-red-400">*</span></label>
                    <input asp-for="Formulario.Tipo" maxlength="50" placeholder="Ej. Furgón, Moto" list="tipos-vehiculo" class="@Estilos.Campo" />
                    <datalist id="tipos-vehiculo">
                        <option value="Furgón"></option>
                        <option value="Camioneta"></option>
                        <option value="Moto"></option>
                        <option value="Camión"></option>
                    </datalist>
                    <span asp-validation-for="Formulario.Tipo" class="@Estilos.ErrorCampo"></span>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Formulario.CapacidadPesoKg" class="@Estilos.Etiqueta">Peso máx. (kg) <span class="text-red-400">*</span></label>
                        <input asp-for="Formulario.CapacidadPesoKg" type="number" min="0.01" step="0.01" inputmode="decimal" class="@Estilos.Campo" />
                        <span asp-validation-for="Formulario.CapacidadPesoKg" class="@Estilos.ErrorCampo"></span>
                    </div>
                    <div>
                        <label asp-for="Formulario.CapacidadVolumenM3" class="@Estilos.Etiqueta">Volumen máx. (m³) <span class="text-red-400">*</span></label>
                        <input asp-for="Formulario.CapacidadVolumenM3" type="number" min="0.001" step="0.001" inputmode="decimal" class="@Estilos.Campo" />
                        <span asp-validation-for="Formulario.CapacidadVolumenM3" class="@Estilos.ErrorCampo"></span>
                    </div>
                </div>

                <div class="flex flex-wrap justify-end gap-3">
                    @if (editando)
                    {
                        <a asp-page="Vehiculos" class="@Estilos.BotonSecundario">Cancelar</a>
                    }
                    <button type="submit" class="@Estilos.BotonPrincipal">@(editando ? "Guardar cambios" : "Agregar vehículo")</button>
                </div>
            </form>
        </section>
    </div>
</div>
