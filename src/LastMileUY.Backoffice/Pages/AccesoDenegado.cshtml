@page
@{
ViewData["Title"] = "Sin permiso";
var conSesion = User.Identity?.IsAuthenticated == true;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body">
                <h1 class="h4">No tenés permiso para ver esta página</h1>
                @if (conSesion && Permisos.Perfil(User) != "Sin perfil")
                {
                <p class="mb-3">Tu perfil (@Permisos.Perfil(User)) no incluye esta sección.</p>
                <a asp-page="/Envios/Index" class="btn btn-primary">Ir a los envíos</a>
                }
                else
                {
                <p class="mb-3">Tu sesión no tiene un perfil del Backoffice. Salí y volvé a entrar; si sigue pasando, pedile acceso al administrador.</p>
                @if (conSesion)
                {
                <form method="post" asp-page="/Logout">
                    <button type="submit" class="btn btn-primary">Salir</button>
                </form>
                }
                else
                {
                <a asp-page="/Login" class="btn btn-primary">Iniciar sesión</a>
                }
                }
            </div>
        </div>
    </div>
</div>
