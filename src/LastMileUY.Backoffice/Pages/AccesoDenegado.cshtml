@page "/acceso-denegado"
@* La dirección es la de AccessDeniedPath en Program.cs: sin ella, quien no tiene permiso veía un 404 *@
@{
ViewData["Title"] = "Sin permiso";
var conSesion = User.Identity?.IsAuthenticated == true;
var claseBoton = "inline-flex items-center rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold text-white no-underline transition-colors hover:bg-violet-500";
}

<div class="mx-auto max-w-xl">
    <section class="rounded-2xl border border-white/10 bg-[#171923] p-6 sm:p-8">
        <h1 class="text-2xl font-bold tracking-tight text-white">No tenés permiso para ver esta página</h1>
        @if (conSesion && Permisos.Perfil(User) != "Sin perfil")
        {
            <p class="mt-3 mb-6 text-sm text-slate-400">Tu perfil (@Permisos.Perfil(User)) no incluye esta sección.</p>
            @* Al inicio y no a envíos: el inicio manda a cada perfil a lo suyo (el administrador no ve envíos) *@
            <a asp-page="/Index" class="@claseBoton">Ir al inicio</a>
        }
        else
        {
            <p class="mt-3 mb-6 text-sm text-slate-400">Tu sesión no tiene un perfil del Backoffice. Salí y volvé a entrar; si sigue pasando, pedile acceso al administrador.</p>
            @if (conSesion)
            {
                <form method="post" asp-page="/Logout">
                    <button type="submit" class="@claseBoton">Salir</button>
                </form>
            }
            else
            {
                <a asp-page="/Login" class="@claseBoton">Iniciar sesión</a>
            }
        }
    </section>
</div>
