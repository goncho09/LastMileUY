@page
@model LastMileUY.Backoffice.Pages.Funcionalidades.IndexModel

@{
    ViewData["Title"] = "Funcionalidades";
}

<div class="mx-auto max-w-[1600px] space-y-7 motion-safe:animate-lm-form-in">

    <div>
        <p class="mb-1.5 text-xs font-medium text-slate-500">Administración / Plataforma</p>
        <h1 class="text-2xl font-semibold tracking-tight text-white">Funcionalidades por operador</h1>
        <p class="mt-2 max-w-3xl text-sm text-slate-400">
            Prendé o apagá partes del sistema para cada operador. El cambio vale enseguida, sin desplegar de nuevo.
        </p>
    </div>

    @if (TempData["Aviso"] is string aviso)
    {
        <div role="status" class="rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-5 py-4 text-sm text-emerald-300">
            @aviso
        </div>
    }

    @if (Model.Error is not null)
    {
        <div role="alert" class="rounded-xl border border-red-500/30 bg-red-500/10 px-5 py-4 text-sm text-red-300">
            @Model.Error
        </div>
    }

    @foreach (var operador in Model.Operadores)
    {
        <section class="overflow-hidden rounded-2xl border border-white/[0.07] bg-surface" aria-labelledby="operador-@operador.OperadorId">
            <h2 id="operador-@operador.OperadorId" class="border-b border-white/[0.07] px-6 py-4 text-lg font-semibold text-white">
                @operador.Operador
            </h2>

            <ul class="divide-y divide-white/5">
                @foreach (var funcionalidad in operador.Funcionalidades)
                {
                    <li class="flex flex-wrap items-center justify-between gap-4 px-6 py-4">
                        <div class="min-w-0 max-w-2xl">
                            <p class="font-medium text-white">
                                @funcionalidad.Nombre
                                @if (funcionalidad.Activa)
                                {
                                    <span class="ml-2 rounded-full bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-300">Prendida</span>
                                }
                                else
                                {
                                    <span class="ml-2 rounded-full bg-slate-500/20 px-2 py-0.5 text-xs font-semibold text-slate-300">Apagada</span>
                                }
                            </p>
                            <p class="mt-1 text-sm text-slate-400">@funcionalidad.Descripcion</p>
                        </div>

                        <form method="post" asp-page-handler="Cambiar">
                            <input type="hidden" name="operadorId" value="@operador.OperadorId"/>
                            <input type="hidden" name="clave" value="@funcionalidad.Clave"/>
                            <input type="hidden" name="activa" value="@(funcionalidad.Activa ? "false" : "true")"/>
                            <button type="submit"
                                    aria-label="@(funcionalidad.Activa ? "Apagar" : "Prender") @funcionalidad.Nombre para @operador.Operador"
                                    class="@(funcionalidad.Activa
                                               ? "rounded-xl border border-white/[0.07] bg-white/5 px-4 py-2 text-sm font-semibold text-slate-200 transition-colors hover:bg-white/10"
                                               : "rounded-xl bg-violet-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-violet-500")">
                                @(funcionalidad.Activa ? "Apagar" : "Prender")
                            </button>
                        </form>
                    </li>
                }
            </ul>
        </section>
    }
</div>
