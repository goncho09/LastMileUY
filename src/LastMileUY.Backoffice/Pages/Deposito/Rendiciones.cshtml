@page
@model LastMileUY.Backoffice.Pages.Deposito.RendicionesModel
@{
    ViewData["Title"] = "Rendiciones";
}

<div class="mx-auto max-w-[1600px] space-y-7">

    <partial name="_Encabezado" model="@(("Rendiciones", "Las hojas de ruta que ya salieron y todavía no se rindieron. Al volver el repartidor, se escanea lo que trae y la ruta se cierra.", Model.Error))" />

    <partial name="_Pestanas" model="@("Rendiciones")" />

    <section class="@Estilos.Tarjeta" aria-labelledby="titulo-rendiciones">
        <div class="@Estilos.EncabezadoTarjeta">
            <h2 id="titulo-rendiciones" class="text-base font-semibold text-white">Rutas por rendir</h2>
        </div>

        @if (Model.Rutas.Count == 0)
        {
            <p class="px-6 py-10 text-center text-sm text-slate-400">No hay hojas de ruta por rendir.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="@Estilos.Tabla">
                    <thead class="@Estilos.CabeceraTabla">
                        <tr>
                            <th scope="col" class="@Estilos.Celda">Ruta</th>
                            <th scope="col" class="@Estilos.Celda">Repartidor</th>
                            <th scope="col" class="@Estilos.Celda">Entregados</th>
                            <th scope="col" class="@Estilos.Celda">Bultos que vuelven</th>
                            <th scope="col" class="@Estilos.Celda">Rendición</th>
                            <th scope="col" class="@Estilos.Celda"><span class="sr-only">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                        @foreach (var ruta in Model.Rutas)
                        {
                            var (texto, clase) = RendicionesModel.EstadoRendicion(ruta.EstadoRendicion);
                            <tr>
                                <td class="@Estilos.Celda">
                                    <p class="font-medium text-white">@ruta.Nombre</p>
                                    <p class="mt-1 text-xs text-slate-400">@Formato.Fecha(ruta.Fecha) · @EstadosRuta.Texto(ruta.EstadoRuta)</p>
                                </td>
                                <td class="@Estilos.Celda text-slate-300">@ruta.Repartidor</td>
                                <td class="@Estilos.Celda text-slate-300">@ruta.CantidadEntregados</td>
                                <td class="@Estilos.Celda text-slate-300">@ruta.CantidadADevolver</td>
                                <td class="@Estilos.Celda">
                                    <span class="rounded border px-1.5 py-0.5 text-xs whitespace-nowrap @clase">@texto</span>
                                </td>
                                <td class="@Estilos.Celda text-right">
                                    <a asp-page="Rendicion" asp-route-ruta="@ruta.Id" class="@Estilos.BotonSecundario"
                                       aria-label="Rendir @ruta.Nombre">Rendir</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
