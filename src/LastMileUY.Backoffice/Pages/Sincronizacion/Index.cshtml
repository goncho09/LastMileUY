@page
@model LastMileUY.Backoffice.Pages.Sincronizacion.IndexModel

@{
    ViewData["Title"] = "Sincronización";
    var claseCampo = "block w-full rounded-xl border border-[#343747] bg-[#10121a] px-4 py-3 text-sm text-white outline-none transition-colors focus:border-violet-500 focus:ring-2 focus:ring-violet-500/15";
}

<div class="mx-auto max-w-[1600px] space-y-7 motion-safe:animate-lm-form-in">

    <div>
        <p class="mb-2 text-sm font-medium text-violet-400">App del repartidor</p>
        <h1 class="text-3xl font-bold tracking-tight text-white">Sincronización</h1>
        <p class="mt-2 max-w-3xl text-sm text-slate-400">
            Entregas e intentos fallidos que mandaron los repartidores desde la app, con lo que pasó con cada uno.
            Si el envío ya había cambiado en el servidor, la operación no se aplica y queda como
            <strong class="text-amber-300">conflicto</strong> para que la resuelvas.
        </p>
    </div>

    <section class="rounded-2xl border border-white/10 bg-[#171923] p-5 sm:p-6">
        <form method="get" class="grid items-end gap-4 md:grid-cols-2 xl:grid-cols-12">
            <div class="xl:col-span-4">
                <label for="resultado" class="mb-2 block text-sm font-medium text-slate-300">Resultado</label>
                <select id="resultado" name="resultado" class="@claseCampo">
                    <option value="">Todos</option>
                    @foreach (var resultado in ResultadosSincronizacion.Todos)
                    {
                        <option value="@resultado.Valor" selected="@(resultado.Valor == Model.Resultado)">@resultado.Texto</option>
                    }
                </select>
            </div>

            <div class="flex gap-2 xl:col-span-4">
                <button type="submit"
                        class="flex-1 rounded-xl bg-violet-600 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-violet-500">
                    Filtrar
                </button>
                <a asp-page="/Sincronizacion/Index"
                   class="inline-flex items-center justify-center rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-medium text-slate-300 no-underline transition-colors hover:bg-white/10 hover:text-white">
                    Limpiar
                </a>
            </div>
        </form>
    </section>

    <section class="overflow-hidden rounded-2xl border border-white/10 bg-[#171923]">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 px-5 py-5 sm:px-6">
            <h2 class="text-base font-semibold text-white">Operaciones recibidas</h2>

            @if (Model.Error is null)
            {
                <span class="rounded-full border border-violet-500/20 bg-violet-500/10 px-3 py-1.5 text-xs font-semibold text-violet-300">
                    @Model.Operaciones.Total @(Model.Operaciones.Total == 1 ? "operación" : "operaciones")
                </span>
            }
        </div>

        @if (Model.Error is not null)
        {
            <div class="p-6">
                <div role="alert" class="rounded-xl border border-red-500/25 bg-red-500/10 px-4 py-4 text-sm text-red-300">
                    @Model.Error
                </div>
            </div>
        }
        else if (Model.Operaciones.Items.Count == 0)
        {
            <p class="px-6 py-12 text-center text-sm text-slate-400">
                @(string.IsNullOrWhiteSpace(Model.Resultado)
                    ? "Todavía no llegó nada desde la app de los repartidores."
                    : "No hay operaciones con ese resultado.")
            </p>
        }
        else
        {
            <partial name="_OperacionesSincronizadas" model="(Model.Operaciones.Items, true)" />

            @if (Model.Operaciones.TotalPaginas > 1)
            {
                <nav class="flex items-center justify-between border-t border-white/10 px-5 py-4 text-sm text-slate-400" aria-label="Páginas">
                    <span>Página @Model.Operaciones.Pagina de @Model.Operaciones.TotalPaginas</span>
                    <div class="flex gap-2">
                        @if (Model.Operaciones.Pagina > 1)
                        {
                            <a asp-page="/Sincronizacion/Index" asp-all-route-data="Model.RutaPagina(Model.Operaciones.Pagina - 1)"
                               class="rounded-lg border border-white/10 px-3 py-2 text-slate-300 no-underline hover:bg-white/5">Anterior</a>
                        }
                        @if (Model.Operaciones.Pagina < Model.Operaciones.TotalPaginas)
                        {
                            <a asp-page="/Sincronizacion/Index" asp-all-route-data="Model.RutaPagina(Model.Operaciones.Pagina + 1)"
                               class="rounded-lg border border-white/10 px-3 py-2 text-slate-300 no-underline hover:bg-white/5">Siguiente</a>
                        }
                    </div>
                </nav>
            }
        }
    </section>
</div>
