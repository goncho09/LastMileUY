
@page "{id:int}"
@model DetalleModel

@{
    ViewData["Title"] = Model.Envio is null
        ? "Envío"
        : $"Envío {Model.Envio.CodigoSeguimiento}";

    var envio = Model.Envio;

    var campo = "block w-full rounded-xl border border-line bg-field px-3 py-2 text-sm text-white outline-none transition-colors focus:border-violet-400 focus:ring-2 focus:ring-violet-500/20";
}

<div class="mx-auto max-w-[1600px] space-y-6 motion-safe:animate-lm-form-in">

    <a asp-page="/Envios/Index"
       class="inline-flex items-center gap-2 text-sm font-medium text-slate-400 no-underline transition-colors hover:text-violet-300">
        <span aria-hidden="true">←</span>
        Volver al listado
    </a>

    @if (Model.Aviso is not null)
    {
        <div role="status"
             class="rounded-xl border border-emerald-500/25 bg-emerald-500/10 px-5 py-4 text-sm text-emerald-300">
            @Model.Aviso
        </div>
    }

    @if (Model.ErrorCambio is not null)
    {
        <div role="alert"
             class="rounded-xl border border-red-500/25 bg-red-500/10 px-5 py-4 text-sm text-red-300">
            @Model.ErrorCambio
        </div>
    }

    @if (Model.Error is not null)
    {
        <div role="alert"
             class="rounded-xl border border-red-500/25 bg-red-500/10 px-5 py-4 text-sm text-red-300">
            @Model.Error
        </div>
    }
    else if (envio is null)
    {
        <div class="rounded-xl border border-amber-500/25 bg-amber-500/10 px-5 py-4 text-sm text-amber-300">
            No existe un envío con ese número.
        </div>
    }
    else
    {
<div id="contenido-detalle-envio" data-envio-id="@envio.Id" class="space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-4">

            <div>
                <p class="mb-1.5 text-xs font-medium text-slate-500">
                    Detalle de operación
                </p>

                <div class="flex flex-wrap items-center gap-3">
                    <h1 class="font-mono text-2xl font-semibold tracking-tight text-white sm:text-3xl">
                        @envio.CodigoSeguimiento
                    </h1>

                    @{
                        var estadoActual = envio.Estado;

                        var colorEstado = estadoActual switch
                        {
                            "Entregado" => "border-emerald-500/25 bg-emerald-500/10 text-emerald-300",
                            "EnTransito" or "EnDistribucion" => "border-blue-500/25 bg-blue-500/10 text-blue-300",
                            "Admitido" or "Pendiente" or "Creado" => "border-amber-500/25 bg-amber-500/10 text-amber-300",
                            "NoEntregado" or "Cancelado" => "border-red-500/25 bg-red-500/10 text-red-300",
                            _ => "border-slate-500/25 bg-slate-500/10 text-slate-300"
                        };
                    }

                    <span class="inline-flex items-center rounded-full border px-3 py-1.5 text-xs font-semibold @colorEstado">
                        @EstadosEnvio.Texto(envio.Estado)
                    </span>

                    @if (envio.Modalidad == "Urgente")
                    {
                        <span class="inline-flex items-center rounded-full border border-red-500/25 bg-red-500/10 px-3 py-1.5 text-xs font-semibold text-red-300">
                            Urgente
                        </span>
                    }
                </div>

                @if (Model.TieneEntregaParcial)
                {
                    <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
                        <span class="font-semibold text-emerald-300">
                            Entrega parcial:
                            @Model.BultosEntregados de @Model.TotalBultos bultos entregados
                        </span>

                        <span class="text-slate-400">
                            · @Model.BultosPendientes
                            @(Model.BultosPendientes == 1
                                ? "bulto pendiente"
                                : "bultos pendientes")
                        </span>
                    </div>
                }

            <p class="mt-2 text-sm text-slate-400">
                Información completa y seguimiento del envío.
            </p>
            </div>

            <span class="inline-flex items-center gap-2 rounded-xl border border-white/[0.07] bg-surface px-4 py-2.5 text-xs text-slate-400">
                Creado: @Formato.Fecha(envio.FechaCreacion)
            </span>
        </div>

        <div class="grid gap-5 xl:grid-cols-3">

            <section class="rounded-2xl border border-white/[0.07] bg-surface p-6">
                <div class="mb-6 flex items-center gap-3">
                    <span class="flex h-7 w-7 items-center justify-center rounded-md border border-white/[0.07] text-slate-400 [&_svg]:h-4 [&_svg]:w-4">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor"
                             stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M3 7h18v14H3zM3 7l4-4h10l4 4M3 12h18"/>
                        </svg>
                    </span>
                    <h2 class="text-base font-semibold text-white">Envío</h2>
                </div>

                <dl class="space-y-4 text-sm">
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-400">Comercio</dt>
                        <dd class="text-right font-medium text-slate-200">@envio.Comercio</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-400">Referencia</dt>
                        <dd class="text-right text-slate-200">@(envio.ReferenciaExterna ?? "—")</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-400">Modalidad</dt>
                        <dd class="text-right text-slate-200">@(envio.Modalidad == "Urgente" ? "Urgente" : "Estándar")</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-400">Origen</dt>
                        <dd class="text-right text-slate-200">@CanalesIngreso.Texto(envio.Canal)</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-400">Creado</dt>
                        <dd class="text-right text-slate-200">@Formato.Fecha(envio.FechaCreacion)</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-400">Entregar antes de</dt>
                        <dd class="text-right text-slate-200">@Formato.Fecha(envio.FechaLimiteEntrega)</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-400">Entregado</dt>
                        <dd class="text-right text-slate-200">@Formato.Fecha(envio.FechaEntrega)</dd>
                    </div>
                    <div class="flex justify-between gap-4 border-t border-white/[0.07] pt-4">
                        <dt class="font-medium text-slate-300">Costo</dt>
                        <dd class="text-right font-semibold text-violet-300">@Formato.Pesos(envio.CostoEnvio)</dd>
                    </div>
                </dl>
            </section>

            <section class="rounded-2xl border border-white/[0.07] bg-surface p-6">
                <div class="mb-6 flex items-center gap-3">
                    <span class="flex h-7 w-7 items-center justify-center rounded-md border border-white/[0.07] text-slate-400 [&_svg]:h-4 [&_svg]:w-4">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor"
                             stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="8" r="4"/>
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M4 21a8 8 0 0 1 16 0"/>
                        </svg>
                    </span>
                    <h2 class="text-base font-semibold text-white">Destinatario</h2>
                </div>

                <div class="space-y-5 text-sm">
                    <div>
                        <p class="mb-1 text-xs text-slate-500">Nombre completo</p>
                        <p class="font-semibold text-slate-200">
                            @envio.Destinatario.Nombre @envio.Destinatario.Apellido
                        </p>
                    </div>
                    <div>
                        <p class="mb-1 text-xs text-slate-500">Teléfono</p>
                        <p class="text-slate-300">@(envio.Destinatario.Telefono ?? "—")</p>
                    </div>
                    <div>
                        <p class="mb-1 text-xs text-slate-500">Correo electrónico</p>
                        <p class="break-all text-slate-300">@(envio.Destinatario.Email ?? "—")</p>
                    </div>
                </div>
            </section>

            <section class="rounded-2xl border border-white/[0.07] bg-surface p-6">
                <div class="mb-6 flex items-center gap-3">
                    <span class="flex h-7 w-7 items-center justify-center rounded-md border border-white/[0.07] text-slate-400 [&_svg]:h-4 [&_svg]:w-4">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor"
                             stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0z"/>
                            <circle cx="12" cy="10" r="2.5"/>
                        </svg>
                    </span>
                    <h2 class="text-base font-semibold text-white">Dirección de entrega</h2>
                </div>

                <div class="space-y-5 text-sm">
                    <div>
                        <p class="mb-1 text-xs text-slate-500">Dirección</p>
                        <p class="font-semibold text-slate-200">
                            @envio.Direccion.Calle @envio.Direccion.Numero@(envio.Direccion.Apartamento is null ? "" : ", " + envio.Direccion.Apartamento)
                        </p>
                    </div>
                    <div>
                        <p class="mb-1 text-xs text-slate-500">Ubicación</p>
                        <p class="text-slate-300">
                            @envio.Direccion.Ciudad, @envio.Direccion.Departamento
                        </p>
                        <p class="mt-1 text-xs text-slate-500">
                            CP: @envio.Direccion.CodigoPostal
                        </p>
                    </div>
                    @if (envio.Direccion.Referencia is not null)
                    {
                        <div class="rounded-xl border border-white/[0.07] bg-white/5 p-4">
                            <p class="mb-1 text-xs text-slate-500">Referencia</p>
                            <p class="text-slate-300">@envio.Direccion.Referencia</p>
                        </div>
                    }
                </div>
            </section>
        </div>

        <section class="overflow-hidden rounded-2xl border border-white/[0.07] bg-surface">
            <div class="flex items-center justify-between border-b border-white/[0.07] px-5 py-4">
                <h2 class="text-base font-semibold text-white">Bultos</h2>
                <span class="rounded-full border border-violet-500/20 bg-violet-500/10 px-3 py-1 text-xs font-semibold text-violet-300">
                    @envio.Bultos.Count
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full min-w-[650px] text-left text-sm">
                    <thead class="border-b border-white/[0.07] text-xs font-medium text-slate-500">
                        <tr>
                            <th scope="col" class="px-6 py-4">Código</th>
                            <th scope="col" class="px-6 py-4">Descripción</th>
                            <th scope="col" class="px-6 py-4">Estado</th>
                            <th scope="col" class="px-6 py-4 text-right">Peso (kg)</th>
                            <th scope="col" class="px-6 py-4 text-right">Medidas (cm)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                        @foreach (var bulto in envio.Bultos)
                        {
                            <tr class="transition-colors hover:bg-white/[0.025]">
                                <td class="px-6 py-4 font-mono text-xs font-semibold text-violet-300">
                                    @bulto.Codigo
                                </td>
                                <td class="px-6 py-4 text-slate-300">
                                    @(bulto.Descripcion ?? "—")
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex whitespace-nowrap rounded border px-1.5 py-0.5 text-xs font-medium @ResultadosBultos.ClaseEstado(bulto.Estado)">
                                        @ResultadosBultos.TextoEstado(bulto.Estado)
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right text-slate-300">
                                    @Formato.Numero(bulto.PesoKg)
                                </td>
                                <td class="px-6 py-4 text-right text-slate-300">
                                    @Formato.Numero(bulto.LargoCm) ×
                                    @Formato.Numero(bulto.AnchoCm) ×
                                    @Formato.Numero(bulto.AltoCm)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @if (envio.Intentos.Count > 0)
        {
            <section class="overflow-hidden rounded-2xl border border-white/[0.07] bg-surface" aria-labelledby="titulo-intentos">
                <div class="flex items-center justify-between border-b border-white/[0.07] px-5 py-4">
                    <h2 id="titulo-intentos" class="text-base font-semibold text-white">Intentos de entrega</h2>
                    <span class="rounded-full border border-violet-500/20 bg-violet-500/10 px-3 py-1 text-xs font-semibold text-violet-300">
                        @envio.Intentos.Count
                    </span>
                </div>

                <ol class="divide-y divide-white/5">
                    @foreach (var intento in envio.Intentos)
                    {
                        <li class="space-y-4 px-5 py-4">
                            <div class="flex flex-wrap items-center gap-3">
                                <span class="font-semibold text-white">Intento @intento.NumeroIntento</span>
                                <span class="inline-flex whitespace-nowrap rounded border px-1.5 py-0.5 text-xs font-medium @ResultadosBultos.ClaseIntento(intento.Resultado)">
                                    @ResultadosBultos.TextoIntento(intento.Resultado)
                                </span>
                                <span class="text-xs text-slate-400">@Formato.Fecha(intento.FechaHora)</span>
                            </div>

                            @if (intento.Motivo is not null)
                            {
                                <p class="text-sm text-slate-300">Motivo: @intento.Motivo</p>
                            }

                            @if (intento.Bultos.Count > 0)
                            {
                                <ul class="grid gap-2 text-sm sm:grid-cols-2 xl:grid-cols-3" aria-label="Resultado de cada bulto en el intento @intento.NumeroIntento">
                                    @foreach (var bulto in intento.Bultos)
                                    {
                                        <li class="flex min-w-0 flex-wrap items-center gap-2 rounded-xl border border-white/[0.07] bg-white/[0.03] px-3 py-2">
                                            <span class="font-mono text-xs font-semibold text-violet-300">@bulto.Codigo</span>
                                            <span class="@(bulto.Entregado ? "text-emerald-300" : "text-amber-300")">
                                                @(bulto.Entregado ? "Entregado" : "No entregado")
                                            </span>
                                            @if (bulto.Motivo is not null)
                                            {
                                                <span class="text-xs text-slate-400" style="overflow-wrap:anywhere">· @bulto.Motivo</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-xs text-slate-500">Intento registrado sin el resultado de cada bulto.</p>
                            }

                            @if (intento.Prueba is { } prueba)
                            {
                                <div class="rounded-xl border border-white/[0.07] bg-sidebar p-4 text-sm">
                                    <p class="mb-2 font-medium text-slate-200">Prueba de entrega</p>
                                    <dl class="space-y-1.5 text-slate-300">
                                        @if (prueba.BultosEntregados.Count > 0)
                                        {
                                            <div class="flex flex-wrap gap-x-2">
                                                <dt class="text-slate-400">Respalda</dt>
                                                <dd class="font-mono text-xs" style="overflow-wrap:anywhere">@string.Join(", ", prueba.BultosEntregados)</dd>
                                            </div>
                                        }
                                        @if (prueba.NombreReceptor is not null)
                                        {
                                            <div class="flex flex-wrap gap-x-2">
                                                <dt class="text-slate-400">Recibió</dt>
                                                <dd>@prueba.NombreReceptor</dd>
                                            </div>
                                        }
                                    </dl>
                                    @if (prueba.TieneFirma || prueba.TieneFoto)
                                    {
                                        <div class="mt-3 flex gap-4 text-xs">
                                            @if (prueba.TieneFirma)
                                            {
                                                <a asp-page="/Sincronizacion/Evidencia" asp-route-intentoId="@intento.Id" asp-route-tipo="firma"
                                                   target="_blank" rel="noopener" class="text-violet-300 no-underline hover:text-violet-200">Ver firma</a>
                                            }
                                            @if (prueba.TieneFoto)
                                            {
                                                <a asp-page="/Sincronizacion/Evidencia" asp-route-intentoId="@intento.Id" asp-route-tipo="foto"
                                                   target="_blank" rel="noopener" class="text-violet-300 no-underline hover:text-violet-200">Ver foto</a>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </li>
                    }
                </ol>
            </section>
        }

        <div class="grid gap-5 xl:grid-cols-2">

            <section class="rounded-2xl border border-white/[0.07] bg-surface p-6">
                <div class="mb-5 flex items-center gap-3">
                    <span class="flex h-7 w-7 items-center justify-center rounded-md border border-white/[0.07] text-slate-400 [&_svg]:h-4 [&_svg]:w-4">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor"
                             stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1m0-12.8-2.1 2.1m-8.6 8.6-2.1 2.1"/>
                            <circle cx="12" cy="12" r="4"/>
                        </svg>
                    </span>
                    <h2 class="text-base font-semibold text-white">Regla operativa</h2>
                </div>

                @if (envio.Regla is null)
                {
                    <p class="text-sm leading-relaxed text-slate-400">
                        El operador no tiene una regla para esta modalidad:
                        solo se aplica la tabla de estados.
                    </p>
                }
                else
                {
                    <p class="mb-5 font-semibold text-violet-300">@envio.Regla.Nombre</p>

                    <dl class="space-y-4 text-sm">
                        <div class="flex justify-between gap-4">
                            <dt class="text-slate-400">Intentos de entrega</dt>
                            <dd class="text-right text-slate-200">
                                @envio.IntentosFallidos fallidos de @envio.Regla.MaximoIntentosEntrega permitidos
                            </dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt class="text-slate-400">Entre intentos</dt>
                            <dd class="text-right text-slate-200">@envio.Regla.HorasEntreIntentos horas</dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt class="text-slate-400">Plazo de entrega</dt>
                            <dd class="text-right text-slate-200">@envio.Regla.PlazoEntregaHoras horas</dd>
                        </div>
                        <div class="flex justify-between gap-4 border-t border-white/[0.07] pt-4">
                            <dt class="text-slate-400">Al entregar pide</dt>
                            <dd class="text-right text-slate-200">@Formato.Requisitos(envio.Regla)</dd>
                        </div>
                    </dl>
                }
            </section>

            <section class="rounded-2xl border border-white/[0.07] bg-surface p-6">
                <div class="mb-5 flex items-center gap-3">
                    <span class="flex h-7 w-7 items-center justify-center rounded-md border border-white/[0.07] text-slate-400 [&_svg]:h-4 [&_svg]:w-4">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor"
                             stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M4 7h16M4 12h10M4 17h7m9-4v8m-4-4h8"/>
                        </svg>
                    </span>
                    <h2 class="text-base font-semibold text-white">Cambiar estado</h2>
                </div>

                @if (envio.EstadosSiguientes.Count == 0)
                {
                    <p class="text-sm text-slate-400">
                        El envío está en un estado final: ya no puede cambiar.
                    </p>
                }
                else if (!Permisos.PuedeCambiarEstado(User))
                {
                    <p class="text-sm text-slate-400">
                        Tu perfil (@Permisos.Perfil(User)) puede ver el envío,
                        pero no cambiar su estado.
                    </p>
                }
                else
                {
                    @if (envio.Estado == "NoEntregado" &&
                         !envio.EstadosSiguientes.Contains("Reprogramado"))
                    {
                        <div role="alert"
                             class="mb-5 rounded-xl border border-amber-500/25 bg-amber-500/10 px-4 py-3 text-sm text-amber-300">
                            Se agotaron los intentos de entrega que permite la regla:
                            el envío tiene que pasar a devolución.
                        </div>
                    }

                    <form method="post"
                          asp-page-handler="CambiarEstado"
                          asp-route-id="@envio.Id"
                          class="space-y-4">

                        <div>
                            <label for="nuevoEstado" class="mb-2 block text-sm font-medium text-slate-300">
                                Pasar a
                            </label>
                            <select id="nuevoEstado"
                                    name="nuevoEstado"
                                    class="@campo"
                                    required>
                                <option value="">Elegí un estado</option>
                                @foreach (var estado in envio.EstadosSiguientes)
                                {
                                    <option value="@estado">@EstadosEnvio.Texto(estado)</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label for="comentario" class="mb-2 block text-sm font-medium text-slate-300">
                                Comentario (opcional)
                            </label>
                            <input id="comentario"
                                   name="comentario"
                                   maxlength="1000"
                                   placeholder="Agregá una observación..."
                                   class="@campo" />
                        </div>

                        <button type="submit"
                                class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-violet-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-violet-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-400">
                            Guardar cambio
                        </button>
                    </form>
                }
            </section>
        </div>

        <section class="overflow-hidden rounded-2xl border border-white/[0.07] bg-surface">
            <div class="border-b border-white/[0.07] px-5 py-4">
                <h2 class="text-base font-semibold text-white">Historial</h2>
                <p class="mt-1 text-xs text-slate-400">
                    Registro de eventos y cambios de estado del envío.
                </p>
            </div>

            <ol class="divide-y divide-white/5">
                @foreach (var evento in envio.Eventos.OrderByDescending(e => e.FechaHora))
                {
                    <li class="flex flex-wrap items-start justify-between gap-4 px-5 py-4 transition-colors hover:bg-white/[0.025]">
                        <div class="flex min-w-0 items-start gap-3">
                            <span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-violet-400"></span>
                            <div>
                                <span class="mb-2 inline-flex rounded border border-violet-500/20 bg-violet-500/10 px-1.5 py-0.5 text-xs font-semibold text-violet-300">
                                    @EstadosEnvio.Texto(evento.Tipo)
                                </span>
                                <p class="text-sm text-slate-300">
                                    @evento.Descripcion
                                </p>
                            </div>
                        </div>

                        <span class="shrink-0 text-xs text-slate-500">
                            @Formato.Fecha(evento.FechaHora) · @evento.Origen
                        </span>
                    </li>
                }
            </ol>
        </section>
</div>
    }
</div>


@section Scripts {
    <script>
        (() => {
            const contenido = document.getElementById("contenido-detalle-envio");
            if (!contenido) return;

            const envioId = Number(contenido.dataset.envioId);

            let temporizador = null;
            let actualizando = false;
            let actualizarDeNuevo = false;
            let paginaActiva = true;

            async function actualizarDetalle() {
                if (actualizando) {
                    actualizarDeNuevo = true;
                    return;
                }

                actualizando = true;

                try {
                    do {
                        actualizarDeNuevo = false;

                        const respuesta = await fetch(window.location.href, {
                            credentials: "same-origin",
                            cache: "no-store"
                        });

                        if (!respuesta.ok) {
                            throw new Error(
                                `Error actualizando detalle: HTTP ${respuesta.status}`
                            );
                        }

                        const html = await respuesta.text();
                        const documento = new DOMParser().parseFromString(
                            html,
                            "text/html"
                        );

                        const nuevoContenido = documento.getElementById(
                            "contenido-detalle-envio"
                        );

                        if (!nuevoContenido) {
                            throw new Error(
                                "No se encontró el contenido actualizado del envío"
                            );
                        }

                        if (!paginaActiva) return;

                        const formulario = contenido.querySelector(
                            'form[method="post"]'
                        );

                        const editando = formulario &&
                            (formulario.contains(document.activeElement) ||
                             formulario.querySelector("#nuevoEstado")?.value ||
                             formulario.querySelector("#comentario")?.value);

                        if (editando) {
                            actualizarDeNuevo = false;
                            return;
                        }

                        contenido.innerHTML = nuevoContenido.innerHTML;

                    } while (actualizarDeNuevo && paginaActiva);
                } catch (error) {
                    console.error("Error actualizando detalle:", error);
                } finally {
                    actualizando = false;
                }
            }

            function programarActualizacion() {
                clearTimeout(temporizador);

                temporizador = setTimeout(() => {
                    void actualizarDetalle();
                }, 500);
            }

            window.addEventListener("lastmileuy:envio-actualizado", evento => {
                const actualizadoId = Number(
                    evento.detail.envioId ?? evento.detail.EnvioId
                );

                if (actualizadoId === envioId) {
                    programarActualizacion();
                }
            });

            window.addEventListener(
                "lastmileuy:signalr-sincronizar",
                programarActualizacion
            );

            window.addEventListener("pagehide", () => {
                paginaActiva = false;
                clearTimeout(temporizador);
            });
        })();
    </script>
}

