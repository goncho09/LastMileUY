
@page
@model IndexModel

@{
    ViewData["Title"] = "Gestión de usuarios";
}

<div class="mx-auto max-w-7xl space-y-8 p-6">

    <div>
        <h1 class="text-2xl font-semibold text-white">
            Gestión de usuarios
        </h1>
        <p class="mt-2 text-slate-400">
            Administrá el personal de tu operador.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Aviso))
    {
        <div class="rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-emerald-300"
             role="status">
            @Model.Aviso
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorOperacion))
    {
        <div class="rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-red-300"
             role="alert">
            @Model.ErrorOperacion
        </div>
    }

    <section class="rounded-2xl border border-white/[0.07] bg-surface-2 p-6">
        <h2 class="mb-5 text-xl font-semibold">
            Crear usuario
        </h2>

        <form method="post" asp-page-handler="Crear"
              class="grid gap-4 md:grid-cols-2">

            <div>
                <label asp-for="Nuevo.Nombre"
                       class="mb-2 block text-sm text-slate-300">
                    Nombre
                </label>
                <input asp-for="Nuevo.Nombre" required maxlength="100"
                       class="w-full rounded-lg border border-white/[0.07] bg-canvas p-3 text-white" />
            </div>

            <div>
                <label asp-for="Nuevo.Apellido"
                       class="mb-2 block text-sm text-slate-300">
                    Apellido
                </label>
                <input asp-for="Nuevo.Apellido" required maxlength="100"
                       class="w-full rounded-lg border border-white/[0.07] bg-canvas p-3 text-white" />
            </div>

            <div>
                <label asp-for="Nuevo.Email"
                       class="mb-2 block text-sm text-slate-300">
                    Correo electrónico
                </label>
                <input asp-for="Nuevo.Email" type="email" required
                       autocomplete="off"
                       class="w-full rounded-lg border border-white/[0.07] bg-canvas p-3 text-white" />
            </div>

            <div>
                <label asp-for="Nuevo.Password"
                       class="mb-2 block text-sm text-slate-300">
                    Contraseña inicial
                </label>
                <input asp-for="Nuevo.Password" type="password" required
                       autocomplete="new-password"
                       class="w-full rounded-lg border border-white/[0.07] bg-canvas p-3 text-white" />

<p class="mt-2 text-xs text-slate-400">
    Mínimo 8 caracteres, una mayúscula, una minúscula y un número.
</p>
            </div>

            <div>
                <label asp-for="Nuevo.Rol"
                       class="mb-2 block text-sm text-slate-300">
                    Rol
                </label>
                <select asp-for="Nuevo.Rol"
                        class="w-full rounded-lg border border-white/[0.07] bg-canvas p-3 text-white">
                    <option value="Despachador">Despachador</option>
                    <option value="OperarioDeposito">Operario de depósito</option>
                    <option value="Repartidor">Repartidor</option>
                </select>
            </div>

            <div class="flex items-end">
                <button type="submit"
                        class="w-full cursor-pointer rounded-lg bg-violet-600 px-6 py-3 font-semibold text-white hover:bg-violet-500">
                    Crear usuario
                </button>
            </div>
        </form>
    </section>

    
    <section class="overflow-hidden rounded-2xl border border-white/[0.07] bg-surface-2">
        <div class="space-y-5 p-6">
            <div>
                <h2 class="text-xl font-semibold">Personal registrado</h2>
                <p class="mt-1 text-sm text-slate-400">
                    Consultá y administrá los usuarios de tu operador.
                </p>
            </div>

            @if (Model.ErrorCarga is null)
            {
                var activos = Model.Usuarios.Count(u => u.Activo);
                var inactivos = Model.Usuarios.Count - activos;

                <div class="grid grid-cols-3 gap-3">
                    <div class="rounded-xl border border-white/[0.07] bg-white/5 p-4">
                        <p class="text-sm text-slate-400">Total</p>
                        <p class="text-2xl font-semibold">@Model.Usuarios.Count</p>
                    </div>
                    <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4">
                        <p class="text-sm text-slate-400">Activos</p>
                        <p class="text-2xl font-semibold text-emerald-400">@activos</p>
                    </div>
                    <div class="rounded-xl border border-red-500/20 bg-red-500/5 p-4">
                        <p class="text-sm text-slate-400">Inactivos</p>
                        <p class="text-2xl font-semibold text-red-400">@inactivos</p>
                    </div>
                </div>

                <div class="grid gap-3 md:grid-cols-3">
                    <input id="buscarUsuarios" type="search"
                           placeholder="Buscar nombre o correo..."
                           aria-label="Buscar usuarios"
                           class="w-full rounded-lg border border-white/[0.07] bg-canvas p-3 text-white" />

                    <select id="filtrarRol" aria-label="Filtrar por rol"
                            class="w-full rounded-lg border border-white/[0.07] bg-canvas p-3 text-white">
                        <option value="">Todos los roles</option>
                        <option value="Despachador">Despachador</option>
                        <option value="OperarioDeposito">Operario de depósito</option>
                        <option value="Repartidor">Repartidor</option>
                    </select>

                    <select id="filtrarEstado" aria-label="Filtrar por estado"
                            class="w-full rounded-lg border border-white/[0.07] bg-canvas p-3 text-white">
                        <option value="">Todos los estados</option>
                        <option value="activo">Activos</option>
                        <option value="inactivo">Inactivos</option>
                    </select>
                </div>

                <p id="resultadoUsuarios" class="text-sm text-slate-400"
                   aria-live="polite"></p>
            }
        </div>

        @if (Model.ErrorCarga is not null)
        {
            <p class="px-6 pb-6 text-red-300" role="alert">
                @Model.ErrorCarga
            </p>
        }
        else if (Model.Usuarios.Count == 0)
        {
            <p class="px-6 pb-6 text-slate-400">
                Todavía no hay personal registrado.
            </p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-center text-sm">
                    <thead class="bg-white/5 text-slate-400">
                    <tr>
                        <th class="p-4">Nombre</th>
                        <th class="p-4">Correo</th>
                        <th class="p-4">Rol</th>
                        <th class="p-4">Estado</th>
                        <th class="p-4 text-right">Acción</th>
                    </tr>
                    </thead>
                    <tbody id="tablaUsuarios">
                    @foreach (var usuario in Model.Usuarios)
                    {
                        <tr class="fila-usuario border-t border-white/[0.07]"
                            data-busqueda="@($"{usuario.Nombre} {usuario.Apellido} {usuario.Email}".ToLowerInvariant())"
                            data-rol="@usuario.Rol"
                            data-estado="@(usuario.Activo ? "activo" : "inactivo")">

                            <td class="p-4 font-medium">
                                @usuario.Nombre @usuario.Apellido
                            </td>
                            <td class="p-4 text-slate-300">@usuario.Email</td>
                            <td class="p-4">
                                @(usuario.Rol == "OperarioDeposito"
                                    ? "Operario de depósito"
                                    : usuario.Rol)
                            </td>
                            <td class="p-4">
                                @if (usuario.Activo)
                                {
                                    <span class="text-emerald-400">Activo</span>
                                }
                                else
                                {
                                    <span class="text-red-400">Inactivo</span>
                                }
                            </td>
                            <td class="p-4 text-right">
                                <form method="post"
                                      asp-page-handler="CambiarEstado"
                                      class="form-estado-usuario"
                                      data-nombre="@($"{usuario.Nombre} {usuario.Apellido}")"
                                      data-desactivar="@(usuario.Activo ? "true" : "false")">
                                    <input type="hidden" name="usuarioId"
                                           value="@usuario.Id" />
                                    <input type="hidden" name="activo"
                                           value="@(usuario.Activo ? "false" : "true")" />

                                    <button type="submit"
                                            class="rounded-lg border border-white/15 px-4 py-2 hover:bg-white/10">
                                        @(usuario.Activo ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <p id="sinResultados"
               class="hidden p-6 text-center text-slate-400">
                No se encontraron usuarios con esos filtros.
            </p>
        }
    </section>


<div id="modalDesactivar"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="tituloModalDesactivar">

    <div class="w-full max-w-md rounded-2xl border border-white/[0.07] bg-surface-2 p-6">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-red-500/10 text-red-400">
            <svg class="h-6 w-6" fill="none" stroke="currentColor"
                 stroke-width="1.8" viewBox="0 0 24 24"
                 aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 9v4m0 4h.01M10.3 3.9 2.2 18a2 2 0 0 0 1.7 3h16.2a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>
            </svg>
        </div>

        <h2 id="tituloModalDesactivar"
            class="text-xl font-semibold text-white">
            ¿Desactivar usuario?
        </h2>

        <p class="mt-3 text-sm leading-relaxed text-slate-400">
            Vas a desactivar a
            <strong id="nombreUsuarioDesactivar" class="text-white"></strong>.
            El usuario dejará de poder iniciar sesión y podrás reactivarlo cuando quieras.
        </p>

        <div class="mt-7 flex justify-end gap-3">
            <button type="button" id="cancelarDesactivacion"
                    class="cursor-pointer rounded-lg border border-white/15 px-5 py-2.5 text-slate-200 hover:bg-white/10">
                Cancelar
            </button>

            <button type="button" id="confirmarDesactivacion"
                    class="cursor-pointer rounded-lg bg-red-600 px-5 py-2.5 font-semibold text-white hover:bg-red-500">
                Sí, desactivar
            </button>
        </div>
    </div>
</div>

</div>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const buscar = document.getElementById("buscarUsuarios");
            const rol = document.getElementById("filtrarRol");
            const estado = document.getElementById("filtrarEstado");
            const filas = [...document.querySelectorAll(".fila-usuario")];
            const resultado = document.getElementById("resultadoUsuarios");
            const sinResultados = document.getElementById("sinResultados");

            function normalizar(texto) {
                return (texto || "")
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .toLocaleLowerCase();
            }

            function aplicarFiltros() {
                const texto = normalizar(buscar?.value.trim());
                const rolSeleccionado = rol?.value || "";
                const estadoSeleccionado = estado?.value || "";
                let visibles = 0;

                filas.forEach(fila => {
                    const coincideBusqueda =
                        normalizar(fila.dataset.busqueda).includes(texto);

                    const roles = (fila.dataset.rol || "")
                        .split(",")
                        .map(r => r.trim());

                    const coincideRol =
                        !rolSeleccionado || roles.includes(rolSeleccionado);

                    const coincideEstado =
                        !estadoSeleccionado ||
                        fila.dataset.estado === estadoSeleccionado;

                    const visible =
                        coincideBusqueda && coincideRol && coincideEstado;

                    fila.hidden = !visible;
                    fila.style.display = visible ? "" : "none";

                    if (visible) visibles++;
                });

                if (resultado) {
                    resultado.textContent =
                        `Mostrando ${visibles} de ${filas.length} usuarios`;
                }

                if (sinResultados) {
                    sinResultados.classList.toggle("hidden", visibles !== 0);
                }
            }

            buscar?.addEventListener("input", aplicarFiltros);
            rol?.addEventListener("change", aplicarFiltros);
            estado?.addEventListener("change", aplicarFiltros);

            aplicarFiltros();


            const modal = document.getElementById("modalDesactivar");
            const nombreUsuario = document.getElementById("nombreUsuarioDesactivar");
            const cancelar = document.getElementById("cancelarDesactivacion");
            const confirmar = document.getElementById("confirmarDesactivacion");

            let formularioPendiente = null;
            let botonAnterior = null;

            function cerrarModal() {
                modal.classList.add("hidden");
                modal.classList.remove("flex");
                formularioPendiente = null;
                botonAnterior?.focus();
            }

            let desactivacionConfirmada = false;

            document.querySelectorAll(".form-estado-usuario")
                .forEach(formulario => {
                    formulario.addEventListener("submit", evento => {
                        if (formulario.dataset.desactivar !== "true" || desactivacionConfirmada)
                            return;

                        evento.preventDefault();

                        formularioPendiente = formulario;
                        botonAnterior = formulario.querySelector("button[type='submit']");

                        nombreUsuario.textContent = formulario.dataset.nombre;

                        modal.classList.remove("hidden");
                        modal.classList.add("flex");
                        cancelar.focus();
                    });
                });

            cancelar.addEventListener("click", cerrarModal);

            confirmar.addEventListener("click", () => {
                if (!formularioPendiente) return;

                const formulario = formularioPendiente;
                formularioPendiente = null;

                confirmar.disabled = true;
                confirmar.textContent = "Desactivando...";

                desactivacionConfirmada = true;
                formulario.requestSubmit();
            });

            modal.addEventListener("click", evento => {
                if (evento.target === modal)
                    cerrarModal();
            });

            document.addEventListener("keydown", evento => {
                if (modal.classList.contains("hidden")) return;

                if (evento.key === "Escape") {
                    cerrarModal();
                }

                if (evento.key === "Tab") {
                    const botones = [cancelar, confirmar];
                    const primero = botones[0];
                    const ultimo = botones[1];

                    if (evento.shiftKey && document.activeElement === primero) {
                        evento.preventDefault();
                        ultimo.focus();
                    } else if (!evento.shiftKey && document.activeElement === ultimo) {
                        evento.preventDefault();
                        primero.focus();
                    }
                }
});

        });
    </script>
}

