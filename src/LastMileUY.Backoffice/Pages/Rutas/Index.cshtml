@page
@model LastMileUY.Backoffice.Pages.Rutas.IndexModel

@{
    ViewData["Title"] = "Hojas de ruta";
    var claseCampo = "block w-full rounded-xl border border-[#343747] bg-[#10121a] px-4 py-3 text-sm text-white outline-none transition-colors focus:border-violet-500 focus:ring-2 focus:ring-violet-500/15 [color-scheme:dark]";
}

<div class="mx-auto max-w-[1600px] space-y-7 motion-safe:animate-lm-form-in">

    <!-- Encabezado -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="mb-2 text-sm font-medium text-violet-400">
                Planificación
            </p>
            <h1 class="text-3xl font-bold tracking-tight text-white">
                Hojas de ruta
            </h1>
            <p class="mt-2 text-sm text-slate-400">
                Armá los recorridos de los repartidores y despachalos cuando salgan.
            </p>
        </div>

        @if (Permisos.PuedePlanificarRutas(User))
        {
            <a asp-page="/Rutas/Nueva"
               class="inline-flex w-fit items-center gap-2 rounded-xl bg-violet-600 px-4 py-3 text-sm font-semibold text-white no-underline transition-colors hover:bg-violet-500">
                <span aria-hidden="true">+</span>
                Nueva hoja de ruta
            </a>
        }
    </div>

    <!-- Filtros -->
    <section class="rounded-2xl border border-white/10 bg-[#171923] p-5 sm:p-6">
        <form method="get" class="grid items-end gap-4 md:grid-cols-2 xl:grid-cols-12">

            <div class="xl:col-span-4">
                <label for="fecha" class="mb-2 block text-sm font-medium text-slate-300">
                    Fecha
                </label>
                <input id="fecha" name="fecha" type="date"
                       value="@Model.Fecha?.ToString("yyyy-MM-dd")"
                       class="@claseCampo" />
            </div>

            <div class="xl:col-span-4">
                <label for="estado" class="mb-2 block text-sm font-medium text-slate-300">
                    Estado
                </label>
                <select id="estado" name="estado" class="@claseCampo">
                    <option value="">Todos los estados</option>
                    @foreach (var estado in EstadosRuta.Todos)
                    {
                        <option value="@estado.Valor" selected="@(estado.Valor == Model.Estado)">
                            @estado.Texto
                        </option>
                    }
                </select>
            </div>

            <div class="flex gap-2 md:col-span-2 xl:col-span-4">
                <button type="submit"
                        class="flex-1 rounded-xl bg-violet-600 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-violet-500">
                    Filtrar
                </button>

                <a asp-page="/Rutas/Index"
                   class="inline-flex items-center justify-center rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-medium text-slate-300 no-underline transition-colors hover:bg-white/10 hover:text-white">
                    Limpiar
                </a>
            </div>
        </form>
    </section>

    <!-- Resultados -->
    <section id="resultados-rutas"
         class="overflow-hidden rounded-2xl border border-white/10 bg-[#171923]">

        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 px-5 py-5 sm:px-6">
            <h2 class="text-base font-semibold text-white">Listado de hojas de ruta</h2>

            @if (Model.Error is null)
            {
                <span class="rounded-full border border-violet-500/20 bg-violet-500/10 px-3 py-1.5 text-xs font-semibold text-violet-300">
                    @Model.Resultado.Total @(Model.Resultado.Total == 1 ? "ruta" : "rutas")
                </span>
            }
        </div>

        @if (Model.Error is not null)
        {
            <div class="p-6">
                <div role="alert"
                     class="rounded-xl border border-red-500/25 bg-red-500/10 px-4 py-4 text-sm text-red-300">
                    @Model.Error
                </div>
            </div>
        }
        else if (Model.Resultado.Items.Count == 0)
        {
            <div class="flex min-h-48 flex-col items-center justify-center px-6 py-12 text-center">
                <h3 class="text-base font-semibold text-white">Sin resultados</h3>
                <p class="mt-2 max-w-sm text-sm text-slate-400">
                    @(Model.Fecha is null && string.IsNullOrWhiteSpace(Model.Estado)
                        ? "Todavía no hay hojas de ruta."
                        : "No hay hojas de ruta que coincidan con los filtros seleccionados.")
                </p>
            </div>
        }
        else
        {
            <div class="w-full overflow-x-auto">
                <table class="w-full min-w-[900px] border-collapse text-left text-sm">
                    <thead class="bg-[#11131b] text-xs font-semibold uppercase tracking-wider text-slate-400">
                        <tr>
                            <th scope="col" class="px-5 py-4">Ruta</th>
                            <th scope="col" class="px-4 py-4">Fecha</th>
                            <th scope="col" class="px-4 py-4">Repartidor</th>
                            <th scope="col" class="px-4 py-4">Vehículo</th>
                            <th scope="col" class="px-4 py-4 text-center">Paradas</th>
                            <th scope="col" class="px-4 py-4">Estado</th>
                            <th scope="col" class="px-5 py-4 text-right">Acción</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-white/5">
                        @foreach (var ruta in Model.Resultado.Items)
                        {
                            <tr class="transition-colors hover:bg-white/[0.035]">
                                <td class="px-5 py-4 font-medium text-slate-200">@ruta.Nombre</td>
                                <td class="whitespace-nowrap px-4 py-4 text-slate-300">@Formato.Fecha(ruta.Fecha)</td>
                                <td class="px-4 py-4 text-slate-300">@ruta.Repartidor</td>
                                <td class="whitespace-nowrap px-4 py-4 font-mono text-xs text-slate-300">@ruta.Vehiculo</td>
                                <td class="px-4 py-4 text-center text-slate-300">@ruta.CantidadParadas</td>
                                <td class="px-4 py-4">
                                    <span class="inline-flex items-center whitespace-nowrap rounded-full border px-2.5 py-1 text-xs font-medium @EstadosRuta.ClaseCss(ruta.Estado)">
                                        @EstadosRuta.Texto(ruta.Estado)
                                    </span>
                                </td>
                                <td class="px-5 py-4 text-right">
                                    <a asp-page="/Rutas/Detalle"
                                       asp-route-id="@ruta.Id"
                                       class="inline-flex items-center justify-center rounded-lg border border-violet-500/25 bg-violet-500/10 px-3 py-2 text-xs font-semibold text-violet-300 no-underline transition-colors hover:bg-violet-500/20 hover:text-violet-200">
                                        Ver detalle
                                        <span class="ml-1.5" aria-hidden="true">→</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Resultado.TotalPaginas > 1)
            {
                <nav class="flex items-center justify-between border-t border-white/10 px-5 py-4 text-sm text-slate-400"
                     aria-label="Páginas">
                    <span>Página @Model.Resultado.Pagina de @Model.Resultado.TotalPaginas</span>

                    <div class="flex gap-2">
                        @if (Model.Resultado.Pagina > 1)
                        {
                            <a asp-page="/Rutas/Index" asp-all-route-data="Model.RutaPagina(Model.Resultado.Pagina - 1)"
                               class="rounded-lg border border-white/10 px-3 py-2 text-slate-300 no-underline hover:bg-white/5">
                                Anterior
                            </a>
                        }
                        @if (Model.Resultado.Pagina < Model.Resultado.TotalPaginas)
                        {
                            <a asp-page="/Rutas/Index" asp-all-route-data="Model.RutaPagina(Model.Resultado.Pagina + 1)"
                               class="rounded-lg border border-white/10 px-3 py-2 text-slate-300 no-underline hover:bg-white/5">
                                Siguiente
                            </a>
                        }
                    </div>
                </nav>
            }
        }
    </section>
</div>


@section Scripts {
    <script>
        (() => {
            const seccion = document.getElementById("resultados-rutas");
            if (!seccion) return;

            let temporizador = null;
            let actualizando = false;
            let actualizarDeNuevo = false;
            let paginaActiva = true;

            async function actualizarListado() {
                if (actualizando) {
                    actualizarDeNuevo = true;
                    return;
                }

                actualizando = true;

                try {
                    do {
                        actualizarDeNuevo = false;

                        const respuesta = await fetch(window.location.href, {
                            credentials: "same-origin",
                            cache: "no-store"
                        });

                        if (!respuesta.ok) {
                            throw new Error(
                                `Error actualizando rutas: HTTP ${respuesta.status}`
                            );
                        }

                        const html = await respuesta.text();
                        const documento = new DOMParser().parseFromString(
                            html,
                            "text/html"
                        );

                        const nuevosResultados = documento.getElementById(
                            "resultados-rutas"
                        );

                        if (!nuevosResultados) {
                            throw new Error(
                                "No se encontró el listado actualizado de rutas"
                            );
                        }

                        if (!paginaActiva) return;

                        seccion.innerHTML = nuevosResultados.innerHTML;

                    } while (actualizarDeNuevo && paginaActiva);

                } catch (error) {
                    console.error("Error actualizando rutas:", error);
                } finally {
                    actualizando = false;
                }
            }

            function programarActualizacion() {
                clearTimeout(temporizador);

                temporizador = setTimeout(() => {
                    void actualizarListado();
                }, 500);
            }

            window.addEventListener(
                "lastmileuy:envio-actualizado",
                programarActualizacion
            );

            window.addEventListener(
                "lastmileuy:signalr-sincronizar",
                programarActualizacion
            );

            window.addEventListener("pagehide", () => {
                paginaActiva = false;
                clearTimeout(temporizador);
            });
        })();
    </script>
}
