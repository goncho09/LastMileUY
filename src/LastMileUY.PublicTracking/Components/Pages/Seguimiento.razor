@page "/seguimiento/{Codigo}"
@using System.Text.RegularExpressions
@using LastMileUY.Contracts.Seguimiento
@using LastMileUY.PublicTracking.Servicios
@inject SeguimientoApi Api

<PageTitle>Envío @Codigo | LastMileUY</PageTitle>

@if (error is not null)
{
    <section class="tarjeta">
        <h1>No pudimos consultar el envío</h1>
        <p class="suave">@error</p>
        <BuscadorCodigo Codigo="@Codigo"/>
    </section>
}
else if (envio is null)
{
    <section class="tarjeta">
        <h1>No encontramos ese código</h1>
        <p class="suave">
            Revisá que esté bien escrito (son letras y números, sin espacios). Si lo copiaste de un mensaje
            del comercio, probá pegarlo de nuevo.
        </p>
        <BuscadorCodigo Codigo="@Codigo"/>
    </section>
}
else
{
    <article class="envio" style="@EstiloOperador">
        <header class="envio-operador">
            @if (LogoValido)
            {
                <img src="@envio.Operador.LogoUrl" alt="" class="logo"/>
            }
            <div>
                <p class="suave">Lo entrega</p>
                <p class="nombre-operador">@envio.Operador.Nombre</p>
            </div>
        </header>

        <section class="tarjeta estado estado-@EstadosEnvio.Tono(envio.Estado)" aria-labelledby="titulo-estado">
            <p class="codigo">Envío @envio.CodigoSeguimiento</p>
            <h1 id="titulo-estado">@EstadosEnvio.Titulo(envio.Estado)</h1>
            <p>@EstadosEnvio.Detalle(envio.Estado)</p>

            @if (EstadosEnvio.Paso(envio.Estado) is { } paso)
            {
                <ol class="pasos" aria-label="Avance del envío">
                    @for (var i = 0; i < EstadosEnvio.Pasos.Length; i++)
                    {
                        <li class="@(i <= paso ? "hecho" : "")" aria-current="@(i == paso ? "step" : null)">
                            @EstadosEnvio.Pasos[i]
                        </li>
                    }
                </ol>
            }

            @if (envio.Bultos is { Total: > 1 } bultos)
            {
                <div class="bultos">
                    <p>
                        <strong>@bultos.Entregados de @bultos.Total</strong>
                        @(bultos.Total == 1 ? "bulto entregado" : "bultos entregados")
                    </p>
                    <progress value="@bultos.Entregados" max="@bultos.Total"
                              aria-label="@($"{bultos.Entregados} de {bultos.Total} bultos entregados")"></progress>
                    @if (bultos.Devueltos > 0)
                    {
                        <p class="bultos-nota">
                            @bultos.Devueltos @(bultos.Devueltos == 1 ? "volvió" : "volvieron") al comercio.
                        </p>
                    }
                </div>
            }

            <dl class="datos">
                <div>
                    <dt>Destino</dt>
                    <dd>@envio.Ciudad, @envio.Departamento</dd>
                </div>
                <div>
                    <dt>@(envio.FechaEntrega is null ? "Despachado" : "Entregado")</dt>
                    <dd>@EstadosEnvio.Hora(envio.FechaEntrega ?? envio.FechaCreacion)</dd>
                </div>
            </dl>
        </section>

        @if (envio.Reprogramacion is { } reprogramacion
             && (reprogramacion.Permitida || reprogramacion.FechaSolicitada is not null || avisoReprogramacion is not null))
        {
            <section class="tarjeta reprogramar" aria-labelledby="titulo-reprogramar">
                <h2 id="titulo-reprogramar">¿No vas a estar?</h2>

                @if (avisoReprogramacion is not null)
                {
                    <p class="aviso aviso-ok" role="status">@avisoReprogramacion</p>
                }

                @if (errorReprogramacion is not null)
                {
                    <p class="aviso aviso-error" role="alert">@errorReprogramacion</p>
                }

                @if (reprogramacion.FechaSolicitada is { } fecha)
                {
                    <p>
                        Pediste la entrega para el <strong>@fecha.ToString("dd/MM/yyyy")</strong>@(reprogramacion.FranjaSolicitada is { } franja ? $", en la franja {franja}" : "").
                    </p>
                }

                @if (reprogramacion.Permitida)
                {
                    <p class="suave">
                        Elegí otro día para la entrega, entre el @reprogramacion.FechaMinima.ToString("dd/MM") y el @reprogramacion.FechaMaxima.ToString("dd/MM").
                    </p>
                    <form method="post" @formname="reprogramar" @onsubmit="ReprogramarAsync" class="reprogramar-form">
                        <AntiforgeryToken/>
                        <label for="fecha-reprogramacion">Nueva fecha</label>
                        <input id="fecha-reprogramacion" type="date" name="Pedido.Fecha" required
                               min="@reprogramacion.FechaMinima.ToString("yyyy-MM-dd")"
                               max="@reprogramacion.FechaMaxima.ToString("yyyy-MM-dd")"/>

                        @if (reprogramacion.Franjas.Count > 0)
                        {
                            <label for="franja-reprogramacion">Franja horaria</label>
                            <select id="franja-reprogramacion" name="Pedido.Franja">
                                <option value="">Cualquier horario</option>
                                @foreach (var franja in reprogramacion.Franjas)
                                {
                                    <option value="@franja.Nombre">@franja.Nombre (@franja.HoraInicio.ToString("HH:mm") a @franja.HoraFin.ToString("HH:mm"))</option>
                                }
                            </select>
                        }

                        <label for="comentario-reprogramacion">Comentario para el repartidor (opcional)</label>
                        <textarea id="comentario-reprogramacion" name="Pedido.Comentario" maxlength="300" rows="2"></textarea>

                        <button type="submit">Pedir la nueva fecha</button>
                    </form>
                }
            </section>
        }

        <section class="tarjeta" aria-labelledby="titulo-historial">
            <h2 id="titulo-historial">Historial</h2>
            <ol class="historial">
                @foreach (var evento in envio.Eventos.Reverse())
                {
                    <li>
                        <span class="historial-estado">@EstadosEnvio.Titulo(evento.Estado)</span>
                        <time>@EstadosEnvio.Hora(evento.FechaHora)</time>
                    </li>
                }
            </ol>
        </section>

        <section class="tarjeta">
            <h2>Buscar otro envío</h2>
            <BuscadorCodigo/>
        </section>
    </article>
}

@code {
    [Parameter] public string Codigo { get; set; } = string.Empty;

    [SupplyParameterFromForm(FormName = "reprogramar")]
    public FormularioReprogramacion? Pedido { get; set; }

    private SeguimientoPublicoDto? envio;
    private string? error;
    private string? avisoReprogramacion;
    private string? errorReprogramacion;

    public sealed class FormularioReprogramacion
    {
        public DateOnly? Fecha { get; set; }

        public string? Franja { get; set; }

        public string? Comentario { get; set; }
    }

    private async Task ReprogramarAsync()
    {
        if (Pedido?.Fecha is not { } fecha)
        {
            errorReprogramacion = "Elegí la nueva fecha.";
            return;
        }

        try
        {
            errorReprogramacion = await Api.SolicitarReprogramacionAsync(Codigo,
                new SolicitarReprogramacionRequest(fecha, Pedido.Franja, Pedido.Comentario));

            if (errorReprogramacion is null)
            {
                avisoReprogramacion = $"Listo: pedimos la entrega para el {fecha:dd/MM/yyyy}.";
                envio = await Api.ObtenerAsync(Codigo);
            }
        }
        catch (ConsultasExcedidasException)
        {
            errorReprogramacion = "Se hicieron muchas consultas seguidas. Probá de nuevo en un minuto.";
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            errorReprogramacion = "No pudimos registrar el pedido. Probá de nuevo más tarde.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            envio = await Api.ObtenerAsync(Codigo);
        }
        catch (ConsultasExcedidasException)
        {
            error = "Se hicieron muchas consultas seguidas. Probá de nuevo en un minuto.";
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            error = "El servicio de seguimiento no responde en este momento. Probá de nuevo más tarde.";
        }
    }

    private string? EstiloOperador =>
        envio?.Operador.ColorPrimario is { } color && Regex.IsMatch(color, "^#[0-9A-Fa-f]{6}$")
            ? $"--color-operador: {color}"
            : null;

    private bool LogoValido =>
        Uri.TryCreate(envio?.Operador.LogoUrl, UriKind.Absolute, out var url)
        && (url.Scheme == Uri.UriSchemeHttps || url.Scheme == Uri.UriSchemeHttp);
}
