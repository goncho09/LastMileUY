@page "/"
@inject NavigationManager Navigation

<PageTitle>Seguimiento de envíos | LastMileUY</PageTitle>

<section class="tarjeta portada">
    <h1>¿Dónde está mi envío?</h1>
    <p class="suave">
        Ingresá el código de seguimiento que te mandó el comercio donde compraste.
    </p>

    <BuscadorCodigo/>
</section>

@code {
    [SupplyParameterFromQuery] public string? Codigo { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Codigo))
            Navigation.NavigateTo($"seguimiento/{Uri.EscapeDataString(Codigo.Trim().ToUpperInvariant())}");
    }
}
