<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all"/>
        <ProjectReference Include="..\LastMileUY.Contracts\LastMileUY.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
        <ServiceWorker Include="wwwroot/service-worker.js"
                       PublishedContent="wwwroot/service-worker.published.js" />
    </ItemGroup>

    <Target Name="UsarServiceWorkerProduccion"
            AfterTargets="Publish">
        <Copy SourceFiles="$(MSBuildProjectDirectory)/wwwroot/service-worker.published.js"
              DestinationFiles="$(PublishDir)wwwroot/service-worker.js"
              OverwriteReadOnlyFiles="true" />
    </Target>

</Project>
