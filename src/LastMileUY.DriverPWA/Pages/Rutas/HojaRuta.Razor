```

@page "/rutas/{Id:int}"
@using LastMileUY.Contracts.Rutas
@using LastMileUY.Contracts.Sincronizacion
@using LastMileUY.DriverPWA.Services
@inject RutasService RutasService
@inject NavigationManager Navigation
@inject SincronizacionService Sincronizacion
@inject OperacionesConfirmadasService Confirmadas

<PageTitle>Hoja de ruta</PageTitle>

<div class="container py-4 pb-5">
    <button class="btn btn-link text-decoration-none px-0 mb-3"
            style="color:#6d28d9"
            @onclick="Volver">
        ← Mis rutas
    </button>

    @if (cargando)
    {
        <p>Cargando hoja de ruta...</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger" role="alert">
                @error
            </div>
        }

        @if (!string.IsNullOrEmpty(aviso))
        {
            <div class="alert @(avisoEsConflicto ? "alert-warning" : "alert-success")"
                 role="status">
                @aviso
            </div>
        }

        @if (ruta is not null)
        {
            <div class="rounded-4 p-4 mb-4 text-white"
                 style="background:#6d28d9">
                <div class="small opacity-75">HOJA DE RUTA</div>
                <h2 class="fw-bold mt-2 mb-1">@ruta.Nombre</h2>
                <div>@ruta.Fecha.ToString("dd/MM/yyyy")</div>

                <span class="badge bg-white text-dark mt-3">
                    @ruta.Estado
                </span>
            </div>

            @if (ruta.Estado == "Finalizada")
            {
                <div class="rounded-4 p-3 mb-4"
                     style="background:#f5f3ff;border:1px solid #ddd6fe;color:#5b21b6">
                    <div class="fw-bold">Ruta finalizada</div>
                    <div class="small mt-1">
                        Todas las paradas fueron procesadas.
                    </div>
                </div>
            }

            <div class="row g-3 mb-4">
                <div class="col-6">
                    <div class="bg-white rounded-4 border p-3 h-100">
                        <div class="text-muted small">Paradas</div>
                        <div class="fs-3 fw-bold">
                            @ruta.Paradas.Count
                        </div>
                    </div>
                </div>

                <div class="col-6">
                    <div class="bg-white rounded-4 border p-3 h-100">
                        <div class="text-muted small">Peso total</div>
                        <div class="fs-5 fw-bold mt-2">
                            @ruta.PesoTotalKg.ToString("0.##") kg
                        </div>
                    </div>
                </div>
            </div>

            <h5 class="fw-bold mb-3">Paradas de la ruta</h5>

            @if (ruta.Paradas.Count == 0)
            {
                <div class="bg-white rounded-4 border p-4 text-center text-muted">
                    Esta ruta todavía no tiene paradas.
                </div>
            }
            else
            {
                @foreach (var parada in ruta.Paradas.OrderBy(p => p.Orden))
                {
                    <div class="bg-white rounded-4 border p-3 mb-3"
                         @key="parada.EnvioId">
                        <div class="d-flex align-items-start gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                 style="background:#ede9fe;color:#6d28d9;width:42px;height:42px;flex-shrink:0">
                                @parada.Orden
                            </div>

                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    <div class="fw-bold">
                                        @parada.Destinatario.Nombre
                                        @parada.Destinatario.Apellido
                                    </div>

                                    <span class="badge bg-light text-dark border">
                                        @parada.EstadoEnvio
                                    </span>
                                </div>

                                <div class="mt-2">
                                    <div class="fw-semibold">
                                        @parada.Direccion.Calle
                                        @parada.Direccion.Numero

                                        @if (!string.IsNullOrWhiteSpace(parada.Direccion.Apartamento))
                                        {
                                            <span> - Apto. @parada.Direccion.Apartamento</span>
                                        }
                                    </div>

                                    <div class="text-muted small">
                                        @parada.Direccion.Ciudad,
                                        @parada.Direccion.Departamento
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(parada.Direccion.Referencia))
                                    {
                                        <div class="text-muted small mt-1">
                                            Referencia: @parada.Direccion.Referencia
                                        </div>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(parada.Destinatario.Telefono))
                                {
                                    <div class="small mt-2">
                                        Teléfono: @parada.Destinatario.Telefono
                                    </div>
                                }

                                <hr class="my-3" />

                                <div class="small text-muted">
                                    Seguimiento: @parada.CodigoSeguimiento
                                </div>

                                <div class="small mt-2">
                                    <strong>Bultos:</strong> @parada.CantidadBultos
                                    <span class="mx-2">·</span>
                                    <strong>Peso:</strong> @parada.PesoKg.ToString("0.##") kg
                                </div>

                                @if (enviosPendientes.Contains(parada.EnvioId))
                                {
                                    <div class="alert alert-warning small mt-3 mb-0">
                                        <strong>Operación pendiente de sincronización</strong>
                                        <div>Está guardada en este dispositivo y se enviará cuando vuelva la conexión.</div>
                                    </div>
                                }
                                else if (enviosConfirmados.Contains(parada.EnvioId))
                                {
                                    <div class="alert alert-info small mt-3 mb-0">
                                        Entrega registrada correctamente. No se puede confirmar nuevamente.
                                    </div>
                                }
                                else if (ruta.Estado != "Finalizada" &&
                                         parada.EstadoEnvio == "EnTransito")
                                {
                                    @if (formularioAbierto == (parada.EnvioId, Formulario.Entrega))
                                    {
                                        <FormularioEntrega RutaId="Id"
                                                           Parada="parada"
                                                           OnTerminado="Registrado"
                                                           OnGuardadoPendiente="OperacionGuardadaPendiente"
                                                           OnCancelar="CerrarFormulario" />
                                    }
                                    else if (formularioAbierto == (parada.EnvioId, Formulario.IntentoFallido))
                                    {
                                        <FormularioIntentoFallido RutaId="Id"
                                                                 EnvioId="parada.EnvioId"
                                                                 OnTerminado="Registrado"
                                                                 OnCancelar="CerrarFormulario" />
                                    }
                                    else
                                    {
                                        <div class="d-grid gap-2 mt-3">
                                            <button class="btn text-white rounded-3 py-2 fw-semibold"
                                                    style="background:#6d28d9"
                                                    @onclick="() => AbrirFormulario(parada.EnvioId, Formulario.Entrega)">
                                                Confirmar entrega
                                            </button>

                                            <button class="btn rounded-3 py-2 fw-semibold"
                                                    style="border:1px solid #ddd6fe;color:#6d28d9;background:#faf5ff"
                                                    @onclick="() => AbrirFormulario(parada.EnvioId, Formulario.IntentoFallido)">
                                                No se pudo entregar
                                            </button>
                                        </div>
                                    }
                                }

                                @if (parada.Franja is not null)
                                {
                                    <div class="small mt-2" style="color:#6d28d9">
                                        Entrega con franja horaria asignada
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        }
    }
</div>

@code {
    private enum Formulario
    {
        Entrega,
        IntentoFallido
    }

    [Parameter]
    public int Id { get; set; }

    private RutaDetalleDto? ruta;
    private HashSet<int> enviosPendientes = [];
    private HashSet<int> enviosConfirmados = [];

    private bool cargando = true;
    private bool avisoEsConflicto;

    private string? error;
    private string? aviso;

    private (int EnvioId, Formulario Tipo)? formularioAbierto;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        error = null;

        try
        {
            await CargarRutaAsync();
            await ActualizarPendientesAsync();
            await PrecargarMotivosAsync();
        }
        catch (Exception)
        {
            error = "No se pudieron consultar las operaciones pendientes.";
        }
        finally
        {
            cargando = false;
        }
    }
    
    private async Task OperacionGuardadaPendiente()
    {
        formularioAbierto = null;

        aviso = null;

        await ActualizarPendientesAsync();
    }

    private async Task ActualizarPendientesAsync()
    {
        var pendientes = new HashSet<int>();
        var confirmados = new HashSet<int>();

        if (ruta is not null)
        {
            foreach (var parada in ruta.Paradas)
            {
                if (await Sincronizacion.TieneOperacionPendienteAsync(parada.EnvioId))
                    pendientes.Add(parada.EnvioId);

                if (await Confirmadas.EstaConfirmadoAsync(parada.EnvioId))
                    confirmados.Add(parada.EnvioId);
            }
        }

        enviosPendientes = pendientes;
        enviosConfirmados = confirmados;
    }

    private async Task CargarRutaAsync()
    {
        try
        {
            ruta = await RutasService.ObtenerRutaAsync(Id);

            if (ruta is null)
            {
                error = "No se encontró la ruta.";
            }
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception)
        {
            error = "No se pudo cargar la hoja de ruta.";
        }
    }

    private async Task AbrirFormulario(int envioId, Formulario tipo)
    {
        aviso = null;

        var parada = ruta?.Paradas.FirstOrDefault(p => p.EnvioId == envioId);

        if (ruta is null ||
            ruta.Estado == "Finalizada" ||
            parada is null ||
            parada.EstadoEnvio != "EnTransito")
        {
            avisoEsConflicto = true;
            aviso = "Este envío ya no está disponible para registrar una entrega.";
            return;
        }

        try
        {
            if (await Sincronizacion.TieneOperacionPendienteAsync(envioId))
            {
                enviosPendientes.Add(envioId);

                avisoEsConflicto = true;
                aviso = "Este envío ya tiene una operación pendiente de sincronización.";
                return;
            }
        }
        catch (Exception)
        {
            avisoEsConflicto = true;
            aviso = "No se pudo comprobar si existen operaciones pendientes.";
            return;
        }
        
        if (await Confirmadas.EstaConfirmadoAsync(envioId))
        {
            enviosConfirmados.Add(envioId);
            avisoEsConflicto = true;
            aviso = "Este envío ya tiene una operación confirmada.";
            return;
        }

        formularioAbierto = (envioId, tipo);
    }
    
    private async Task PrecargarMotivosAsync()
    {
        try
        {
            await Sincronizacion.ObtenerMotivosAsync();
        }
        catch (HttpRequestException)
        {
            // Si estamos offline, el formulario utilizará
            // los motivos previamente guardados.
        }
        catch (TaskCanceledException)
        {
            // No bloqueamos la hoja de ruta.
        }
    }

    private async Task CerrarFormulario()
    {
        formularioAbierto = null;
        await ActualizarPendientesAsync();
    }

    private async Task Registrado(ResultadoOperacionDto resultado)
    {
        formularioAbierto = null;

        avisoEsConflicto = resultado.Resultado == "Conflicto";

        aviso = avisoEsConflicto
            ? resultado.Mensaje
            : "Registrado correctamente.";

        await CargarRutaAsync();
        await ActualizarPendientesAsync();
    }

    private void Volver()
    {
        Navigation.NavigateTo("/rutas");
    }
}

```