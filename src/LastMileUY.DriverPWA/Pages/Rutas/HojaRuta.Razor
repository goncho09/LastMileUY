@page "/rutas/{Id:int}"
@using LastMileUY.Contracts.Entregas
@using LastMileUY.Contracts.Rutas
@using LastMileUY.Contracts.Sincronizacion
@using LastMileUY.DriverPWA.Services
@inject RutasService RutasService
@inject NavigationManager Navigation
@inject SincronizacionService Sincronizacion
@inject OperacionesConfirmadasService Confirmadas
@inject BultosIdentificadosService BultosIdentificados

<PageTitle>Hoja de ruta</PageTitle>

<div class="min-h-dvh bg-canvas">
<div class="mx-auto max-w-2xl px-4 pt-4 pb-10">
    <button type="button" class="mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-violet-700"
            @onclick="Volver">
        ← Mis rutas
    </button>

    @if (cargando)
    {
        <p class="text-sm text-slate-500">Cargando hoja de ruta...</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="aviso aviso-error mb-4" role="alert">
                @error
            </div>
        }

        @if (!string.IsNullOrEmpty(aviso))
        {
            <div class="aviso @(avisoEsConflicto ? "aviso-alerta" : "aviso-ok") mb-4"
                 role="status">
                @aviso
            </div>
        }

        @if (ruta is not null)
        {
            <div class="mb-4 rounded-lg bg-violet-700 px-5 py-4 text-white">
                <div class="text-xs font-medium text-violet-200">HOJA DE RUTA</div>
                <h2 class="mt-1 text-xl font-semibold">@ruta.Nombre</h2>
                <div class="mt-0.5 text-sm text-violet-100">@ruta.Fecha.ToString("dd/MM/yyyy")</div>

                <span class="mt-3 inline-flex rounded bg-white/15 px-2 py-0.5 text-xs font-medium text-white">
                    @ruta.Estado
                </span>
            </div>

            @if (ruta.Estado == "Finalizada")
            {
                <div class="mb-4 rounded-lg border border-violet-200 bg-violet-50 px-4 py-3 text-violet-900">
                    <div class="font-semibold">Ruta finalizada</div>
                    <div class="mt-0.5 text-sm">
                        Todas las paradas fueron procesadas.
                    </div>
                </div>
            }

            <div class="mb-6 grid grid-cols-2 gap-3">
                <div class="rounded-lg border border-line bg-white px-4 py-3">
                    <div class="text-xs text-slate-500">Paradas</div>
                    <div class="mt-1 text-2xl font-semibold text-slate-900">
                        @ruta.Paradas.Count
                    </div>
                </div>

                <div class="rounded-lg border border-line bg-white px-4 py-3">
                    <div class="text-xs text-slate-500">Peso total</div>
                    <div class="mt-1 text-2xl font-semibold text-slate-900">
                        @ruta.PesoTotalKg.ToString("0.##") kg
                    </div>
                </div>
            </div>

            <h5 class="mb-3 text-sm font-semibold text-slate-900">Paradas de la ruta</h5>

            @if (ruta.Paradas.Count == 0)
            {
                <div class="rounded-lg border border-line bg-white p-6 text-center text-sm text-slate-500">
                    Esta ruta todavía no tiene paradas.
                </div>
            }
            else
            {
                @foreach (var parada in ruta.Paradas.OrderBy(p => p.Orden))
                {
                    <div class="mb-3 rounded-lg border border-line bg-white p-4"
                         @key="parada.EnvioId">
                        <div class="flex w-full min-w-0 items-start gap-3">
                            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-violet-200 bg-violet-50 text-sm font-semibold text-violet-700">
                                @parada.Orden
                            </div>

                            <div class="min-w-0 grow">
                                <div class="flex min-w-0 flex-wrap items-start justify-between gap-2">
                                    <div class="min-w-0 break-words font-semibold text-slate-900">
                                        @parada.Destinatario.Nombre
                                        @parada.Destinatario.Apellido
                                    </div>

                                    <span class="max-w-full break-words rounded border border-line bg-slate-50 px-1.5 py-0.5 text-xs font-medium text-slate-600">
                                        @parada.EstadoEnvio
                                    </span>
                                </div>

                                <div class="mt-2">
                                    <div class="font-medium text-slate-800">
                                        @parada.Direccion.Calle
                                        @parada.Direccion.Numero

                                        @if (!string.IsNullOrWhiteSpace(parada.Direccion.Apartamento))
                                        {
                                            <span> - Apto. @parada.Direccion.Apartamento</span>
                                        }
                                    </div>

                                    <div class="text-sm text-slate-500">
                                        @parada.Direccion.Ciudad,
                                        @parada.Direccion.Departamento
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(parada.Direccion.Referencia))
                                    {
                                        <div class="mt-1 text-sm text-slate-500">
                                            Referencia: @parada.Direccion.Referencia
                                        </div>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(parada.Destinatario.Telefono))
                                {
                                    <div class="mt-2 text-sm text-slate-700">
                                        Teléfono: @parada.Destinatario.Telefono
                                    </div>
                                }

                                <hr class="my-3 border-line" />

                                <div class="font-mono text-xs text-slate-500">
                                    Seguimiento: @parada.CodigoSeguimiento
                                </div>

                                <div class="mt-1.5 text-sm text-slate-700">
                                    <strong class="font-medium">Bultos:</strong> @parada.CantidadBultos
                                    <span class="mx-2 text-slate-300">·</span>
                                    <strong class="font-medium">Peso:</strong> @parada.PesoKg.ToString("0.##") kg
                                </div>

                                @if (parada.Bultos is { Count: > 0 })
                                {
                                    <SelectorBultos
                                        @key="parada.EnvioId"
                                        Bultos="parada.Bultos"
                                        Identificados="ObtenerBultosIdentificados(parada.EnvioId)"
                                        OnCambio="@(ids => GuardarBultosIdentificados(parada.EnvioId, ids))" />
                                }

                                @if (enviosPendientes.Contains(parada.EnvioId))
                                {
                                    <div class="aviso aviso-alerta mt-3 text-sm">
                                        <strong class="font-semibold">Operación pendiente de sincronización</strong>
                                        <div>Está guardada en este dispositivo y se enviará cuando vuelva la conexión.</div>
                                        @if (resumenPendientes.TryGetValue(parada.EnvioId, out var resumen) && resumen.Count > 0)
                                        {
                                            <ul class="mt-2 list-disc ps-4">
                                                @foreach (var linea in resumen)
                                                {
                                                    <li class="[overflow-wrap:anywhere]">@linea</li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                }
                                else if (enviosConfirmados.Contains(parada.EnvioId))
                                {
                                    <div class="aviso aviso-info mt-3 text-sm">
                                        Entrega registrada correctamente. No se puede confirmar nuevamente.
                                    </div>
                                }
                                else if (ruta.Estado != "Finalizada" &&
                                         parada.EstadoEnvio == "EnTransito")
                                {
                                    @if (formularioAbierto == (parada.EnvioId, Formulario.Entrega))
                                    {
                                        <FormularioEntrega RutaId="Id"
                                                           Parada="parada"
                                                           Identificados="ObtenerBultosIdentificados(parada.EnvioId)"
                                                           Regla="ruta.ReglaEntregaParcial"
                                                           OnTerminado="Registrado"
                                                           OnGuardadoPendiente="OperacionGuardadaPendiente"
                                                           OnCancelar="CerrarFormulario" />
                                    }
                                    else if (formularioAbierto == (parada.EnvioId, Formulario.IntentoFallido))
                                    {
                                        <FormularioIntentoFallido RutaId="Id"
                                                                 EnvioId="parada.EnvioId"
                                                                 OnTerminado="Registrado"
                                                                 OnCancelar="CerrarFormulario" />
                                    }
                                    else
                                    {
                                        <div class="mt-4 grid gap-2">
                                            <button type="button" class="boton boton-principal"
                                                    @onclick="() => AbrirFormulario(parada.EnvioId, Formulario.Entrega)">
                                                Confirmar entrega
                                            </button>

                                            <button type="button" class="boton boton-secundario"
                                                    @onclick="() => AbrirFormulario(parada.EnvioId, Formulario.IntentoFallido)">
                                                No se pudo entregar
                                            </button>
                                        </div>
                                    }
                                }

                                @if (parada.Franja is not null)
                                {
                                    <div class="mt-2 text-sm text-violet-700">
                                        Entrega con franja horaria asignada
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        }
    }
</div>
</div>

@code {
    private enum Formulario
    {
        Entrega,
        IntentoFallido
    }

    [Parameter]
    public int Id { get; set; }

    private RutaDetalleDto? ruta;
    private HashSet<int> enviosPendientes = [];
    private HashSet<int> enviosConfirmados = [];
    private Dictionary<int, HashSet<int>> bultosIdentificadosPorEnvio = [];

    // Por envío, qué quedó guardado de cada bulto en la operación pendiente
    private Dictionary<int, List<string>> resumenPendientes = [];

    // Los motivos (sin conexión, los guardados en el celular), para mostrar su nombre en el resumen
    private List<MotivoNoEntregaDto> motivos = [];
    
    private bool cargando = true;
    private bool avisoEsConflicto;

    private string? error;
    private string? aviso;

    private (int EnvioId, Formulario Tipo)? formularioAbierto;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        error = null;

        try
        {
            await CargarRutaAsync();
            await PrecargarMotivosAsync();
            await ActualizarPendientesAsync();

            // Lo escaneado antes de cerrar la app sigue marcado
            bultosIdentificadosPorEnvio = await BultosIdentificados.LeerAsync(Id);
        }
        catch (Exception)
        {
            error = "No se pudieron consultar las operaciones pendientes.";
        }
        finally
        {
            cargando = false;
        }
    }
    
    private IReadOnlyList<int> ObtenerBultosIdentificados(int envioId)
    {
        return bultosIdentificadosPorEnvio.TryGetValue(envioId, out var ids)
            ? ids.ToArray()
            : [];
    }

    private async Task GuardarBultosIdentificados(
        int envioId,
        IReadOnlyList<int> bultosIds)
    {
        bultosIdentificadosPorEnvio[envioId] = bultosIds.ToHashSet();

        try
        {
            await BultosIdentificados.GuardarAsync(Id, envioId, bultosIds);
        }
        catch (JSException)
        {
            // Si el navegador no deja guardar, sigue valiendo lo escaneado mientras la app esté abierta
        }
    }
    
    private async Task OperacionGuardadaPendiente()
    {
        formularioAbierto = null;

        aviso = null;

        await ActualizarPendientesAsync();
    }

    private async Task ActualizarPendientesAsync()
    {
        var pendientes = new HashSet<int>();
        var confirmados = new HashSet<int>();
        var resumenes = new Dictionary<int, List<string>>();

        if (ruta is not null)
        {
            foreach (var parada in ruta.Paradas)
            {
                if (await Sincronizacion.ObtenerPendienteAsync(parada.EnvioId) is { } pendiente)
                {
                    pendientes.Add(parada.EnvioId);
                    resumenes[parada.EnvioId] = ResultadoPorBulto.Resumen(pendiente, parada.Bultos ?? [], motivos);
                }

                if (await Confirmadas.EstaConfirmadoAsync(parada.EnvioId))
                    confirmados.Add(parada.EnvioId);
            }
        }

        enviosPendientes = pendientes;
        enviosConfirmados = confirmados;
        resumenPendientes = resumenes;
    }

    private async Task CargarRutaAsync()
    {
        try
        {
            ruta = await RutasService.ObtenerRutaAsync(Id);

            if (ruta is null)
            {
                error = "No se encontró la ruta.";
            }
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception)
        {
            error = "No se pudo cargar la hoja de ruta.";
        }
    }

    private async Task AbrirFormulario(int envioId, Formulario tipo)
    {
        aviso = null;

        var parada = ruta?.Paradas.FirstOrDefault(p => p.EnvioId == envioId);

        if (ruta is null ||
            ruta.Estado == "Finalizada" ||
            parada is null ||
            parada.EstadoEnvio != "EnTransito")
        {
            avisoEsConflicto = true;
            aviso = "Este envío ya no está disponible para registrar una entrega.";
            return;
        }

        try
        {
            if (await Sincronizacion.TieneOperacionPendienteAsync(envioId))
            {
                enviosPendientes.Add(envioId);

                avisoEsConflicto = true;
                aviso = "Este envío ya tiene una operación pendiente de sincronización.";
                return;
            }
        }
        catch (Exception)
        {
            avisoEsConflicto = true;
            aviso = "No se pudo comprobar si existen operaciones pendientes.";
            return;
        }
        
        if (await Confirmadas.EstaConfirmadoAsync(envioId))
        {
            enviosConfirmados.Add(envioId);
            avisoEsConflicto = true;
            aviso = "Este envío ya tiene una operación confirmada.";
            return;
        }

        formularioAbierto = (envioId, tipo);
    }
    
    private async Task PrecargarMotivosAsync()
    {
        try
        {
            motivos = await Sincronizacion.ObtenerMotivosAsync();
        }
        catch (HttpRequestException)
        {
            // Si estamos offline, el formulario utilizará
            // los motivos previamente guardados.
        }
        catch (TaskCanceledException)
        {
            // No bloqueamos la hoja de ruta.
        }
    }

    private async Task CerrarFormulario()
    {
        formularioAbierto = null;
        await ActualizarPendientesAsync();
    }

    private async Task Registrado(ResultadoOperacionDto resultado)
    {
        formularioAbierto = null;

        avisoEsConflicto = resultado.Resultado == "Conflicto";

        aviso = avisoEsConflicto
            ? resultado.Mensaje
            : "Registrado correctamente.";

        await CargarRutaAsync();
        await ActualizarPendientesAsync();
    }

    private void Volver()
    {
        Navigation.NavigateTo("/rutas");
    }
}