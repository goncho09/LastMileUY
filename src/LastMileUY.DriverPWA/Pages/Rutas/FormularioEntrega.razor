@using LastMileUY.Contracts.Entregas
@using LastMileUY.Contracts.Rutas
@using LastMileUY.Contracts.Sincronizacion
@using LastMileUY.DriverPWA.Services
@inject SincronizacionService Sincronizacion
@inject IJSRuntime JS
@inject OperacionesConfirmadasService Confirmadas

<div class="rounded-4 p-3 mt-3" style="background:#faf5ff;border:1px solid #ddd6fe">
    <div class="fw-bold mb-1" style="color:#4c1d95">Confirmar entrega</div>
    <p class="small mb-3" style="color:#7c3aed">
        @(PideAlgo ? "La regla del operador pide lo marcado como obligatorio." : "La regla del operador no pide evidencia para este envío.")
    </p>

    @if (BultosPorEntregar.Count > 1)
    {
        <fieldset class="mb-3">
            <legend class="form-label fw-semibold small mb-1">Bultos entregados</legend>
            <p class="small text-muted mb-2">
                Desmarcá los que no entregaste y elegí por qué.
                @if (Regla is { PermiteEntregaParcial: false })
                {
                    <span>Las reglas de esta hoja de ruta no permiten entregas parciales.</span>
                }
            </p>

            @foreach (var bulto in BultosPorEntregar)
            {
                var marca = marcas[bulto.Id];

                <div class="rounded-3 bg-white p-2 mb-2" style="border:1px solid #ddd6fe" @key="bulto.Id">
                    <div class="form-check mb-0">
                        <input id="bulto-@bulto.Id" type="checkbox" class="form-check-input"
                               checked="@marca.Entregado" disabled="@enviando"
                               @onchange="e => CambiarEntregado(bulto.Id, e)" />
                        <label class="form-check-label small fw-semibold" for="bulto-@bulto.Id"
                               style="overflow-wrap:anywhere">
                            @bulto.Codigo
                            @if (!string.IsNullOrWhiteSpace(bulto.Descripcion))
                            {
                                <span class="fw-normal text-muted"> · @bulto.Descripcion</span>
                            }
                        </label>
                    </div>

                    @if (!marca.Entregado)
                    {
                        <label class="visually-hidden" for="motivo-bulto-@bulto.Id">Por qué no se entregó @bulto.Codigo</label>
                        <select id="motivo-bulto-@bulto.Id" class="form-select form-select-sm rounded-3 mt-2"
                                style="border-color:#ddd6fe" disabled="@enviando"
                                value="@(marca.MotivoNoEntregaId?.ToString() ?? "")"
                                @onchange="e => CambiarMotivo(bulto.Id, e)">
                            <option value="">¿Por qué no se entregó?</option>
                            @foreach (var motivo in motivos)
                            {
                                <option value="@motivo.Id">@motivo.Nombre</option>
                            }
                        </select>
                        @if (motivosCargados && motivos.Count == 0)
                        {
                            <div class="small mt-1 text-danger">No hay motivos disponibles sin conexión.</div>
                        }
                    }
                </div>
            }
        </fieldset>
    }

    <label class="form-label fw-semibold small" for="receptor-@Parada.EnvioId">
        Quién recibe
        <span class="fw-normal text-muted">@(Parada.Evidencia.DocumentoReceptor ? "(obligatorio)" : "(opcional)")</span>
    </label>
    <input id="receptor-@Parada.EnvioId" class="form-control rounded-3" style="border-color:#ddd6fe"
           maxlength="150" @bind="nombreReceptor" />

    @if (Parada.Evidencia.DocumentoReceptor)
    {
        <label class="form-label fw-semibold small mt-3" for="documento-@Parada.EnvioId">
            Documento de quien recibe <span class="fw-normal text-muted">(obligatorio)</span>
        </label>
        <input id="documento-@Parada.EnvioId" class="form-control rounded-3" style="border-color:#ddd6fe"
               maxlength="50" inputmode="numeric" @bind="documentoReceptor" />
    }

    <div class="d-flex justify-content-between align-items-end mt-3">
        <span class="form-label fw-semibold small mb-1">
            Firma <span class="fw-normal text-muted">@(Parada.Evidencia.Firma ? "(obligatoria)" : "(opcional)")</span>
        </span>
        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" style="color:#6d28d9"
                @onclick="LimpiarFirma">Borrar firma</button>
    </div>
    <canvas @ref="lienzoFirma" width="600" height="220" aria-label="Firma de quien recibe"
            class="w-100 rounded-3 bg-white" style="border:1px dashed #a78bfa;touch-action:none;height:150px"></canvas>

    <label class="form-label fw-semibold small mt-3" for="foto-@Parada.EnvioId">
        Foto <span class="fw-normal text-muted">@(Parada.Evidencia.Foto ? "(obligatoria)" : "(opcional)")</span>
    </label>
    <InputFile id="@($"foto-{Parada.EnvioId}")" class="form-control rounded-3" accept="image/*"
               capture="environment" OnChange="CargarFoto" />
    @if (fotoBase64 is not null)
    {
        <div class="small mt-1" style="color:#6d28d9">Foto lista para enviar.</div>
    }

    <label class="form-label fw-semibold small mt-3" for="obs-entrega-@Parada.EnvioId">
        Observaciones <span class="fw-normal text-muted">(opcional)</span>
    </label>
    <textarea id="obs-entrega-@Parada.EnvioId" class="form-control rounded-3" style="border-color:#ddd6fe"
              rows="2" maxlength="1000" @bind="observaciones"></textarea>

    @if (error is not null)
    {
        <div class="alert alert-danger small mt-3 mb-0" role="alert">@error</div>
    }

    <div class="d-grid gap-2 mt-3">
        <button type="button" class="btn text-white rounded-3 py-2 fw-semibold" style="background:#6d28d9"
                disabled="@(enviando || comprobandoPendiente || operacionPendiente || entregaConfirmada || EstadoFinalizado)"
                @onclick="Enviar">
            @(enviando ? "Guardando..." : EsParcial ? "Confirmar entrega parcial" : "Confirmar entrega")
        </button>
        <button type="button" class="btn rounded-3 py-2"
                style="background:white;color:#6d28d9;border:1px solid #ddd6fe"
                disabled="@enviando" @onclick="OnCancelar">Cancelar</button>
    </div>
</div>

@code {
    private const long MaximoImagen = 1024 * 1024;

    [Parameter, EditorRequired] public int RutaId { get; set; }
    [Parameter, EditorRequired] public ParadaDto Parada { get; set; } = null!;
    [Parameter] public EventCallback<ResultadoOperacionDto> OnTerminado { get; set; }
    [Parameter] public EventCallback OnGuardadoPendiente { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }

    [Parameter] public IReadOnlyList<int> Identificados { get; set; } = [];

    [Parameter] public ReglaEntregaParcialRutaDto? Regla { get; set; }

    private Dictionary<int, ResultadoPorBulto.Marca> marcas = [];
    private List<MotivoNoEntregaDto> motivos = [];
    private bool motivosCargados;

    private List<BultoRutaDto> BultosPorEntregar =>
        (Parada.Bultos ?? []).Where(b => marcas.ContainsKey(b.Id)).ToList();

    private bool EsParcial => marcas.Values.Any(m => !m.Entregado) && marcas.Values.Any(m => m.Entregado);

    private ElementReference lienzoFirma;
    private string? nombreReceptor;
    private string? documentoReceptor;
    private string? observaciones;
    private string? fotoBase64;
    private string? error;
    private bool enviando;
    private bool operacionPendiente;
    private bool entregaConfirmada;
    private bool comprobandoPendiente = true;

    private bool PideAlgo => Parada.Evidencia is { Firma: true } or { Foto: true } or { DocumentoReceptor: true };
    private bool EstadoFinalizado => Parada.EstadoEnvio is "Entregado" or "Devuelto" or "Extraviado";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !operacionPendiente && !entregaConfirmada && !EstadoFinalizado)
            await JS.InvokeVoidAsync("lastMileEntrega.iniciarFirma", lienzoFirma);
    }

    protected override async Task OnInitializedAsync()
    {
        marcas = ResultadoPorBulto.MarcasIniciales(Parada.Bultos ?? [], Identificados);

        if (marcas.Count > 1)
        {
            try
            {
                motivos = await Sincronizacion.ObtenerMotivosAsync();
            }
            catch (UnauthorizedAccessException ex)
            {
                error = ex.Message;
            }
            finally
            {
                motivosCargados = true;
            }
        }
    }

    private void CambiarEntregado(int bultoId, ChangeEventArgs e)
    {
        var marca = marcas[bultoId];
        marca.Entregado = e.Value is true;

        if (marca.Entregado)
            marca.MotivoNoEntregaId = null;
    }

    private void CambiarMotivo(int bultoId, ChangeEventArgs e) =>
        marcas[bultoId].MotivoNoEntregaId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;

    protected override async Task OnParametersSetAsync()
    {
        comprobandoPendiente = true;
        try
        {
            operacionPendiente = await Sincronizacion.TieneOperacionPendienteAsync(Parada.EnvioId);
            entregaConfirmada = await Confirmadas.EstaConfirmadoAsync(Parada.EnvioId);
        }
        finally
        {
            comprobandoPendiente = false;
        }
    }

    private async Task LimpiarFirma() =>
        await JS.InvokeVoidAsync("lastMileEntrega.limpiarFirma", lienzoFirma);

    private async Task CargarFoto(InputFileChangeEventArgs e)
    {
        error = null;
        fotoBase64 = null;
        try
        {
            var achicada = await e.File.RequestImageFileAsync("image/jpeg", 1280, 1280);
            await using var lectura = achicada.OpenReadStream(MaximoImagen);
            using var memoria = new MemoryStream();
            await lectura.CopyToAsync(memoria);
            fotoBase64 = Convert.ToBase64String(memoria.ToArray());
        }
        catch (IOException)
        {
            error = "La foto es demasiado grande. Probá con otra.";
        }
    }

    private async Task Enviar()
    {
        if (enviando || comprobandoPendiente || operacionPendiente || entregaConfirmada)
            return;

        enviando = true;
        error = null;
        try
        {
            if (EstadoFinalizado || await Confirmadas.EstaConfirmadoAsync(Parada.EnvioId))
            {
                entregaConfirmada = true;
                error = "Este envío ya fue entregado o está finalizado. No se puede confirmar nuevamente.";
                return;
            }

            if (await Sincronizacion.TieneOperacionPendienteAsync(Parada.EnvioId))
            {
                operacionPendiente = true;
                await OnGuardadoPendiente.InvokeAsync();
                return;
            }

            var decision = ResultadoPorBulto.Decidir(Parada.Bultos ?? [], marcas, Regla);
            if (decision.Error is not null)
            {
                error = decision.Error;
                return;
            }

            var ubicacion = await Ubicacion.ObtenerAsync(JS);
            if (ubicacion is null)
            {
                error = Ubicacion.SinUbicacion;
                return;
            }

            var operacion = new OperacionRequest
            {
                Tipo = decision.Tipo,
                ResultadosBultos = decision.Resultados,
                RutaId = RutaId,
                EnvioId = Parada.EnvioId,
                FechaHoraDispositivo = DateTime.UtcNow,
                Latitud = ubicacion.Latitud,
                Longitud = ubicacion.Longitud,
                Observaciones = Limpio(observaciones),
                NombreReceptor = Limpio(nombreReceptor),
                DocumentoReceptor = Limpio(documentoReceptor),
                FirmaBase64 = await JS.InvokeAsync<string?>("lastMileEntrega.leerFirma", lienzoFirma),
                FotoBase64 = fotoBase64
            };

            var estado = await Sincronizacion.GuardarOperacionAsync(operacion);
            
            if (estado.Pendiente)
            {
                operacionPendiente = true;

                await OnGuardadoPendiente.InvokeAsync();

                return;
            }

            var resultado = estado.Resultado!;
            if (resultado.Resultado is "Rechazada" or "Error")
                error = resultado.Mensaje;
            else
                await OnTerminado.InvokeAsync(resultado);
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor. Revisá las operaciones pendientes antes de reintentar.";
        }
        catch (UnauthorizedAccessException ex)
        {
            error = ex.Message;
        }
        finally
        {
            enviando = false;
        }
    }

    private static string? Limpio(string? texto) =>
        string.IsNullOrWhiteSpace(texto) ? null : texto.Trim();
}
