@using LastMileUY.Contracts.Entregas
@using LastMileUY.Contracts.Sincronizacion
@using LastMileUY.DriverPWA.Services
@inject SincronizacionService Sincronizacion
@inject IJSRuntime JS

<div class="mt-4 rounded-lg border border-line bg-slate-50 p-4">

    <div class="mb-5">
        <h3 class="text-base font-semibold text-slate-900">
            Registrar entrega fallida
        </h3>

        <p class="mt-1 text-sm text-slate-700">
            Seleccioná el motivo por el que no se pudo completar la entrega.
        </p>
    </div>

    <div class="space-y-5">

        <div>
            <label for="motivo-@EnvioId"
                   class="mb-2 block text-sm font-semibold text-gray-800">
                Motivo de no entrega
                <span class="text-red-600">*</span>
            </label>

            <select id="motivo-@EnvioId"
                    class="campo disabled:opacity-60"
                    disabled="@(enviando || mensajePendiente is not null)"
                    @bind="motivoSeleccionado">

                <option value="0">Seleccioná un motivo</option>

                @foreach (var motivo in motivos)
                {
                    <option value="@motivo.Id">
                        @motivo.Nombre
                    </option>
                }
            </select>

            @if (motivosCargados && motivos.Count == 0)
            {
                <p class="mt-2 text-sm text-slate-700">
                    No hay motivos disponibles.
                </p>
            }
        </div>

        <div>
            <label for="observaciones-@EnvioId"
                   class="mb-2 block text-sm font-semibold text-gray-800">
                Observaciones
                <span class="font-normal text-gray-500">(opcional)</span>
            </label>

            <textarea id="observaciones-@EnvioId"
                      class="campo resize-y placeholder:text-slate-400 disabled:opacity-60"
                      rows="3"
                      maxlength="1000"
                      placeholder="Agregá detalles sobre el intento..."
                      disabled="@(enviando || mensajePendiente is not null)"
                      @bind="observaciones"></textarea>
        </div>

        @if (error is not null)
        {
            <div class="aviso aviso-error text-sm"
                 role="alert">
                @error
            </div>
        }

        @if (mensajePendiente is not null)
        {
            <div class="aviso aviso-alerta"
                 role="status">

                <p class="text-sm font-semibold text-amber-900">
                    Intento guardado
                </p>

                <p class="mt-1 text-sm text-amber-800">
                    @mensajePendiente
                </p>
            </div>
        }

        <div class="grid gap-3 pt-2">

            <button type="button"
                    class="boton boton-principal disabled:cursor-not-allowed"
                    disabled="@(enviando || motivoSeleccionado == 0 || mensajePendiente is not null)"
                    @onclick="Enviar">

                @(enviando
                    ? "Guardando..."
                    : mensajePendiente is not null
                        ? "Pendiente de sincronización"
                        : "Registrar intento")
            </button>

            <button type="button"
                    class="boton boton-secundario"
                    disabled="@enviando"
                    @onclick="OnCancelar">
                @(mensajePendiente is not null ? "Volver" : "Cancelar")
            </button>

        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public int RutaId { get; set; }

    [Parameter, EditorRequired]
    public int EnvioId { get; set; }

    [Parameter]
    public EventCallback<ResultadoOperacionDto> OnTerminado { get; set; }

    [Parameter]
    public EventCallback OnCancelar { get; set; }

    private List<MotivoNoEntregaDto> motivos = [];

    private bool motivosCargados;
    private int motivoSeleccionado;

    private string? observaciones;
    private string? error;
    private string? mensajePendiente;

    private bool enviando;
    private bool yaExistePendiente;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            yaExistePendiente =
                await Sincronizacion.TieneOperacionPendienteAsync(EnvioId);

            if (yaExistePendiente)
            {
                mensajePendiente =
                    "Este envío ya tiene una operación pendiente de sincronización.";
            }
            motivos = await Sincronizacion.ObtenerMotivosAsync();
        }
        catch (UnauthorizedAccessException)
        {
            error = "Tu sesión expiró. Volvé a iniciar sesión.";
        }
        catch (HttpRequestException)
        {
            error = "No se pudieron cargar los motivos. Comprobá tu conexión.";
        }
        finally
        {
            motivosCargados = true;
        }
    }

    private async Task Enviar()
    {
        if (enviando || motivoSeleccionado == 0 || mensajePendiente is not null)
            return;

        enviando = true;
        error = null;

        try
        {
            var ubicacion = await Ubicacion.ObtenerAsync(JS);

            if (ubicacion is null)
            {
                error = Ubicacion.SinUbicacion;
                return;
            }

            var operacion = new OperacionRequest
            {
                Tipo = "IntentoFallido",
                RutaId = RutaId,
                EnvioId = EnvioId,
                FechaHoraDispositivo = DateTime.UtcNow,
                Latitud = ubicacion.Latitud,
                Longitud = ubicacion.Longitud,
                MotivoNoEntregaId = motivoSeleccionado,
                Observaciones = string.IsNullOrWhiteSpace(observaciones)
                    ? null
                    : observaciones.Trim()
            };

            var estado = await Sincronizacion.GuardarOperacionAsync(operacion);

            if (estado.Pendiente)
            {
                mensajePendiente =
                    "El intento fallido quedó guardado en este dispositivo. " +
                    "Se enviará cuando se ejecute la sincronización.";

                return;
            }

            var resultado = estado.Resultado;

            if (resultado is null)
            {
                error = "No se pudo determinar el resultado de la operación.";
                return;
            }

            if (resultado.Resultado is "Rechazada" or "Error")
            {
                error = resultado.Mensaje;
            }
            else
            {
                await OnTerminado.InvokeAsync(resultado);
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "No se pudo completar el envío. Revisá las operaciones pendientes.";
        }
        catch (TaskCanceledException)
        {
            error = "La solicitud tardó demasiado. Revisá las operaciones pendientes.";
        }
        catch (JSException)
        {
            error = "No se pudo acceder al almacenamiento local. Intentá nuevamente.";
        }
        finally
        {
            enviando = false;
        }
    }
}
