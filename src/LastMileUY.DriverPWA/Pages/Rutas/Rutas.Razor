
@page "/rutas"
@using LastMileUY.Contracts.Rutas
@using LastMileUY.DriverPWA.Services
@inject RutasService RutasService
@inject NavigationManager Navigation

<PageTitle>Mis rutas | LastMileUY</PageTitle>

<div class="min-h-dvh bg-slate-50 pb-24">

    <header class="bg-gradient-to-r from-violet-700 to-indigo-700 px-5 pb-8 pt-7 text-white">
        <div class="mx-auto max-w-4xl">
            <button class="mb-5 text-sm text-violet-100" @onclick="() => Volver()">
                ← Volver al inicio
            </button>

            <h1 class="text-2xl font-bold">Mis rutas</h1>
            <p class="mt-1 text-sm text-violet-200">
                Consultá tus rutas asignadas
            </p>
        </div>
    </header>

    <main class="mx-auto max-w-4xl space-y-4 px-4 pt-6">

        @if (cargando)
        {
            <p class="text-center text-slate-500">
                Cargando rutas...
            </p>
        }
        else if (error is not null)
        {
            <div class="rounded-2xl bg-red-50 p-5 text-red-700">
                @error
            </div>
        }
        else if (rutas.Count == 0)
        {
            <div class="rounded-2xl bg-white p-8 text-center shadow-sm">
                <div class="mb-3 text-4xl">🚚</div>
                <h2 class="font-bold text-slate-800">
                    No tenés rutas asignadas
                </h2>
                <p class="mt-2 text-sm text-slate-500">
                    Las rutas despachadas aparecerán acá.
                </p>
            </div>
        }
        else
        {
            <p class="text-sm font-medium text-slate-500">
                @rutas.Count rutas disponibles
            </p>

            @foreach (var ruta in rutas)
            {
                <article class="rounded-2xl bg-white p-5 shadow-sm"
                         @key="ruta.Id">

                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-wide text-violet-600">
                                Ruta #@ruta.Id
                            </p>
                            <h2 class="mt-1 text-lg font-bold text-slate-900">
                                @ruta.Nombre
                            </h2>
                        </div>

                        <span class="rounded-full bg-violet-100 px-3 py-1 text-xs font-semibold text-violet-700">
                            @ruta.Estado
                        </span>
                    </div>

                    <div class="mt-5 space-y-2 text-sm text-slate-600">
                        <p>📅 @ruta.Fecha.ToString("dd/MM/yyyy")</p>
                        <p>🚚 @ruta.Vehiculo</p>
                        <p>📍 @ruta.CantidadParadas paradas</p>
                    </div>

                    <button type="button"
                            class="mt-5 w-full rounded-xl bg-violet-600 py-3 font-semibold text-white hover:bg-violet-700"
                            @onclick="() => VerRuta(ruta.Id)">
                        Ver hoja de ruta →
                    </button>
                </article>
            }
        }
    </main>
</div>

@code {
    private List<RutaResumenDto> rutas = [];
    private bool cargando = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            rutas = await RutasService.ObtenerMisRutasAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception)
        {
            error = "No se pudieron cargar las rutas. Comprobá tu conexión.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void VerRuta(int id)
    {
        Navigation.NavigateTo($"/rutas/{id}");
    }

    private void Volver()
    {
        Navigation.NavigateTo("/");
    }
    
}
