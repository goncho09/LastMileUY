
@page "/rutas"
@using LastMileUY.Contracts.Rutas
@using LastMileUY.DriverPWA.Services
@inject RutasService RutasService
@inject NavigationManager Navigation

<PageTitle>Mis rutas | LastMileUY</PageTitle>

<div class="min-h-dvh bg-canvas pb-24">

    <header class="bg-violet-700 px-5 pb-6 pt-5 text-white">
        <div class="mx-auto max-w-2xl">
            <button type="button" class="mb-4 text-sm text-violet-100" @onclick="() => Volver()">
                ← Volver al inicio
            </button>

            <h1 class="text-xl font-semibold">Mis rutas</h1>
            <p class="mt-1 text-sm text-violet-200">
                Consultá tus rutas asignadas
            </p>
        </div>
    </header>

    <main class="mx-auto max-w-2xl space-y-4 px-4 pt-6">

        @if (cargando)
        {
            <p class="text-center text-slate-500">
                Cargando rutas...
            </p>
        }
        else if (error is not null)
        {
            <div class="aviso aviso-error text-sm">
                @error
            </div>
        }
        else if (rutas.Count == 0)
        {
            <div class="rounded-lg border border-line bg-white p-8 text-center">
                <div class="mb-3 flex justify-center text-slate-400"><Icono Nombre="camion" Clase="h-8 w-8" /></div>
                <h2 class="font-semibold text-slate-800">
                    No tenés rutas asignadas
                </h2>
                <p class="mt-2 text-sm text-slate-500">
                    Las rutas despachadas aparecerán acá.
                </p>
            </div>
        }
        else
        {
            <p class="text-sm font-medium text-slate-500">
                @rutas.Count rutas disponibles
            </p>

            @foreach (var ruta in rutas)
            {
                <article class="rounded-lg border border-line bg-white p-4"
                         @key="ruta.Id">

                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <p class="text-xs font-medium text-slate-500">
                                Ruta #@ruta.Id
                            </p>
                            <h2 class="mt-0.5 text-base font-semibold text-slate-900">
                                @ruta.Nombre
                            </h2>
                        </div>

                        <span class="rounded border border-violet-200 bg-violet-50 px-1.5 py-0.5 text-xs font-medium text-violet-700">
                            @ruta.Estado
                        </span>
                    </div>

                    <div class="mt-3 space-y-1.5 text-sm text-slate-600">
                        <p class="flex items-center gap-2"><Icono Nombre="calendario" Clase="h-4 w-4 text-slate-400" /> @ruta.Fecha.ToString("dd/MM/yyyy")</p>
                        <p class="flex items-center gap-2"><Icono Nombre="camion" Clase="h-4 w-4 text-slate-400" /> @ruta.Vehiculo</p>
                        <p class="flex items-center gap-2"><Icono Nombre="pin" Clase="h-4 w-4 text-slate-400" /> @ruta.CantidadParadas paradas</p>
                    </div>

                    <button type="button"
                            class="boton boton-principal mt-4"
                            @onclick="() => VerRuta(ruta.Id)">
                        Ver hoja de ruta
                    </button>
                </article>
            }
        }
    </main>
</div>

@code {
    private List<RutaResumenDto> rutas = [];
    private bool cargando = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            rutas = await RutasService.ObtenerMisRutasAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception)
        {
            error = "No se pudieron cargar las rutas. Comprobá tu conexión.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void VerRuta(int id)
    {
        Navigation.NavigateTo($"/rutas/{id}");
    }

    private void Volver()
    {
        Navigation.NavigateTo("/");
    }
    
}
