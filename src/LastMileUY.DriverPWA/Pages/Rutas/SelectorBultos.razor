@using LastMileUY.Contracts.Rutas
@using LastMileUY.DriverPWA.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="mt-4 w-full min-w-0 max-w-2xl rounded-lg border border-line bg-white p-3 sm:p-4">

    <div class="mb-4 flex min-w-0 items-start justify-between gap-2">
        <div class="min-w-0 flex-1">
            <h3 class="text-sm font-semibold leading-tight text-slate-900">
                Identificar bultos
            </h3>

            <p class="mt-0.5 text-xs leading-relaxed text-slate-500">
                Escaneá o ingresá el código de cada bulto.
            </p>
        </div>

        <span class="shrink-0 rounded border border-line px-1.5 py-0.5 text-xs font-medium text-slate-600 tabular-nums">
            @identificados.Count / @Bultos.Count
        </span>
    </div>

    <div class="space-y-3">

        <div class="flex min-w-0 flex-col gap-2 sm:flex-row">
            <input type="text"
                   class="campo min-w-0 sm:flex-1"
                   placeholder="Código del bulto"
                   @bind="codigo"
                   @bind:event="oninput"
                   @onkeydown="AlPresionarTecla" />

            <button type="button"
                    class="boton boton-principal shrink-0 sm:w-auto"
                    @onclick="Identificar">
                Buscar
            </button>
        </div>

        @if (!camaraActiva)
        {
            <button type="button"
                    class="boton boton-secundario"
                    @onclick="AbrirCamara">
                <Icono Nombre="escaner" Clase="h-4 w-4 text-slate-500" />
                Escanear con cámara
            </button>
        }
        else
        {
            <div class="w-full min-w-0 max-w-full overflow-hidden rounded-md border border-line bg-slate-950 p-1 sm:p-2">
                <div id="@idEscaner" class="w-full min-w-0 max-w-full overflow-hidden"></div>
            </div>

            <button type="button"
                    class="boton border border-red-200 bg-white text-red-700"
                    @onclick="CerrarCamara">
                Cancelar escaneo
            </button>
        }

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div role="alert"
                 class="aviso aviso-alerta mt-3 text-sm">
                @error
            </div>
        }
    </div>

    <div class="my-4 border-t border-line"></div>

    <div class="space-y-2">
        @foreach (var bulto in Bultos)
        {
            var identificado = identificados.Contains(bulto.Id);
            var pendiente = ResultadoPorBulto.PorEntregar(bulto);

            <div @key="bulto.Id"
                 class="flex w-full min-w-0 flex-wrap items-center justify-between gap-2 rounded-md border px-3 py-2.5 @(identificado ? "border-emerald-200 bg-emerald-50/60" : "border-line bg-white")">

                <div class="flex min-w-0 items-center gap-3">
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md @(identificado ? "text-emerald-600" : "text-slate-400")">
                        <Icono Nombre="paquete" Clase="h-5 w-5" />
                    </div>

                    <div class="min-w-0">
                        <div class="font-mono text-[13px] font-medium text-slate-900 [overflow-wrap:anywhere]">
                            @bulto.Codigo
                        </div>

                        @if (!string.IsNullOrWhiteSpace(bulto.Descripcion))
                        {
                            <div class="mt-0.5 text-xs text-slate-500">
                                @bulto.Descripcion
                            </div>
                        }

                        <div class="mt-1 text-xs @(pendiente ? "text-amber-700" : "text-slate-500")">
                            @bulto.Estado
                        </div>
                    </div>
                </div>

                @if (identificado)
                {
                    <span class="inline-flex shrink-0 items-center gap-1 text-xs font-medium text-emerald-700">
                        <Icono Nombre="check" Clase="h-3.5 w-3.5" /> Identificado
                    </span>
                }
            </div>
        }
    </div>

    <div class="mt-4">
        <div class="mb-2 flex justify-between text-xs font-medium text-slate-500">
            <span>Progreso de identificación</span>
            <span>@identificados.Count de @Bultos.Count</span>
        </div>

        <div class="h-1.5 overflow-hidden rounded-full bg-slate-100">
            <div class="h-full rounded-full bg-violet-600 transition-[width]"
                 style="width:@(Bultos.Count == 0 ? 0 : identificados.Count * 100 / Bultos.Count)%">
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<BultoRutaDto> Bultos { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyList<int>> OnCambio { get; set; }
    
    [Parameter]
    public IReadOnlyList<int> Identificados { get; set; } = [];

    private readonly string idEscaner = $"escaner-{Guid.NewGuid():N}";

    private string codigo = "";
    private string? error;
    private bool camaraActiva;
    private bool iniciarCamaraPendiente;

    private readonly HashSet<int> identificados = [];
    private DotNetObjectReference<SelectorBultos>? referenciaDotNet;
    
    protected override void OnParametersSet()
    {
        var idsValidos = Bultos
            .Where(ResultadoPorBulto.PorEntregar)
            .Select(b => b.Id)
            .ToHashSet();

        identificados.Clear();

        foreach (var id in Identificados)
        {
            if (idsValidos.Contains(id))
                identificados.Add(id);
        }
    }

    private async Task AlPresionarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Identificar();
    }

    private async Task Identificar()
    {
        error = null;

        var bulto = Bultos.FirstOrDefault(b =>
            string.Equals(
                b.Codigo,
                codigo.Trim(),
                StringComparison.OrdinalIgnoreCase));

        if (bulto is null)
        {
            error = "No se encontró ese bulto en esta parada.";
            return;
        }

        if (!ResultadoPorBulto.PorEntregar(bulto))
        {
            error = "Este bulto no está pendiente de entrega.";
            return;
        }

        if (!identificados.Add(bulto.Id))
        {
            error = "Este bulto ya fue identificado.";
            return;
        }

        codigo = "";
        await OnCambio.InvokeAsync(identificados.ToArray());
    }

    private Task AbrirCamara()
    {
        error = null;
        camaraActiva = true;
        iniciarCamaraPendiente = true;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!iniciarCamaraPendiente || !camaraActiva)
            return;

        iniciarCamaraPendiente = false;
        referenciaDotNet ??= DotNetObjectReference.Create(this);

        try
        {
            await JS.InvokeVoidAsync(
                "lastMileEscaner.iniciar",
                idEscaner,
                referenciaDotNet);
        }
        catch (JSException)
        {
            await CerrarCamara();

            error = "No se pudo abrir la cámara. Revisá los permisos o ingresá el código manualmente.";

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CerrarCamara()
    {
        iniciarCamaraPendiente = false;

        try
        {
            await JS.InvokeVoidAsync("lastMileEscaner.detener", idEscaner);
        }
        catch (JSException)
        {
        }

        camaraActiva = false;
    }

    [JSInvokable]
    public Task EscanerCerrado() =>
        InvokeAsync(() =>
        {
            iniciarCamaraPendiente = false;
            camaraActiva = false;
            StateHasChanged();
        });

    [JSInvokable]
    public async Task CodigoEscaneado(string valor)
    {
        await InvokeAsync(async () =>
        {
            camaraActiva = false;
            codigo = valor;
            await Identificar();
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("lastMileEscaner.detener", idEscaner);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }

        referenciaDotNet?.Dispose();
    }
}
