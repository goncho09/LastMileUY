@page "/operaciones"
@using LastMileUY.Contracts.Sincronizacion
@using LastMileUY.DriverPWA.Services
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject SincronizacionService Sincronizacion
@inject ColaOperacionesService Cola
@inject NavigationManager Navigation

<PageTitle>Mis operaciones | LastMileUY</PageTitle>

<div class="min-h-dvh bg-canvas pb-24">

    <header class="bg-violet-700 px-5 pb-6 pt-5 text-white">
        <div class="mx-auto max-w-2xl">
            <button type="button" class="mb-4 text-sm text-violet-100" @onclick="@(() => Navigation.NavigateTo("/"))">
                ← Volver al inicio
            </button>

            <h1 class="text-xl font-semibold">Mis operaciones</h1>
            <p class="mt-1 text-sm text-violet-200">
                Entregas e intentos que registraste y cómo quedaron
            </p>
        </div>
    </header>

    <main class="mx-auto max-w-2xl space-y-4 px-4 pt-6">

        @if (pendientes.Count > 0)
        {
            <section class="rounded-lg border border-amber-200 bg-amber-50 p-4" aria-labelledby="titulo-pendientes">
                <h2 id="titulo-pendientes" class="font-semibold text-amber-900">
                    Sin enviar (@pendientes.Count)
                </h2>
                
                <button type="button"
                        disabled="@sincronizando"
                        @onclick="SincronizarAsync"
                        class="mt-3 rounded-md bg-amber-800 px-4 py-2 text-sm font-medium text-white disabled:opacity-50">
                    @(sincronizando ? "Sincronizando..." : "Sincronizar pendientes")
                </button>
                
                <p class="mt-1 text-sm text-amber-800">
                    Están guardadas en este celular y todavía no llegaron al servidor. No cierres sesión: se perderían.
                </p>

                <ul class="mt-4 space-y-2">
                    @foreach (var pendiente in pendientes)
                    {
                        <li class="flex items-center justify-between gap-3 rounded-md border border-amber-100 bg-white px-3 py-2.5" @key="pendiente.IdOperacion">
                            <div>
                                <p class="text-xs font-medium text-amber-700">
                                    @(pendiente.Tipo == "Entrega" ? "Entrega" : "Intento fallido") · Ruta #@pendiente.RutaId
                                </p>
                                <p class="font-semibold text-slate-900">Envío @pendiente.EnvioId</p>
                            </div>
                            <p class="text-xs text-slate-500">
                                @pendiente.FechaHoraDispositivo.ToLocalTime().ToString("dd/MM HH:mm")
                            </p>
                        </li>
                    }
                </ul>
            </section>
        }
        
        @if (mensajeSincronizacion is not null)
        {
            <div role="status"
                 class="aviso aviso-info text-sm">
                @mensajeSincronizacion
            </div>
        }

        <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por resultado">
            @foreach (var (valor, texto) in Filtros)
            {
                <button type="button" @key="texto" aria-pressed="@(filtro == valor)"
                        class="@(filtro == valor ? "rounded-md bg-violet-700 px-3 py-1.5 text-sm font-medium text-white" : "rounded-md border border-line bg-white px-3 py-1.5 text-sm font-medium text-slate-600")"
                        @onclick="() => FiltrarAsync(valor)">
                    @texto
                </button>
            }
        </div>

        @if (error is not null)
        {
            <div class="aviso aviso-error text-sm">
                @error
            </div>
        }

        @if (historialNoDisponible)
        {
            <div role="status"
                 class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-amber-900">
                <h2 class="font-semibold">Historial no disponible sin conexión</h2>
                <p class="mt-2 text-sm">
                    Las operaciones pendientes siguen guardadas en este dispositivo.
                    El historial del servidor se actualizará cuando recuperes la conexión.
                </p>
            </div>
        }
        else if (cargando && operaciones.Count == 0)
        {
            <p class="text-center text-slate-500">Cargando operaciones...</p>
        }
        else if (operaciones.Count == 0 && !historialNoDisponible)
        {
            <div class="rounded-lg border border-line bg-white p-8 text-center">
                <h2 class="font-semibold text-slate-800">No hay operaciones</h2>
                <p class="mt-2 text-sm text-slate-500">
                    @(filtro is null
                        ? "Las entregas e intentos que registres aparecen acá."
                        : "No tenés operaciones con ese resultado.")
                </p>
            </div>
        }
        else if (operaciones.Count > 0)
        {
            <p class="text-sm font-medium text-slate-500">@total @(total == 1 ? "operación" : "operaciones")</p>

            @foreach (var operacion in operaciones)
            {
                <article class="rounded-lg border border-line bg-white p-4" @key="operacion.IdOperacion">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <p class="text-xs font-medium text-slate-500">
                                @(operacion.Tipo == "Entrega" ? "Entrega" : "Intento fallido") · Ruta #@operacion.RutaId
                            </p>
                            <h2 class="mt-1 font-semibold text-slate-900">
                                @(operacion.CodigoSeguimiento ?? $"Envío {operacion.EnvioId}")
                            </h2>
                        </div>

                        <span class="@Estilo(operacion.Resultado)">@Texto(operacion.Resultado)</span>
                    </div>

                    @if (operacion.Resultado != "Aplicada")
                    {
                        <p class="mt-3 text-sm text-slate-700">@operacion.Mensaje</p>
                    }

                    <p class="mt-3 text-xs text-slate-500">
                        Registrada el @operacion.FechaHoraDispositivo.ToLocalTime().ToString("dd/MM HH:mm")
                    </p>
                </article>
            }

            @if (operaciones.Count < total)
            {
                <button type="button" disabled="@cargando"
                        class="boton boton-secundario"
                        @onclick="() => CargarMasAsync()">
                    @(cargando ? "Cargando..." : "Ver más")
                </button>
            }
        }
    </main>
</div>

@code {
    private static readonly (string? Valor, string Texto)[] Filtros =
    [
        (null, "Todas"),
        ("Aplicada", "Registradas"),
        ("Rechazada", "Rechazadas"),
        ("Conflicto", "En conflicto")
    ];
    private readonly SemaphoreSlim bloqueoSincronizacion = new(1, 1);
    private readonly List<OperacionSincronizadaDto> operaciones = [];
    private List<OperacionRequest> pendientes = [];
    
    private IJSObjectReference? moduloConexion;
    private IJSObjectReference? detectorConexion;
    private DotNetObjectReference<Operaciones>? referenciaDotNet;
    
    private string? filtro;
    private string? error;
    private string? mensajeSincronizacion;
    
    private int pagina;
    private int total;
    
    private bool cargando;
    private bool sincronizando;
    private bool componenteDestruido;
    private bool historialNoDisponible;
    
    protected override async Task OnInitializedAsync()
    {
        pendientes = (await Cola.ObtenerPendientesAsync())
            .OrderBy(p => p.FechaHoraDispositivo)
            .ToList();

        await FiltrarAsync(null);
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (!firstRender)
        return;

    moduloConexion = await JS.InvokeAsync<IJSObjectReference>(
        "import", "./js/conexion.js");

    referenciaDotNet = DotNetObjectReference.Create(this);

    detectorConexion = await moduloConexion.InvokeAsync<IJSObjectReference>(
        "escucharConexion", referenciaDotNet);

    await SincronizarAsync();
    
    if (historialNoDisponible)
    {
        await InvokeAsync(StateHasChanged);
    }
}

    [JSInvokable]
    public async Task ConexionRestablecida()
    {
        if (componenteDestruido)
            return;

        await SincronizarAsync();

        if (!componenteDestruido && !cargando)
        {
            await FiltrarAsync(filtro);
            await InvokeAsync(StateHasChanged);
        }
    }

private async Task SincronizarAsync()
{
    if (componenteDestruido)
        return;

    if (!await bloqueoSincronizacion.WaitAsync(0))
        return;

    try
    {
        sincronizando = true;
        mensajeSincronizacion = null;
        await InvokeAsync(StateHasChanged);

        var resultado = await Sincronizacion.SincronizarPendientesAsync();

        pendientes = (await Cola.ObtenerPendientesAsync())
            .OrderBy(p => p.FechaHoraDispositivo)
            .ToList();

        if (resultado.Enviadas > 0)
        {
            mensajeSincronizacion =
                $"Se procesaron {resultado.Enviadas} operaciones. " +
                $"Quedan {resultado.Pendientes} pendientes.";

            await FiltrarAsync(filtro);
        }
        else if (resultado.Pendientes > 0)
        {
            mensajeSincronizacion =
                "No se pudieron sincronizar las operaciones. " +
                "Se mantienen guardadas para reintentar.";
        }
    }
    catch (UnauthorizedAccessException)
    {
        mensajeSincronizacion =
            "Tu sesión expiró. Iniciá sesión para sincronizar.";
    }
    catch (Exception ex) when (
        ex is HttpRequestException or
        TaskCanceledException or
        InvalidOperationException)
    {
        mensajeSincronizacion =
            "No se pudo completar la sincronización. " +
            "Las operaciones pendientes siguen guardadas.";
    }
    finally
    {
        sincronizando = false;
        bloqueoSincronizacion.Release();

        if (!componenteDestruido)
            await InvokeAsync(StateHasChanged);
    }
}

public async ValueTask DisposeAsync()
{
    componenteDestruido = true;

    try
    {
        if (detectorConexion is not null)
            await detectorConexion.InvokeVoidAsync("dispose");

        if (detectorConexion is not null)
            await detectorConexion.DisposeAsync();

        if (moduloConexion is not null)
            await moduloConexion.DisposeAsync();
    }
    catch (JSDisconnectedException)
    {
    }

    referenciaDotNet?.Dispose();
}

private async Task FiltrarAsync(string? resultado)
{
    if (cargando)
        return;

    filtro = resultado;
    pagina = 0;
    total = 0;

    await CargarMasAsync(reemplazar: true);
}

private async Task CargarMasAsync(bool reemplazar = false)
{
    if (cargando)
        return;

    cargando = true;
    error = null;

    try
    {
        var paginaSolicitada = reemplazar ? 1 : pagina + 1;

        var siguiente = await Sincronizacion.ObtenerMisOperacionesAsync(
            filtro,
            paginaSolicitada);

        if (reemplazar)
            operaciones.Clear();

        operaciones.AddRange(siguiente.Items);

        pagina = siguiente.Pagina;
        total = siguiente.Total;

        historialNoDisponible = false;
    }
    catch (UnauthorizedAccessException)
    {
        Navigation.NavigateTo("/login");
    }
    catch (Exception ex) when (
        ex is HttpRequestException or TaskCanceledException)
    {
        historialNoDisponible = true;
    }
    finally
    {
        cargando = false;
    }
}

    private static string Texto(string resultado) => resultado switch
    {
        "Aplicada" => "Registrada",
        "Conflicto" => "En conflicto",
        _ => resultado
    };

    private static string Estilo(string resultado) => resultado switch
    {
        "Aplicada" => "rounded border border-emerald-200 bg-emerald-50 px-1.5 py-0.5 text-xs font-medium text-emerald-700",
        "Rechazada" => "rounded border border-red-200 bg-red-50 px-1.5 py-0.5 text-xs font-medium text-red-700",
        "Conflicto" => "rounded border border-amber-200 bg-amber-50 px-1.5 py-0.5 text-xs font-medium text-amber-700",
        _ => "rounded border border-slate-200 bg-slate-50 px-1.5 py-0.5 text-xs font-medium text-slate-700"
    };
}
