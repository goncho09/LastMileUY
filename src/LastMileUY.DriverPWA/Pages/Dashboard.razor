
@page "/"
@using LastMileUY.DriverPWA.Services
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject ColaOperacionesService Cola

<PageTitle>Mi jornada | LastMileUY</PageTitle>
@if (comprobandoSesion)
{
    <div class="p-4 text-center text-sm text-slate-500">
        Comprobando sesión...
    </div>
}
else
{
    <div class="min-h-dvh bg-canvas pb-24">

        <header class="bg-violet-700 px-5 pb-14 pt-6 text-white">

            <div class="mx-auto max-w-2xl">

                <div class="flex items-center justify-between gap-3">

                    <div class="flex items-center gap-3">
                        <div class="flex h-9 w-9 items-center justify-center rounded-md bg-white/12">
                            <Icono Nombre="camion" Clase="h-5 w-5" />
                        </div>

                        <div>
                            <p class="text-xs font-medium text-violet-200">
                                LastMileUY
                            </p>
                            <h1 class="text-lg leading-tight font-semibold">
                                Mi jornada
                            </h1>
                        </div>
                    </div>

                    <button type="button"
                            @onclick="CerrarSesion"
                            disabled="@cerrandoSesion"
                            class="flex items-center gap-2 rounded-md border border-white/25 px-3 py-1.5 text-sm font-medium transition-colors active:bg-white/10 disabled:opacity-50">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                            <polyline points="16 17 21 12 16 7"/>
                            <line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>

                        <span>@(cerrandoSesion ? "Saliendo..." : "Salir")</span>
                    </button>

                </div>

                <div class="mt-8">
                    <p class="text-sm text-violet-200">Panel del repartidor</p>
                    <h2 class="mt-1 text-2xl font-semibold">
                        ¡Buen viaje!
                    </h2>
                    <p class="mt-1 text-sm text-violet-100">
                        Organizá tus entregas y seguí tu jornada.
                    </p>
                </div>

            </div>
        </header>

        <main class="mx-auto -mt-8 max-w-2xl space-y-6 px-4">

            @if (errorSesion is not null)
            {
                <div class="aviso aviso-error text-sm">
                    @errorSesion
                </div>
            }

            <section class="rounded-lg border border-line bg-white p-5">

                <div class="flex items-start gap-4">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-violet-200 bg-violet-50 text-violet-700">
                        <Icono Nombre="ruta" Clase="h-5 w-5" />
                    </div>

                    <div class="flex-1">
                        <p class="text-xs font-medium text-slate-500">
                            Tu trabajo
                        </p>

                        <h3 class="mt-0.5 text-lg font-semibold text-slate-900">
                            Mis rutas
                        </h3>

                        <p class="mt-1 text-sm leading-relaxed text-slate-500">
                            Consultá tus recorridos, paradas y entregas asignadas.
                        </p>
                    </div>
                </div>

                <button type="button"
                        @onclick="IrARutas"
                        class="boton boton-principal mt-5">

                    Ver mis rutas

                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14"/>
                        <path d="m12 5 7 7-7 7"/>
                    </svg>
                </button>

            </section>

            <section>
                <div class="mb-3 flex items-center justify-between">
                    <h3 class="text-sm font-semibold text-slate-900">
                        Resumen de hoy
                    </h3>
                    <span class="text-xs font-medium text-slate-500">
                        Mi actividad
                    </span>
                </div>

                <div class="grid grid-cols-2 gap-3">

                    <div class="rounded-lg border border-line bg-white p-4">
                        <div class="flex items-center gap-2 text-slate-500">
                            <Icono Nombre="paquete" Clase="h-4 w-4" />
                            <p class="text-sm">Asignadas</p>
                        </div>
                        <p class="mt-2 text-2xl font-semibold text-slate-900">—</p>
                    </div>

                    <div class="rounded-lg border border-line bg-white p-4">
                        <div class="flex items-center gap-2 text-slate-500">
                            <Icono Nombre="check" Clase="h-4 w-4 text-emerald-600" />
                            <p class="text-sm">Completadas</p>
                        </div>
                        <p class="mt-2 text-2xl font-semibold text-slate-900">—</p>
                    </div>

                    <div class="rounded-lg border border-line bg-white p-4">
                        <div class="flex items-center gap-2 text-slate-500">
                            <Icono Nombre="reloj" Clase="h-4 w-4 text-amber-600" />
                            <p class="text-sm">Pendientes</p>
                        </div>
                        <p class="mt-2 text-2xl font-semibold text-slate-900">—</p>
                    </div>

                    <div class="rounded-lg border border-line bg-white p-4">
                        <div class="flex items-center gap-2 text-slate-500">
                            <Icono Nombre="sync" Clase="h-4 w-4 text-violet-600" />
                            <p class="text-sm">Sin sincronizar</p>
                        </div>
                        <p class="mt-2 text-2xl font-semibold text-slate-900">—</p>
                    </div>

                </div>
            </section>
        </main>

        <nav class="fixed bottom-0 left-0 right-0 z-20 border-t border-line bg-white px-4 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))]">

            <div class="mx-auto flex max-w-md items-center justify-around">

                <div class="flex min-w-16 flex-col items-center gap-0.5 py-1 text-violet-700">
                    <Icono Nombre="inicio" Clase="h-5 w-5" />
                    <span class="text-xs font-medium">Inicio</span>
                </div>

                <button type="button"
                        @onclick="IrARutas"
                        class="flex min-w-16 flex-col items-center gap-0.5 py-1 text-slate-500 transition-colors active:text-violet-700">
                    <Icono Nombre="camion" Clase="h-5 w-5" />
                    <span class="text-xs font-medium">Rutas</span>
                </button>

                <button type="button"
                        @onclick="@(() => Navigation.NavigateTo("/operaciones"))"
                        class="flex min-w-16 flex-col items-center gap-0.5 py-1 text-slate-500 transition-colors active:text-violet-700">
                    <Icono Nombre="sync" Clase="h-5 w-5" />
                    <span class="text-xs font-medium">Operaciones</span>
                </button>

            </div>

        </nav>

    </div>
}

@code {
    private bool cerrandoSesion;
    private bool comprobandoSesion = true;
    
    private string? errorSesion;
    
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var usuario = await AuthService.ObtenerUsuarioAsync();

            if (usuario is null)
            {
                Navigation.NavigateTo("/login", replace: true);
                return;
            }
        }
        catch (HttpRequestException)
        {
        }
        catch (TaskCanceledException)
        {
        }
        finally
        {
            comprobandoSesion = false;
        }
    }

    private void IrARutas()
    {
        Navigation.NavigateTo("/rutas");
    }

    private async Task CerrarSesion()
    {
        if (cerrandoSesion)
            return;

        cerrandoSesion = true;
        errorSesion = null;

        try
        {
            await AuthService.LogoutAsync();

            Navigation.NavigateTo("/login", replace: true);
        }
        catch (InvalidOperationException ex)
        {
            errorSesion = ex.Message;
        }
        catch (Exception)
        {
            errorSesion = "No se pudo cerrar la sesión. Intentá nuevamente.";
        }
        finally
        {
            cerrandoSesion = false;
        }
    }
}
