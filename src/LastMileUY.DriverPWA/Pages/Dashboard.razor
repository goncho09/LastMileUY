
@page "/"
@using LastMileUY.DriverPWA.Services
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Mi jornada | LastMileUY</PageTitle>

<div class="min-h-dvh bg-[#f5f3fb] pb-28">

    <!-- HEADER -->
    <header class="relative overflow-hidden bg-gradient-to-br from-violet-800 via-violet-700 to-indigo-700 px-5 pb-16 pt-8 text-white">

        <div class="pointer-events-none absolute -right-16 -top-20 h-56 w-56 rounded-full bg-white/10"></div>
        <div class="pointer-events-none absolute -bottom-24 -left-16 h-48 w-48 rounded-full bg-indigo-400/20"></div>

        <div class="relative mx-auto max-w-4xl">

            <div class="flex items-center justify-between gap-3">

                <div class="flex items-center gap-3">
                    <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-white/15 text-xl">
                        🚚
                    </div>

                    <div>
                        <p class="text-xs font-semibold uppercase tracking-widest text-violet-200">
                            LastMileUY
                        </p>
                        <h1 class="text-xl font-bold">
                            Mi jornada
                        </h1>
                    </div>
                </div>

                <button type="button"
                        @onclick="CerrarSesion"
                        disabled="@cerrandoSesion"
                        class="flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-3 py-2 text-sm font-medium transition hover:bg-white/20 disabled:opacity-50">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>

                    <span>@(cerrandoSesion ? "Saliendo..." : "Salir")</span>
                </button>

            </div>

            <div class="mt-9">
                <p class="text-sm text-violet-200">Panel del repartidor</p>
                <h2 class="mt-1 text-3xl font-bold tracking-tight">
                    ¡Buen viaje! 👋
                </h2>
                <p class="mt-2 text-sm text-violet-100">
                    Organizá tus entregas y seguí tu jornada.
                </p>
            </div>

        </div>
    </header>

    <main class="relative mx-auto -mt-9 max-w-4xl space-y-7 px-4">

        @if (errorSesion is not null)
        {
            <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                @errorSesion
            </div>
        }

        <!-- ACCESO PRINCIPAL -->
        <section class="rounded-3xl border border-violet-100 bg-white p-5 shadow-lg shadow-violet-900/5">

            <div class="flex items-start gap-4">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-violet-100 text-3xl">
                    📍
                </div>

                <div class="flex-1">
                    <p class="text-xs font-semibold uppercase tracking-wider text-violet-600">
                        Tu trabajo
                    </p>

                    <h3 class="mt-1 text-xl font-bold text-slate-900">
                        Mis rutas
                    </h3>

                    <p class="mt-2 text-sm leading-relaxed text-slate-500">
                        Consultá tus recorridos, paradas y entregas asignadas.
                    </p>
                </div>
            </div>

            <button type="button"
                    @onclick="IrARutas"
                    class="mt-6 flex w-full items-center justify-center gap-2 rounded-2xl bg-violet-700 px-5 py-4 font-semibold text-white shadow-md shadow-violet-700/20 transition hover:bg-violet-800">

                Ver mis rutas

                <svg xmlns="http://www.w3.org/2000/svg"
                     width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M5 12h14"/>
                    <path d="m12 5 7 7-7 7"/>
                </svg>
            </button>

        </section>

        <!-- RESUMEN -->
        <section>
            <div class="mb-4 flex items-center justify-between">
                <h3 class="text-lg font-bold text-slate-900">
                    Resumen de hoy
                </h3>
                <span class="rounded-full bg-violet-100 px-3 py-1 text-xs font-medium text-violet-700">
                    Mi actividad
                </span>
            </div>

            <div class="grid grid-cols-2 gap-3">

                <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                    <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-violet-100 text-xl">
                        📦
                    </div>
                    <p class="text-3xl font-bold text-slate-900">—</p>
                    <p class="mt-1 text-sm text-slate-500">Asignadas</p>
                </div>

                <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                    <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-100 text-xl">
                        ✓
                    </div>
                    <p class="text-3xl font-bold text-emerald-600">—</p>
                    <p class="mt-1 text-sm text-slate-500">Completadas</p>
                </div>

                <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                    <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-amber-100 text-xl">
                        ◷
                    </div>
                    <p class="text-3xl font-bold text-amber-600">—</p>
                    <p class="mt-1 text-sm text-slate-500">Pendientes</p>
                </div>

                <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                    <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-100 text-xl">
                        ↻
                    </div>
                    <p class="text-3xl font-bold text-indigo-600">—</p>
                    <p class="mt-1 text-sm text-slate-500">Sin sincronizar</p>
                </div>

            </div>
        </section>

        <!-- SINCRONIZACION -->
        <section class="rounded-2xl border border-indigo-100 bg-indigo-50 p-5">

            <div class="flex items-start gap-3">

                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-100 text-xl">
                    🔄
                </div>

                <div>
                    <h3 class="font-bold text-slate-900">
                        Sincronización offline
                    </h3>

                    <p class="mt-1 text-sm leading-relaxed text-slate-600">
                        Próximamente vas a poder registrar entregas sin conexión
                        y sincronizarlas cuando recuperes internet.
                    </p>

                    <span class="mt-3 inline-block rounded-lg bg-white px-3 py-1 text-xs font-semibold text-indigo-600">
                        Pendiente de implementar
                    </span>
                </div>

            </div>

        </section>

    </main>

    <!-- NAVEGACION INFERIOR -->
    <nav class="fixed bottom-0 left-0 right-0 z-20 border-t border-slate-200 bg-white/95 px-4 py-3 shadow-lg backdrop-blur">

        <div class="mx-auto flex max-w-md items-center justify-around">

            <div class="flex flex-col items-center gap-1 text-violet-700">
                <span class="text-2xl">⌂</span>
                <span class="text-xs font-bold">Inicio</span>
            </div>

            <button type="button"
                    @onclick="IrARutas"
                    class="flex flex-col items-center gap-1 text-slate-500 transition hover:text-violet-700">
                <span class="text-xl">🚚</span>
                <span class="text-xs font-medium">Rutas</span>
            </button>

            <div class="flex flex-col items-center gap-1 text-slate-400">
                <span class="text-xl">↻</span>
                <span class="text-xs font-medium">Sincronizar</span>
            </div>

        </div>

    </nav>

</div>

@code {
    private bool cerrandoSesion;
    private string? errorSesion;

    private void IrARutas()
    {
        Navigation.NavigateTo("/rutas");
    }

    private async Task CerrarSesion()
    {
        if (cerrandoSesion)
            return;

        cerrandoSesion = true;
        errorSesion = null;

        try
        {
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/login", replace: true);
        }
        catch (Exception)
        {
            errorSesion = "No se pudo cerrar la sesión. Intentá nuevamente.";
        }
        finally
        {
            cerrandoSesion = false;
        }
    }
}
