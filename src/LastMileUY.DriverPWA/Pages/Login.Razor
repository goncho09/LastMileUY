
@page "/login"
@using LastMileUY.DriverPWA.Services
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión | LastMileUY</PageTitle>

<div class="flex min-h-dvh items-center justify-center bg-canvas px-4 py-8 sm:px-6">

    <main class="w-full max-w-md rounded-lg border border-line bg-white p-6 sm:p-8">

        <div class="mb-8 flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-md bg-violet-700 text-white">
                <Icono Nombre="paquete" Clase="h-5 w-5" />
            </div>

            <div>
                <div class="text-lg font-semibold text-slate-900">
                    LastMile<span class="text-violet-700">UY</span>
                </div>
                <p class="text-xs font-medium text-slate-500">
                    Portal de repartidores
                </p>
            </div>
        </div>

        <div class="mb-8">
            <h1 class="mb-2 text-2xl font-semibold tracking-tight text-slate-900">
                Iniciar turno
            </h1>

            <p class="text-sm leading-6 text-slate-500">
                Accedé con tus credenciales para consultar tus recorridos
                y paquetes del día.
            </p>
        </div>

        <form @onsubmit="IniciarSesion"
              @onsubmit:preventDefault="true"
              class="space-y-5">

            <div>
                <label for="email"
                       class="etiqueta">
                    Correo electrónico
                </label>

                <input id="email"
                       type="email"
                       autocomplete="username"
                       placeholder="nombre@ejemplo.com"
                       @bind="email"
                       required
                       class="campo" />
            </div>

            <div>
                <label for="password"
                       class="etiqueta">
                    Contraseña
                </label>

                <div class="relative">
                    <input id="password"
                           type="@(mostrarPassword ? "text" : "password")"
                           autocomplete="current-password"
                           placeholder="Ingresá tu contraseña"
                           @bind="password"
                           required
                           class="campo pr-12" />

                    <button type="button"
                            @onclick="() => mostrarPassword = !mostrarPassword"
                            class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 active:text-violet-700">

                        @if (mostrarPassword)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="20" height="20"
                                 viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M3 3l18 18"/>
                                <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/>
                                <path d="M9.9 5.1A10.9 10.9 0 0 1 12 5c7 0 10 7 10 7a13.4 13.4 0 0 1-4 4.9"/>
                                <path d="M6.6 6.6C3.6 8.4 2 12 2 12s3 7 10 7c1.7 0 3.2-.4 4.5-1"/>
                            </svg>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="20" height="20"
                                 viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        }
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div role="alert"
                     class="aviso aviso-error text-sm">
                    @error
                </div>
            }

            <button type="submit"
                    disabled="@cargando"
                    class="boton boton-principal mt-2 disabled:cursor-wait">
                @(cargando ? "Ingresando..." : "Iniciar sesión")
            </button>
        </form>

        <p class="mt-6 text-center text-xs text-slate-400">
            © 2026 LastMileUY
        </p>
    </main>
</div>

@code {
    private string email = "";
    private string password = "";
    private string error = "";
    private bool cargando;
    private bool mostrarPassword;

    private void AlternarPassword()
    {
        mostrarPassword = !mostrarPassword;
    }

    private async Task IniciarSesion()
    {
        if (cargando)
            return;

        cargando = true;
        error = "";

        try
        {
            bool correcto = await Auth.LoginAsync(email, password);

            if (correcto)
                Navigation.NavigateTo("/");
            else
                error = "Correo o contraseña incorrectos.";
        }
        catch (Exception)
        {
            error = "No se pudo conectar con el servidor.";
        }
        finally
        {
            cargando = false;
        }
    }
}
