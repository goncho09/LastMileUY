
@page "/envios/nuevo"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using LastMileUY.CommercePortal.Servicios
@using LastMileUY.Contracts.Envios
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using DestinatarioDto = LastMileUY.Contracts.Destinatarios.DestinatarioDto
@using DireccionDto = LastMileUY.Contracts.Destinatarios.DireccionDto

@inject IDestinatariosApi DestinatariosApi
@inject IEnviosApi EnviosApi
@inject NavigationManager Navegacion
@inject ILogger<Nuevo> Logger

<PageTitle>Nuevo envío | LastMileUY</PageTitle>

<div class="space-y-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-violet-500/25 bg-violet-500/10 px-3 py-1 text-xs font-semibold text-violet-300">
                Portal de Comercios
            </div>
            <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Nuevo envío</h1>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-400">
                Completá los datos de entrega y los bultos para registrar un nuevo envío.
            </p>
        </div>
        <a href="/" class="inline-flex items-center rounded-xl border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-medium text-slate-300 transition hover:border-white/20 hover:text-white">
            ← Volver al inicio
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(operadorNombre))
    {
        <div class="flex flex-wrap items-center gap-2 rounded-xl border border-violet-500/20 bg-violet-500/[0.06] px-4 py-3 text-sm">
            <span class="text-slate-400">Operador logístico:</span>
            <span class="font-semibold text-violet-200">@operadorNombre</span>
        </div>
    }

    @if (creado is not null)
    {
        <section class="rounded-2xl border border-emerald-500/25 bg-[#111d23] p-6 shadow-xl shadow-black/10 sm:p-8" role="status">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-500/15 text-2xl text-emerald-300">✓</div>
            <h2 class="text-2xl font-bold text-white">¡Envío creado!</h2>
            <p class="mt-2 text-sm text-slate-400">El envío se registró correctamente.</p>

            <div class="mt-6 grid gap-4 rounded-xl border border-white/10 bg-black/20 p-5 sm:grid-cols-2">
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-500">Código de seguimiento</p>
                    <p class="mt-1 break-all text-xl font-bold text-violet-300">@creado.CodigoSeguimiento</p>
                </div>
                <div>
                    <p class="text-xs uppercase tracking-wide text-slate-500">Estado</p>
                    <p class="mt-1 font-semibold text-white">@creado.Estado</p>
                </div>
                <div class="sm:col-span-2">
                    <p class="text-xs uppercase tracking-wide text-slate-500">Fecha de creación</p>
                    <p class="mt-1 text-sm text-slate-200">@creado.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>

            <button type="button" @onclick="NuevoEnvio"
                    class="mt-6 inline-flex items-center justify-center rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-violet-500">
                + Crear otro envío
            </button>
        </section>
    }
    else if (destinatarios is null)
    {
        <div class="rounded-2xl border border-white/10 bg-[#131a2a] p-8 text-sm text-slate-300" role="status">
            @(errorCarga ?? "Cargando destinatarios…")
        </div>
    }
    else if (destinatarios.Count == 0)
    {
        <div class="rounded-2xl border border-amber-500/25 bg-amber-500/[0.07] p-6 text-sm text-amber-200" role="status">
            Tu comercio todavía no tiene destinatarios cargados. Necesitás al menos uno para crear un envío.
        </div>
    }
    else
    {
        <div class="space-y-6">
            <section class="overflow-hidden rounded-2xl border border-white/10 bg-[#131a2a] shadow-xl shadow-black/10">
                <div class="flex items-center gap-3 border-b border-white/10 px-5 py-5 sm:px-7">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-violet-500/15 text-sm font-bold text-violet-300">01</span>
                    <div>
                        <h2 class="text-lg font-semibold text-white">Destinatario y entrega</h2>
                        <p class="mt-0.5 text-xs text-slate-400">Seleccioná quién recibe el envío y dónde entregarlo.</p>
                    </div>
                </div>

                <div class="grid gap-5 p-5 sm:grid-cols-2 sm:p-7">
                    <div>
                        <label for="destinatario" class="mb-2 block text-sm font-medium text-slate-200">
                            Destinatario <span class="text-violet-400">*</span>
                        </label>
                        <select id="destinatario"
                                class="w-full rounded-xl border border-white/10 bg-[#0b1020] px-4 py-3 text-sm text-white outline-none transition focus:border-violet-500 focus:ring-2 focus:ring-violet-500/20"
                                @bind="destinatarioId" @bind:after="AlCambiarDestinatario">
                            <option value="">Elegí un destinatario…</option>
                            @foreach (var d in destinatarios)
                            {
                                <option value="@d.Id">@d.Apellido, @d.Nombre</option>
                            }
                        </select>

                        @if (destinatarioElegido is not null)
                        {
                            <p class="mt-2 text-xs text-slate-400">
                                @destinatarioElegido.Email @(destinatarioElegido.Telefono is null ? "" : $"· {destinatarioElegido.Telefono}")
                            </p>
                        }
                    </div>

                    <div>
                        <label for="direccion" class="mb-2 block text-sm font-medium text-slate-200">
                            Dirección de entrega <span class="text-violet-400">*</span>
                        </label>
                        <select id="direccion"
                                class="w-full rounded-xl border border-white/10 bg-[#0b1020] px-4 py-3 text-sm text-white outline-none transition focus:border-violet-500 focus:ring-2 focus:ring-violet-500/20 disabled:cursor-not-allowed disabled:opacity-50"
                                @bind="direccionId"
                                disabled="@(destinatarioElegido is null || destinatarioElegido.Direcciones.Count == 0)">
                            <option value="">Elegí una dirección…</option>
                            @if (destinatarioElegido is not null)
                            {
                                foreach (var dir in destinatarioElegido.Direcciones)
                                {
                                    <option value="@dir.Id">@TextoDireccion(dir)</option>
                                }
                            }
                        </select>

                        @if (destinatarioElegido is not null && destinatarioElegido.Direcciones.Count == 0)
                        {
                            <p class="mt-2 text-xs text-red-300">
                                Este destinatario no tiene direcciones activas.
                            </p>
                        }
                    </div>

                    <div class="sm:col-span-2">
                        <label for="referencia" class="mb-2 block text-sm font-medium text-slate-200">
                            Referencia externa <span class="font-normal text-slate-500">(opcional)</span>
                        </label>
                        <input id="referencia" maxlength="100" @bind="referenciaExterna"
                               placeholder="Ej.: ENV-001"
                               class="w-full rounded-xl border border-white/10 bg-[#0b1020] px-4 py-3 text-sm text-white outline-none placeholder:text-slate-600 focus:border-violet-500 focus:ring-2 focus:ring-violet-500/20"/>
                        <p class="mt-2 text-xs text-slate-500">
                            Podés usar el identificador de pedido de tu comercio.
                        </p>
                    </div>
                </div>
            </section>

            <section class="overflow-hidden mt-3 rounded-2xl border border-white/10 bg-[#131a2a] shadow-xl shadow-black/10">
                <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 px-5 py-5 sm:px-7">
                    <div class="flex items-center gap-3">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-violet-500/15 text-sm font-bold text-violet-300">02</span>
                        <div>
                            <h2 class="text-lg font-semibold text-white">
                                Bultos <span class="text-sm font-normal text-slate-400">(@bultos.Count)</span>
                            </h2>
                            <p class="mt-0.5 text-xs text-slate-400">
                                Ingresá el peso y las dimensiones de cada paquete.
                            </p>
                        </div>
                    </div>

                    <button type="button" @onclick="AgregarBulto"
                            disabled="@(bultos.Count >= MaximoBultos)"
                            class="rounded-xl border border-violet-500/35 bg-violet-500/10 px-4 py-2.5 text-sm font-semibold text-violet-200 transition hover:bg-violet-500/20 disabled:cursor-not-allowed disabled:opacity-40">
                        + Agregar bulto
                    </button>
                </div>

                <div class="space-y-4 p-5 sm:p-7">
                    @for (var i = 0; i < bultos.Count; i++)
                    {
                        var numero = i + 1;
                        var bulto = bultos[i];

                        <div @key="bulto" class="rounded-xl border border-white/10 bg-[#0d1423] p-4 sm:p-5">
                            <div class="mb-4 flex items-center justify-between gap-3">
                                <h3 class="text-sm font-semibold text-white">Bulto @numero</h3>

                                <button type="button" title="Quitar bulto"
                                        @onclick="() => QuitarBulto(bulto)"
                                        disabled="@(bultos.Count == 1)"
                                        class="rounded-lg border border-red-400/20 px-3 py-1.5 text-xs font-medium text-red-300 transition hover:bg-red-500/10 disabled:cursor-not-allowed disabled:opacity-30">
                                    Quitar
                                </button>
                            </div>

                            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                                <div>
                                    <label class="mb-2 block text-xs font-medium text-slate-300">Peso (kg)</label>
                                    <input type="number" step="0.01" min="0.01" max="1000"
                                           @bind="bulto.PesoKg"
                                           class="w-full rounded-lg border border-white/10 bg-[#0b1020] px-3 py-2.5 text-sm text-white outline-none focus:border-violet-500"/>
                                </div>
                                <div>
                                    <label class="mb-2 block text-xs font-medium text-slate-300">Largo (cm)</label>
                                    <input type="number" step="0.1" min="0.1" max="1000"
                                           @bind="bulto.LargoCm"
                                           class="w-full rounded-lg border border-white/10 bg-[#0b1020] px-3 py-2.5 text-sm text-white outline-none focus:border-violet-500"/>
                                </div>
                                <div>
                                    <label class="mb-2 block text-xs font-medium text-slate-300">Ancho (cm)</label>
                                    <input type="number" step="0.1" min="0.1" max="1000"
                                           @bind="bulto.AnchoCm"
                                           class="w-full rounded-lg border border-white/10 bg-[#0b1020] px-3 py-2.5 text-sm text-white outline-none focus:border-violet-500"/>
                                </div>
                                <div>
                                    <label class="mb-2 block text-xs font-medium text-slate-300">Alto (cm)</label>
                                    <input type="number" step="0.1" min="0.1" max="1000"
                                           @bind="bulto.AltoCm"
                                           class="w-full rounded-lg border border-white/10 bg-[#0b1020] px-3 py-2.5 text-sm text-white outline-none focus:border-violet-500"/>
                                </div>
                                <div class="sm:col-span-2 lg:col-span-4">
                                    <label class="mb-2 block text-xs font-medium text-slate-300">
                                        Descripción <span class="font-normal text-slate-500">(opcional)</span>
                                    </label>
                                    <input maxlength="500" @bind="bulto.Descripcion"
                                           placeholder="Ej.: Caja con artículos de indumentaria"
                                           class="w-full rounded-lg border border-white/10 bg-[#0b1020] px-3 py-2.5 text-sm text-white outline-none placeholder:text-slate-600 focus:border-violet-500"/>
                                </div>
                            </div>
                        </div>
                    }

                    <p class="text-xs text-slate-500">Máximo @MaximoBultos bultos por envío.</p>
                </div>
            </section>

            @if (errores.Count > 0)
            {
                <div role="alert" class="rounded-xl border border-red-500/30 bg-red-500/10 px-5 py-4 text-sm text-red-200">
                    <p class="mb-2 font-semibold">Revisá los siguientes datos:</p>
                    <ul class="list-disc space-y-1 pl-5">
                        @foreach (var e in errores)
                        {
                            <li>@e</li>
                        }
                    </ul>
                </div>
            }

            <div class="flex mt-2  flex-wrap items-center justify-end gap-3 border-t border-white/10 pt-6">
                <a href="/" class="rounded-xl border border-white/10 px-5 py-3 text-sm font-semibold text-slate-300 transition hover:bg-white/5">
                    Cancelar
                </a>

                <button type="button" @onclick="CrearAsync" disabled="@enviando"
                        class="rounded-xl bg-violet-600 px-8 py-3 text-sm font-semibold text-white shadow-lg shadow-violet-950/30 transition hover:bg-violet-500 disabled:cursor-wait disabled:opacity-60">
                    @(enviando ? "Creando…" : "Crear envío →")
                </button>
            </div>
        </div>
    }
</div>

@code {
    private const int MaximoBultos = 50;

    [CascadingParameter]
    private Task<AuthenticationState> EstadoAutenticacion { get; set; } = default!;

    private int comercioId;
    private string? operadorNombre;

    private List<DestinatarioDto>? destinatarios;
    private string? errorCarga;

    private int? destinatarioId;
    private int? direccionId;
    private string? referenciaExterna;
    private List<CrearBultoRequest> bultos = [new()];

    private readonly List<string> errores = [];
    private bool enviando;
    private EnvioResponse? creado;

    private DestinatarioDto? destinatarioElegido =>
        destinatarios?.FirstOrDefault(d => d.Id == destinatarioId);

    protected override async Task OnInitializedAsync()
    {
        var usuario = (await EstadoAutenticacion).User;
        comercioId = usuario.LeerEntero(ClaimsPortal.ComercioId) ?? 0;
        operadorNombre = usuario.FindFirst(ClaimsPortal.OperadorNombre)?.Value;

        try
        {
            destinatarios = await DestinatariosApi.ListarAsync();
        }
        catch (SesionVencidaException)
        {
            IrAlLogin();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogError(ex, "No se pudieron cargar los destinatarios");
            errorCarga = "No se pudieron cargar los destinatarios. Probá recargar la página.";
        }
    }

    private void AlCambiarDestinatario() =>
        direccionId = destinatarioElegido?.Direcciones.FirstOrDefault()?.Id;

    private void AgregarBulto()
    {
        if (bultos.Count < MaximoBultos)
            bultos.Add(new CrearBultoRequest());
    }

    private void QuitarBulto(CrearBultoRequest bulto)
    {
        if (bultos.Count > 1)
            bultos.Remove(bulto);
    }

    private async Task CrearAsync()
    {
        errores.Clear();
        Validar();

        if (errores.Count > 0)
            return;

        enviando = true;

        try
        {
            var request = new CrearEnvioRequest
            {
                ComercioId = comercioId,
                DestinatarioId = destinatarioId!.Value,
                DireccionId = direccionId!.Value,
                ReferenciaExterna = string.IsNullOrWhiteSpace(referenciaExterna) ? null : referenciaExterna.Trim(),
                Bultos = bultos
                    .Select(b => new CrearBultoRequest
                    {
                        PesoKg = b.PesoKg,
                        LargoCm = b.LargoCm,
                        AnchoCm = b.AnchoCm,
                        AltoCm = b.AltoCm,
                        Descripcion = string.IsNullOrWhiteSpace(b.Descripcion) ? null : b.Descripcion.Trim()
                    })
                    .ToList()
            };

            var resultado = await EnviosApi.CrearAsync(request);

            if (resultado.Exito)
                creado = resultado.Envio;
            else
                errores.Add(resultado.Error ?? "No se pudo crear el envío.");
        }
        catch (SesionVencidaException)
        {
            IrAlLogin();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogError(ex, "No se pudo crear el envío");
            errores.Add("No se pudo conectar con el servidor. Probá de nuevo.");
        }
        finally
        {
            enviando = false;
        }
    }

    private void Validar()
    {
        if (destinatarioId is null)
            errores.Add("Elegí un destinatario.");

        if (direccionId is null)
            errores.Add("Elegí una dirección de entrega.");

        if (bultos.Count == 0)
            errores.Add("El envío tiene que tener al menos un bulto.");

        for (var i = 0; i < bultos.Count; i++)
        {
            var b = bultos[i];

            if (b.PesoKg is <= 0 or > 1000)
                errores.Add($"Bulto {i + 1}: el peso tiene que ser mayor a 0 y como máximo 1000 kg.");

            if (b.LargoCm is <= 0 or > 1000 || b.AnchoCm is <= 0 or > 1000 || b.AltoCm is <= 0 or > 1000)
                errores.Add($"Bulto {i + 1}: largo, ancho y alto tienen que ser mayores a 0 y como máximo 1000 cm.");
        }
    }

    private void NuevoEnvio()
    {
        creado = null;
        referenciaExterna = null;
        bultos = [new()];
        errores.Clear();
    }

    private void IrAlLogin() =>
        Navegacion.NavigateTo("/login?vencida=true", forceLoad: true);

    private static string TextoDireccion(DireccionDto d) =>
        $"{d.Calle} {d.Numero}{(d.Apartamento is null ? "" : $" apto {d.Apartamento}")}, {d.Ciudad} ({d.Departamento})";
}
