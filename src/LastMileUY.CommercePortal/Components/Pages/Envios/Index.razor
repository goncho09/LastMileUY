@page "/envios"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using LastMileUY.CommercePortal.Servicios
@using LastMileUY.Contracts.Comun
@using LastMileUY.Contracts.Envios
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web

@inject IEnviosApi EnviosApi
@inject NavigationManager Navegacion
@inject ILogger<Index> Logger
@implements IDisposable

<PageTitle>Mis envíos | LastMileUY</PageTitle>

<div class="space-y-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-violet-500/25 bg-violet-500/10 px-3 py-1 text-xs font-semibold text-violet-300">
                Portal de Comercios
            </div>
            <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Mis envíos</h1>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-400">
                Los envíos de tu comercio con el operador seleccionado, del más nuevo al más viejo.
            </p>
        </div>
        <a href="/envios/nuevo" class="inline-flex items-center rounded-xl bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white shadow-lg shadow-violet-950/30 transition hover:bg-violet-500">
            ＋ Nuevo envío
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(operadorNombre))
    {
        <div class="flex flex-wrap items-center gap-2 rounded-xl border border-violet-500/20 bg-violet-500/[0.06] px-4 py-3 text-sm">
            <span class="text-slate-400">Operador logístico:</span>
            <span class="font-semibold text-violet-200">@operadorNombre</span>
        </div>
    }

    <!-- Filtros -->
    <div class="flex flex-wrap items-end gap-3 rounded-2xl border border-white/10 bg-[#151927] p-4">
        <label class="flex min-w-[220px] flex-1 flex-col gap-1.5 text-xs font-medium text-slate-400">
            Buscar
            <input type="search" @bind="buscar" @bind:event="oninput" @bind:after="AlEscribirAsync"
                   placeholder="Código, referencia o destinatario"
                   class="rounded-xl border border-white/10 bg-[#0b1020] px-4 py-3 text-sm text-white outline-none transition focus:border-violet-500 focus:ring-2 focus:ring-violet-500/20 placeholder-slate-500" />
        </label>

        <label class="flex min-w-[180px] flex-col gap-1.5 text-xs font-medium text-slate-400">
            Estado
            <select @bind="estado" @bind:after="FiltrarAsync"
                    class="rounded-xl border border-white/10 bg-[#0b1020] px-4 py-3 text-sm text-white outline-none transition focus:border-violet-500 focus:ring-2 focus:ring-violet-500/20">
                <option value="">Todos</option>
                @foreach (var (valor, texto) in Estados)
                {
                    <option value="@valor">@texto</option>
                }
            </select>
        </label>
    </div>

    @if (errorCarga is not null)
    {
        <div role="alert" class="rounded-xl border border-red-500/30 bg-red-500/10 px-5 py-4 text-sm text-red-200">
            @errorCarga
        </div>
    }
    else if (pagina is null)
    {
        <p class="text-sm text-slate-400">Cargando envíos…</p>
    }
    else if (pagina.Items.Count == 0)
    {
        <section class="rounded-2xl border border-dashed border-white/15 bg-white/[0.03] p-8 text-center">
            <h2 class="text-lg font-semibold text-white">
                @(HayFiltros ? "No hay envíos que coincidan con la búsqueda" : "Todavía no tenés envíos")
            </h2>
            <p class="mt-2 text-sm text-slate-400">
                @(HayFiltros ? "Probá con otro estado o con otro texto." : "Cuando crees un envío va a aparecer acá.")
            </p>
        </section>
    }
    else
    {
        <div class="overflow-x-auto rounded-2xl border border-white/10 bg-[#151927]">
            <table class="w-full min-w-[760px] text-left text-sm">
                <thead class="border-b border-white/10 text-xs uppercase tracking-wide text-slate-500">
                    <tr>
                        <th class="px-5 py-3 font-medium">Código</th>
                        <th class="px-5 py-3 font-medium">Destinatario</th>
                        <th class="px-5 py-3 font-medium">Destino</th>
                        <th class="px-5 py-3 font-medium">Estado</th>
                        <th class="px-5 py-3 text-right font-medium">Bultos</th>
                        <th class="px-5 py-3 font-medium">Creado</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    @foreach (var envio in pagina.Items)
                    {
                        <tr class="transition hover:bg-white/[0.03]">
                            <td class="px-5 py-3">
                                <p class="font-semibold text-violet-300">@envio.CodigoSeguimiento</p>
                                @if (!string.IsNullOrWhiteSpace(envio.ReferenciaExterna))
                                {
                                    <p class="text-xs text-slate-500">Ref. @envio.ReferenciaExterna</p>
                                }
                            </td>
                            <td class="px-5 py-3 text-slate-200">@envio.Destinatario</td>
                            <td class="px-5 py-3 text-slate-400">@envio.Ciudad, @envio.Departamento</td>
                            <td class="px-5 py-3">
                                <span class="inline-flex rounded-full border px-2.5 py-0.5 text-xs font-semibold @ClaseEstado(envio.Estado)">
                                    @TextoEstado(envio.Estado)
                                </span>
                            </td>
                            <td class="px-5 py-3 text-right text-slate-200">@envio.CantidadBultos</td>
                            <td class="px-5 py-3 text-slate-400">@Fecha(envio.FechaCreacion)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Paginado -->
        <div class="flex flex-wrap items-center justify-between gap-3 text-sm text-slate-400">
            <span>@pagina.Total @(pagina.Total == 1 ? "envío" : "envíos") · página @pagina.Pagina de @Math.Max(1, pagina.TotalPaginas)</span>
            <div class="flex gap-2">
                <button type="button" @onclick="() => IrAPaginaAsync(numeroPagina - 1)"
                        disabled="@(cargando || numeroPagina <= 1)"
                        class="rounded-xl border border-white/10 px-4 py-2 font-medium text-slate-300 transition hover:bg-white/5 disabled:opacity-40">
                    ← Anterior
                </button>
                <button type="button" @onclick="() => IrAPaginaAsync(numeroPagina + 1)"
                        disabled="@(cargando || numeroPagina >= pagina.TotalPaginas)"
                        class="rounded-xl border border-white/10 px-4 py-2 font-medium text-slate-300 transition hover:bg-white/5 disabled:opacity-40">
                    Siguiente →
                </button>
            </div>
        </div>
    }
</div>

@code {
    private const int TamanioPagina = 20;

    // Los estados del envío (los nombres son los que devuelve la API) con su texto para mostrar
    private static readonly (string Valor, string Texto)[] Estados =
    [
        ("Admitido", "Admitido"),
        ("EnDeposito", "En depósito"),
        ("AsignadoARuta", "Asignado a ruta"),
        ("EnTransito", "En tránsito"),
        ("Entregado", "Entregado"),
        ("NoEntregado", "No entregado"),
        ("Reprogramado", "Reprogramado"),
        ("EnDevolucion", "En devolución"),
        ("Devuelto", "Devuelto"),
        ("Extraviado", "Extraviado")
    ];

    [CascadingParameter]
    private Task<AuthenticationState> EstadoAutenticacion { get; set; } = default!;

    private string? operadorNombre;

    private PaginaDto<EnvioResumenDto>? pagina;
    private int numeroPagina = 1;
    private string? estado;
    private string? buscar;
    private string? errorCarga;
    private bool cargando;

    // Numera cada consulta: si llega la respuesta de una búsqueda vieja después de una nueva, se descarta
    private int ultimaConsulta;

    private bool HayFiltros => !string.IsNullOrWhiteSpace(estado) || !string.IsNullOrWhiteSpace(buscar);

    protected override async Task OnInitializedAsync()
    {
        var usuario = (await EstadoAutenticacion).User;
        operadorNombre = usuario.FindFirst(ClaimsPortal.OperadorNombre)?.Value;

        await CargarAsync();
    }

    private Task FiltrarAsync() => IrAPaginaAsync(1);

    // Busca mientras se escribe: espera a que se deje de tipear un momento para no consultar la API por cada letra
    private CancellationTokenSource? espera;

    private async Task AlEscribirAsync()
    {
        espera?.Cancel();
        espera?.Dispose();
        espera = new CancellationTokenSource();

        try
        {
            await Task.Delay(300, espera.Token);
        }
        catch (TaskCanceledException)
        {
            return; // siguió escribiendo
        }

        await FiltrarAsync();
    }

    public void Dispose()
    {
        espera?.Cancel();
        espera?.Dispose();
    }

    private async Task IrAPaginaAsync(int numero)
    {
        numeroPagina = Math.Max(1, numero);
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var consulta = ++ultimaConsulta;
        cargando = true;
        errorCarga = null;

        try
        {
            var resultado = await EnviosApi.ListarAsync(numeroPagina, TamanioPagina, estado, buscar);

            if (consulta == ultimaConsulta)
                pagina = resultado;
        }
        catch (SesionVencidaException)
        {
            IrAlLogin();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogError(ex, "No se pudieron cargar los envíos");

            if (consulta == ultimaConsulta)
                errorCarga = "No se pudieron cargar los envíos. Probá recargar la página.";
        }
        finally
        {
            if (consulta == ultimaConsulta)
                cargando = false;
        }
    }

    private void IrAlLogin() =>
        Navegacion.NavigateTo("/login?vencida=true", forceLoad: true);

    private static string TextoEstado(string estado) =>
        Estados.FirstOrDefault(e => e.Valor == estado).Texto ?? estado;

    private static string ClaseEstado(string estado) => estado switch
    {
        "Entregado" => "border-emerald-500/25 bg-emerald-500/10 text-emerald-300",
        "EnTransito" or "AsignadoARuta" => "border-blue-500/25 bg-blue-500/10 text-blue-300",
        "NoEntregado" or "Extraviado" => "border-red-500/25 bg-red-500/10 text-red-300",
        "Reprogramado" or "EnDevolucion" or "Devuelto" => "border-amber-500/25 bg-amber-500/10 text-amber-300",
        _ => "border-white/15 bg-white/5 text-slate-300"
    };

    // La API guarda las fechas en UTC; se muestran en hora de Uruguay
    private static readonly TimeZoneInfo? ZonaUruguay = BuscarZona();

    private static TimeZoneInfo? BuscarZona()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("America/Montevideo"); }
        catch (Exception) { return null; }
    }

    private static string Fecha(DateTime fecha)
    {
        var utc = fecha.Kind == DateTimeKind.Local ? fecha.ToUniversalTime() : DateTime.SpecifyKind(fecha, DateTimeKind.Utc);
        var local = ZonaUruguay is null ? utc : TimeZoneInfo.ConvertTimeFromUtc(utc, ZonaUruguay);
        return local.ToString("dd/MM/yyyy HH:mm");
    }
}
