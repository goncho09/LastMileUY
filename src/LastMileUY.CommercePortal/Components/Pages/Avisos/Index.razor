@page "/avisos"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using LastMileUY.CommercePortal.Servicios
@using LastMileUY.Contracts.Avisos
@using LastMileUY.Contracts.Mensajeria
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web

@inject IAvisosApi AvisosApi
@inject NavigationManager Navegacion
@inject ILogger<Index> Logger

<PageTitle>Avisos | LastMileUY</PageTitle>

<div class="space-y-8">
    <div>
        <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-violet-500/25 bg-violet-500/10 px-3 py-1 text-xs font-semibold text-violet-300">
            Portal de Comercios
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Avisos</h1>
    </div>

    @if (!string.IsNullOrWhiteSpace(operadorNombre))
    {
        <div class="flex flex-wrap items-center gap-2 rounded-xl border border-violet-500/20 bg-violet-500/[0.06] px-4 py-3 text-sm">
            <span class="text-slate-400">Operador logístico:</span>
            <span class="font-semibold text-violet-200">@operadorNombre</span>
        </div>
    }

    <!-- Nueva suscripción -->
    <section class="rounded-2xl border border-white/10 bg-[#151927] p-6">
        <h2 class="text-lg font-semibold text-white">Nueva suscripción</h2>

        <div class="mt-4 flex flex-wrap items-end gap-3">
            <label class="flex min-w-[220px] flex-col gap-1.5 text-xs font-medium text-slate-400">
                Evento
                <select @bind="nueva.TipoEvento"
                        class="rounded-xl border border-white/10 bg-[#0b1020] px-4 py-3 text-sm text-white outline-none transition focus:border-violet-500 focus:ring-2 focus:ring-violet-500/20">
                    @foreach (var (valor, texto) in Tipos)
                    {
                        <option value="@valor">@texto</option>
                    }
                </select>
            </label>

            <label class="flex min-w-[260px] flex-1 flex-col gap-1.5 text-xs font-medium text-slate-400">
                URL
                <input type="url" @bind="nueva.UrlDestino" @bind:event="oninput" placeholder="https://"
                       class="rounded-xl border border-white/10 bg-[#0b1020] px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition focus:border-violet-500 focus:ring-2 focus:ring-violet-500/20" />
            </label>

            <button type="button" @onclick="CrearAsync" disabled="@(guardando || string.IsNullOrWhiteSpace(nueva.UrlDestino))"
                    class="rounded-xl bg-violet-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-violet-950/30 transition hover:bg-violet-500 disabled:cursor-not-allowed disabled:opacity-60">
                @(guardando ? "Guardando…" : "Agregar")
            </button>
        </div>
    </section>

    @if (error is not null)
    {
        <div role="alert" class="rounded-xl border border-red-500/30 bg-red-500/10 px-5 py-4 text-sm text-red-200">
            @error
        </div>
    }

    <!-- Suscripciones -->
    @if (suscripciones is null)
    {
        @if (errorCarga is null)
        {
            <p class="text-sm text-slate-400">Cargando suscripciones…</p>
        }
        else
        {
            <div role="alert" class="rounded-xl border border-red-500/30 bg-red-500/10 px-5 py-4 text-sm text-red-200">
                @errorCarga
            </div>
        }
    }
    else if (suscripciones.Count == 0)
    {
        <section class="rounded-2xl border border-dashed border-white/15 bg-white/[0.03] p-8 text-center">
            <h2 class="text-lg font-semibold text-white">Todavía no tenés suscripciones</h2>
        </section>
    }
    else
    {
        <div class="overflow-x-auto rounded-2xl border border-white/10 bg-[#151927]">
            <table class="w-full min-w-[680px] text-left text-sm">
                <thead class="border-b border-white/10 text-xs uppercase tracking-wide text-slate-500">
                    <tr>
                        <th class="px-5 py-3 font-medium">Evento</th>
                        <th class="px-5 py-3 font-medium">URL</th>
                        <th class="px-5 py-3 font-medium">Estado</th>
                        <th class="px-5 py-3 font-medium">Creada</th>
                        <th class="px-5 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    @foreach (var s in suscripciones)
                    {
                        <tr class="transition hover:bg-white/[0.03]">
                            <td class="px-5 py-3 text-slate-200">@TextoTipo(s.TipoEvento)</td>
                            <td class="max-w-[320px] break-all px-5 py-3 text-slate-400">@s.UrlDestino</td>
                            <td class="px-5 py-3">
                                @if (s.Activa)
                                {
                                    <span class="inline-flex rounded-full border border-emerald-500/25 bg-emerald-500/10 px-2.5 py-0.5 text-xs font-semibold text-emerald-300">Activa</span>
                                }
                                else
                                {
                                    <span class="inline-flex rounded-full border border-white/15 bg-white/5 px-2.5 py-0.5 text-xs font-semibold text-slate-400">Inactiva</span>
                                }
                            </td>
                            <td class="px-5 py-3 text-slate-400">@Fecha(s.FechaCreacion)</td>
                            <td class="px-5 py-3 text-right">
                                <button type="button" @onclick="() => CambiarActivaAsync(s)" disabled="@(cambiando == s.Id)"
                                        class="rounded-xl border border-white/10 px-4 py-2 text-xs font-semibold text-slate-300 transition hover:bg-white/5 disabled:opacity-50">
                                    @(s.Activa ? "Desactivar" : "Activar")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    // Los eventos a los que se puede suscribir, con su texto para mostrar
    private static readonly (string Valor, string Texto)[] Tipos =
    [
        (TiposEvento.EnvioEstadoCambiado, "Cambio de estado del envío"),
        (TiposEvento.EnvioAdmitido, "Envío admitido")
    ];

    [CascadingParameter]
    private Task<AuthenticationState> EstadoAutenticacion { get; set; } = default!;

    private string? operadorNombre;
    private List<SuscripcionAvisosDto>? suscripciones;
    private string? errorCarga;

    private CrearSuscripcionAvisosRequest nueva = new() { TipoEvento = Tipos[0].Valor };
    private bool guardando;
    private int? cambiando;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        var usuario = (await EstadoAutenticacion).User;
        operadorNombre = usuario.FindFirst(ClaimsPortal.OperadorNombre)?.Value;

        try
        {
            suscripciones = await AvisosApi.ListarSuscripcionesAsync();
        }
        catch (SesionVencidaException)
        {
            IrAlLogin();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogError(ex, "No se pudieron cargar las suscripciones a avisos");
            errorCarga = "No se pudieron cargar las suscripciones. Probá recargar la página.";
        }
    }

    private async Task CrearAsync()
    {
        error = null;
        guardando = true;

        try
        {
            var resultado = await AvisosApi.CrearSuscripcionAsync(nueva);

            if (resultado.Exito)
            {
                suscripciones?.Insert(0, resultado.Suscripcion!);
                nueva = new() { TipoEvento = nueva.TipoEvento };
            }
            else
            {
                error = resultado.Error;
            }
        }
        catch (SesionVencidaException)
        {
            IrAlLogin();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogError(ex, "No se pudo crear la suscripción a avisos");
            error = "No se pudo guardar la suscripción. Probá de nuevo.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task CambiarActivaAsync(SuscripcionAvisosDto suscripcion)
    {
        error = null;
        cambiando = suscripcion.Id;

        try
        {
            var resultado = await AvisosApi.CambiarActivaAsync(suscripcion.Id, !suscripcion.Activa);

            if (resultado.Exito && suscripciones is not null)
            {
                var indice = suscripciones.FindIndex(s => s.Id == suscripcion.Id);
                if (indice >= 0)
                    suscripciones[indice] = resultado.Suscripcion!;
            }
            else
            {
                error = resultado.Error;
            }
        }
        catch (SesionVencidaException)
        {
            IrAlLogin();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogError(ex, "No se pudo cambiar la suscripción a avisos {Id}", suscripcion.Id);
            error = "No se pudo cambiar la suscripción. Probá de nuevo.";
        }
        finally
        {
            cambiando = null;
        }
    }

    private void IrAlLogin() =>
        Navegacion.NavigateTo("/login?vencida=true", forceLoad: true);

    private static string TextoTipo(string tipo) =>
        Tipos.FirstOrDefault(t => t.Valor == tipo).Texto ?? tipo;

    // La API guarda las fechas en UTC; se muestran en hora de Uruguay
    private static readonly TimeZoneInfo? ZonaUruguay = BuscarZona();

    private static TimeZoneInfo? BuscarZona()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("America/Montevideo"); }
        catch (Exception) { return null; }
    }

    private static string Fecha(DateTime fecha)
    {
        var utc = fecha.Kind == DateTimeKind.Local ? fecha.ToUniversalTime() : DateTime.SpecifyKind(fecha, DateTimeKind.Utc);
        var local = ZonaUruguay is null ? utc : TimeZoneInfo.ConvertTimeFromUtc(utc, ZonaUruguay);
        return local.ToString("dd/MM/yyyy HH:mm");
    }
}
