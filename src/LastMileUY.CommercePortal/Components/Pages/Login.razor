@page "/login"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using LastMileUY.Contracts.Auth
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject IAutenticacionApi Autenticacion
@inject NavigationManager Navegacion
@inject ILogger<Login> Logger
@inject SeleccionOperadorCookie SeleccionCookie
@layout LastMileUY.CommercePortal.Components.Layout.AuthLayout

@* Renderizado estático: necesario para escribir la cookie de autenticación. *@
<PageTitle>Iniciar sesión | LastMileUY</PageTitle>

<section class="relative isolate flex min-h-dvh items-center justify-center overflow-hidden bg-[#0D0F16] px-4 py-12 text-[#F1F3F9]">
    <div aria-hidden="true" class="pointer-events-none absolute -top-40 left-1/2 h-[460px] w-[720px] -translate-x-1/2 rounded-full bg-[#635BFF]/10 blur-[130px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-40 -right-24 h-[350px] w-[480px] rounded-full bg-cyan-400/5 blur-[130px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-20 [background-image:radial-gradient(#262938_1px,transparent_1px)] [background-size:28px_28px]"></div>

    <div class="relative z-10 w-full max-w-[440px]">
        <div class="mb-8 text-center">
            <div class="mb-4 flex items-center justify-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-[#262938] bg-[#191D2B] text-xl font-bold text-[#635BFF]">L</div>
                <div class="text-left">
                    <div class="text-xl font-bold tracking-tight">LastMile<span class="text-[#635BFF]">UY</span></div>
                    <div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-[#9CA3AF]">CommercePortal</div>
                </div>
            </div>
        
            <h1 class="text-2xl font-bold tracking-tight">Iniciar sesión en CommercePortal</h1>
            <p class="mt-2 text-sm leading-relaxed text-[#9CA3AF]">Ingresá tus credenciales comerciales para gestionar tus envíos y operadores logísticos.</p>
        </div>

        <div class="rounded-2xl border border-[#262938] bg-[#151821] p-7 shadow-[0_16px_40px_-12px_rgba(0,0,0,0.65)]">
            @if (error is not null)
            {
                <div role="alert" class="mb-5 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-300">@error</div>
            }
            @if (aviso is not null)
            {
                <div role="status" class="mb-5 rounded-lg border border-cyan-400/30 bg-cyan-400/10 px-4 py-3 text-sm text-cyan-200">@aviso</div>
            }

            <EditForm Model="Formulario" FormName="login" OnValidSubmit="IniciarSesionAsync" class="flex flex-col gap-5">
                <DataAnnotationsValidator />
                <div>
                    <label for="email" class="mb-2 block text-sm font-medium text-[#9CA3AF]">Email corporativo</label>
                    <InputText id="email" type="email" class="h-11 w-full rounded-lg border border-[#2E3346] bg-[#0C0E15] px-4 text-sm text-white outline-none placeholder:text-[#6B7280] focus:border-[#635BFF] focus:ring-1 focus:ring-[#635BFF]" @bind-Value="Formulario.Email" placeholder="ejemplo@comercio.com.uy" autocomplete="username" autofocus />
                    <ValidationMessage For="() => Formulario.Email" class="mt-1 block text-xs text-red-400" />
                </div>
                <div>
                    <label for="password" class="mb-2 block text-sm font-medium text-[#9CA3AF]">Contraseña</label>
                    <InputText id="password" type="password" class="h-11 w-full rounded-lg border border-[#2E3346] bg-[#0C0E15] px-4 text-sm text-white outline-none placeholder:text-[#6B7280] focus:border-[#635BFF] focus:ring-1 focus:ring-[#635BFF]" @bind-Value="Formulario.Password" placeholder="Ingresá tu contraseña" autocomplete="current-password" />
                    <ValidationMessage For="() => Formulario.Password" class="mt-1 block text-xs text-red-400" />
                </div>
                <button type="submit" class="cursor-pointer mt-1 flex h-11 w-full items-center justify-center gap-2 rounded-lg bg-[#635BFF] px-4 text-sm font-semibold text-white transition hover:bg-[#736CFF] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#635BFF]">
                    Iniciar sesión <span aria-hidden="true">→</span>
                </button>
            </EditForm>
            <div class="mt-6 border-t border-[#262938] pt-5 text-center text-xs text-[#9CA3AF]">Acceso seguro para comercios asociados</div>
        </div>
        <p class="mt-6 text-center text-xs text-[#6B7280]">LastMileUY · Portal de Comercios</p>
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private FormularioLogin Formulario { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    // ?vencida=true: la API cortó la sesión; se borra la del portal para que vuelva a entrar
    [SupplyParameterFromQuery]
    private bool Vencida { get; set; }

    private string? error;
    private string? aviso;

    protected override async Task OnInitializedAsync()
    {
        // En el GET no llega formulario: se arranca uno vacío
        Formulario ??= new();

        if (Vencida && HttpMethods.IsGet(HttpContext.Request.Method))
        {
            await HttpContext.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
            aviso = "Tu sesión venció. Volvé a ingresar.";
        }
    }

    private async Task IniciarSesionAsync()
    {
        ResultadoLogin resultado;

        try
        {
            resultado = await Autenticacion.IniciarSesionAsync(
                Formulario.Email.Trim(), Formulario.Password, Formulario.OperadorId);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogError(ex, "No se pudo iniciar sesión contra la API");
            error = "No se pudo conectar con el servidor. Probá de nuevo en unos minutos.";
            return;
        }

        switch (resultado.Estado)
        {
            case EstadoLogin.CredencialesInvalidas:
                error = "Email o contraseña incorrectos.";
                Formulario.Password = string.Empty;
                return;

            case EstadoLogin.ElegirOperador:
                if (string.IsNullOrWhiteSpace(resultado.TokenTemporal) ||
                    resultado.Operadores is null ||
                    resultado.Operadores.Count == 0)
                {
                    error = "No se pudo preparar la selección de operador. Intentá nuevamente.";
                    return;
                }

                SeleccionCookie.Guardar(
                    HttpContext,
                    resultado.TokenTemporal,
                    resultado.Operadores);

                Navegacion.NavigateTo("/seleccionar-operador", forceLoad: true);
                return;

            case EstadoLogin.Rechazado:
                error = resultado.Mensaje;
                return;
        }

        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            ClaimsPortal.CrearPrincipal(resultado.Sesion!, CookieAuthenticationDefaults.AuthenticationScheme));

        Navegacion.NavigateTo(DestinoSeguro(), forceLoad: true);
    }

    // Solo vuelve a direcciones del propio portal (evita redirigir a otro sitio)
    private string DestinoSeguro() =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//")
            && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl
            : "/envios/nuevo";

    private sealed class FormularioLogin
    {
        [Required(ErrorMessage = "Ingresá tu email.")]
        [EmailAddress(ErrorMessage = "El email no es válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresá tu contraseña.")]
        public string Password { get; set; } = string.Empty;

        public int? OperadorId { get; set; }
    }
}
