@page "/operador"
@attribute [Authorize]
@using LastMileUY.Contracts.Auth
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject IAutenticacionApi Autenticacion
@inject NavigationManager Navegacion
@inject ILogger<Operador> Logger

@* Sin interactividad (como el login): al cambiar de operador hay que reescribir la cookie del portal. *@

<PageTitle>Cambiar operador</PageTitle>

<h1>Cambiar operador</h1>
<p class="text-muted">
    Los envíos que des de alta quedan a cargo del operador con el que estás trabajando.
    Ahora: <strong>@operadorActualNombre</strong>.
</p>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (operadores is null)
{
    <p>Cargando…</p>
}
else if (operadores.Count <= 1)
{
    <div class="alert alert-info">Tu comercio trabaja con un solo operador.</div>
}
else
{
    <EditForm Model="Formulario" FormName="cambiar-operador" OnSubmit="CambiarAsync" style="max-width: 420px">
        <div class="mb-3">
            <label class="form-label" for="operador">Operador logístico</label>
            <InputSelect id="operador" class="form-select" @bind-Value="Formulario.OperadorId">
                @foreach (var operador in operadores)
                {
                    <option value="@operador.Id">@operador.Nombre</option>
                }
            </InputSelect>
        </div>

        <button type="submit" class="btn btn-primary">Trabajar con este operador</button>
    </EditForm>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private FormularioOperador Formulario { get; set; } = default!;

    private List<OperadorDisponibleDto>? operadores;
    private string? operadorActualNombre;
    private string? error;

    private string CookieApi => HttpContext.User.FindFirst(ClaimsPortal.CookieApi)?.Value ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // En el GET no llega formulario: se arranca uno vacío
        Formulario ??= new();

        operadorActualNombre = HttpContext.User.FindFirst(ClaimsPortal.OperadorNombre)?.Value;

        // En el GET se preselecciona el operador actual
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            Formulario.OperadorId = HttpContext.User.LeerEntero(ClaimsPortal.OperadorId) ?? 0;
        }

        try
        {
            operadores = await Autenticacion.ListarOperadoresAsync(CookieApi);
        }
        catch (SesionVencidaException)
        {
            Navegacion.NavigateTo("/login?vencida=true", forceLoad: true);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogError(ex, "No se pudieron obtener los operadores del comercio");
            operadores = [];
            error = "No se pudo conectar con el servidor.";
        }
    }

    private async Task CambiarAsync()
    {
        try
        {
            var resultado = await Autenticacion.CambiarOperadorAsync(CookieApi, Formulario.OperadorId);

            if (resultado.Estado != EstadoLogin.Ok)
            {
                error = resultado.Mensaje ?? "No se pudo cambiar de operador.";
                return;
            }

            // La API renovó su cookie con el nuevo operador: se reescribe la del portal
            await HttpContext.SignInAsync(
                CookieAuthenticationDefaults.AuthenticationScheme,
                ClaimsPortal.CrearPrincipal(resultado.Sesion!, CookieAuthenticationDefaults.AuthenticationScheme));

            Navegacion.NavigateTo("/envios/nuevo", forceLoad: true);
        }
        catch (SesionVencidaException)
        {
            Navegacion.NavigateTo("/login?vencida=true", forceLoad: true);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogError(ex, "No se pudo cambiar de operador");
            error = "No se pudo conectar con el servidor.";
        }
    }

    private sealed class FormularioOperador
    {
        public int OperadorId { get; set; }
    }
}
