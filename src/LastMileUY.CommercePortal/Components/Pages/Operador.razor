
@page "/operador"
@attribute [Authorize]
@using LastMileUY.Contracts.Auth
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject IAutenticacionApi Autenticacion
@inject NavigationManager Navegacion
@inject ILogger<Operador> Logger

<PageTitle>Cambiar operador | LastMileUY</PageTitle>

<div class="mx-auto max-w-4xl space-y-8">

    <!-- Encabezado -->
    <div>
        <a href="/"
           class="mb-6 inline-flex items-center gap-2 text-sm font-medium text-slate-400 transition hover:text-violet-300">
            <span>←</span>
            Volver al inicio
        </a>

        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-violet-500/25 bg-violet-500/10 px-3 py-1 text-xs font-semibold text-violet-300">
            Configuración del comercio
        </div>

        <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Cambiar operador logístico
        </h1>

        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-400">
            Seleccioná el operador con el que querés trabajar.
            Los nuevos envíos quedarán asociados al operador elegido.
        </p>
    </div>

    <!-- Operador actual -->
    <div class="flex items-center gap-4 rounded-2xl border border-violet-500/20 bg-violet-500/[0.06] p-5">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-violet-500/20 bg-violet-500/15 text-xl text-violet-300">
            ◈
        </div>

        <div class="min-w-0">
            <p class="text-xs font-medium uppercase tracking-wider text-slate-400">
                Operador actual
            </p>
            <p class="mt-1 truncate text-lg font-semibold text-white">
                @(operadorActualNombre ?? "Sin operador seleccionado")
            </p>
        </div>

        <span class="ml-auto hidden shrink-0 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-300 sm:inline-flex">
            Activo
        </span>
    </div>

    @if (error is not null)
    {
        <div role="alert"
             class="rounded-xl border border-red-500/30 bg-red-500/10 px-5 py-4 text-sm text-red-200">
            @error
        </div>
    }

    @if (operadores is null)
    {
        <div class="rounded-2xl border border-white/10 bg-[#131a2a] p-8 text-center">
            <p class="text-sm text-slate-400">Cargando operadores disponibles…</p>
        </div>
    }
    else if (operadores.Count <= 1)
    {
        <div class="rounded-2xl border border-white/10 bg-[#131a2a] p-7">
            <h2 class="text-lg font-semibold text-white">
                No hay otros operadores disponibles
            </h2>

            <p class="mt-2 text-sm leading-relaxed text-slate-400">
                Tu comercio trabaja con un solo operador logístico.
                No es necesario realizar ningún cambio.
            </p>

            <a href="/"
               class="mt-6 inline-flex items-center rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-violet-500">
                Volver al inicio
            </a>
        </div>
    }
    else
    {
        <section class="overflow-hidden rounded-2xl border border-white/10 bg-[#131a2a] shadow-xl shadow-black/10">

            <div class="border-b border-white/10 px-6 py-5 sm:px-8">
                <h2 class="text-lg font-semibold text-white">
                    Seleccionar operador
                </h2>
                <p class="mt-1 text-sm text-slate-400">
                    Elegí uno de los operadores vinculados a tu comercio.
                </p>
            </div>

            <EditForm Model="Formulario"
                      FormName="cambiar-operador"
                      OnSubmit="CambiarAsync"
                      method="post"
                      Enhance="false"
                      class="space-y-6 p-6 sm:p-8">

                <div class="space-y-3">
                    @foreach (var operador in operadores)
                    {
                        var esActual = operador.Id ==
                            (HttpContext.User.LeerEntero(ClaimsPortal.OperadorId) ?? 0);

                        <label class="group relative block cursor-pointer">
                            <input type="radio"
                                   name="Formulario.OperadorId"
                                   value="@operador.Id"
                                   checked="@(Formulario.OperadorId == operador.Id)"
                                   class="peer sr-only" />

                            <span class="flex items-center gap-4 rounded-xl border border-white/10 bg-[#0d1423] p-4 transition
                                         hover:border-violet-500/40 hover:bg-violet-500/[0.04]
                                         peer-checked:border-violet-500
                                         peer-checked:bg-violet-500/10
                                         peer-focus-visible:ring-2
                                         peer-focus-visible:ring-violet-400">

                                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-lg font-bold text-violet-300">
                                    @operador.Nombre.Substring(0, 1).ToUpperInvariant()
                                </span>

                                <span class="min-w-0 flex-1">
                                    <span class="block truncate text-sm font-semibold text-white">
                                        @operador.Nombre
                                    </span>

                                    <span class="mt-1 block text-xs text-slate-400">
                                        @(esActual ? "Operador actualmente seleccionado" : "Disponible para trabajar")
                                    </span>
                                </span>

                                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-slate-500
                                             peer-checked:border-violet-400">
                                    <span class="h-2.5 w-2.5 rounded-full bg-violet-400 opacity-0 transition group-has-[:checked]:opacity-100"></span>
                                </span>
                            </span>
                        </label>
                    }
                </div>

                <div class="flex flex-wrap items-center justify-end gap-3 border-t border-white/10 pt-6">
                    <a href="/"
                       class="rounded-xl border border-white/10 px-5 py-3 text-sm font-semibold text-slate-300 transition hover:bg-white/5">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="rounded-xl bg-violet-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-violet-950/30 transition hover:bg-violet-500">
                        Trabajar con este operador →
                    </button>
                </div>
            </EditForm>
        </section>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private FormularioOperador Formulario { get; set; } = default!;

    private List<OperadorDisponibleDto>? operadores;
    private string? operadorActualNombre;
    private string? error;

    private string CookieApi =>
        HttpContext.User.FindFirst(ClaimsPortal.CookieApi)?.Value ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Formulario ??= new();

        operadorActualNombre =
            HttpContext.User.FindFirst(ClaimsPortal.OperadorNombre)?.Value;

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            Formulario.OperadorId =
                HttpContext.User.LeerEntero(ClaimsPortal.OperadorId) ?? 0;
        }

        try
        {
            operadores = await Autenticacion.ListarOperadoresAsync(CookieApi);
        }
        catch (SesionVencidaException)
        {
            Navegacion.NavigateTo("/login?vencida=true", forceLoad: true);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogError(ex, "No se pudieron obtener los operadores del comercio");
            operadores = [];
            error = "No se pudo conectar con el servidor.";
        }
    }

    private async Task CambiarAsync()
    {
        try
        {
            var resultado = await Autenticacion.CambiarOperadorAsync(
                CookieApi, Formulario.OperadorId);

            if (resultado.Estado != EstadoLogin.Ok)
            {
                error = resultado.Mensaje ?? "No se pudo cambiar de operador.";
                return;
            }

            await HttpContext.SignInAsync(
                CookieAuthenticationDefaults.AuthenticationScheme,
                ClaimsPortal.CrearPrincipal(
                    resultado.Sesion!,
                    CookieAuthenticationDefaults.AuthenticationScheme));

            Navegacion.NavigateTo("/", forceLoad: true);
        }
        catch (SesionVencidaException)
        {
            Navegacion.NavigateTo("/login?vencida=true", forceLoad: true);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogError(ex, "No se pudo cambiar de operador");
            error = "No se pudo conectar con el servidor.";
        }
    }

    private sealed class FormularioOperador
    {
        public int OperadorId { get; set; }
    }
}
