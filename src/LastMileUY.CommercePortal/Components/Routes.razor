@using LastMileUY.CommercePortal.Components.Pages
<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(NotFound)">
    <Found Context="routeData">
        @* Las páginas con [Authorize] mandan al login si no hay sesión *@
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <RedirigirAlLogin/>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
</Router>
