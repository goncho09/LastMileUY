[Unit]
Description=Actualizador automatico de LastMileUY
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=azureuser
Group=azureuser
WorkingDirectory=/opt/lastmileuy
StateDirectory=lastmileuy-deploy
StateDirectoryMode=0750
ExecStart=/usr/bin/bash /opt/lastmileuy/scripts/deploy/actualizar-azure.sh
TimeoutStartSec=900
